//! The rule that gives every CBOR head one encoding (RFC 8949 §4.2.1): an argument uses
//! the immediate form below 24, otherwise the fewest of 1, 2, 4 or 8 bytes. The encoder
//! picks widths with `head_width` and the decoder rejects anything below
//! `minimum_argument`. `verification.fe` proves the two agree for every argument.

/// The bytes that follow the initial byte for `argument`: 0 for the immediate form.
pub(ingot) fn head_width(_ argument: u64) -> u8 {
    if argument < 24 {
        0
    } else if argument <= 0xff {
        1
    } else if argument <= 0xffff {
        2
    } else if argument <= 0xffffffff { 4 } else { 8 }
}

/// The additional information value for a `width` of 1, 2, 4 or 8 bytes.
pub(ingot) fn additional_info(_ width: u8) -> u8 {
    if width == 1 {
        24
    } else if width == 2 {
        25
    } else if width == 4 { 26 } else { 27 }
}

/// The smallest argument a head of `width` bytes may carry; anything smaller has a
/// shorter form.
pub(ingot) fn minimum_argument(_ width: u8) -> u64 {
    if width == 1 {
        24
    } else if width == 2 {
        0x100
    } else if width == 4 { 0x10000 } else { 0x100000000 }
}
