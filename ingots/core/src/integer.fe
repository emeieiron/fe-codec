use ingot::error::{CodecError, CodecResult, ErrorKind}

/// `value` when it fits an unsigned integer of `bits` (8, 16, 32 or 64) bits.
pub fn checked_unsigned(_ value: u64, _ bits: u16, _ offset: usize) -> CodecResult<u64> {
    if bits != 8 && bits != 16 && bits != 32 && bits != 64 {
        return Result::Err(unsupported(offset))
    }
    if bits < 64 && value >= ((1 as u64) << (bits as u64)) {
        return Result::Err(out_of_range(offset))
    }
    Result::Ok(value)
}

/// `value` when it fits a signed integer of `bits` (8, 16, 32 or 64) bits.
pub fn checked_signed(_ value: i64, _ bits: u16, _ offset: usize) -> CodecResult<i64> {
    if bits != 8 && bits != 16 && bits != 32 && bits != 64 {
        return Result::Err(unsupported(offset))
    }
    if bits < 64 {
        let limit: i64 = 1 << ((bits - 1) as i64)
        if value < -limit || value >= limit {
            return Result::Err(out_of_range(offset))
        }
    }
    Result::Ok(value)
}

/// `value` when it fits an unsigned integer of `bits` (128 or 256) bits.
pub fn checked_wide_unsigned(_ value: u256, _ bits: u16, _ offset: usize) -> CodecResult<u256> {
    if bits != 128 && bits != 256 {
        return Result::Err(unsupported(offset))
    }
    if bits == 128 && (value >> 128) != 0 {
        return Result::Err(out_of_range(offset))
    }
    Result::Ok(value)
}

/// `value` when it fits a signed integer of `bits` (128 or 256) bits.
pub fn checked_wide_signed(_ value: i256, _ bits: u16, _ offset: usize) -> CodecResult<i256> {
    if bits != 128 && bits != 256 {
        return Result::Err(unsupported(offset))
    }
    if bits == 128 {
        let limit: i256 = 1 << 127
        if value < -limit || value >= limit {
            return Result::Err(out_of_range(offset))
        }
    }
    Result::Ok(value)
}

fn unsupported(_ offset: usize) -> CodecError {
    CodecError::at(kind: ErrorKind::Unsupported, offset)
}

fn out_of_range(_ offset: usize) -> CodecError {
    CodecError::at(kind: ErrorKind::IntegerOutOfRange, offset)
}
