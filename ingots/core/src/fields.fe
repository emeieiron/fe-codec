use core::marker::Copy
use ingot::error::{CodecError, CodecResult, ErrorKind}
use ingot::schema::{Schema, SchemaName}
use ingot::serializer::{Decoder, Deserialize}
use ingot::with::FieldCodec

/// A record field a decoder found on the wire: its schema position, the byte offset of its
/// key, and its name for error reports.
pub struct FieldKey { pub position: usize, pub offset: usize, pub name: SchemaName }
impl Copy for FieldKey {}

impl FieldKey {
    /// The key for field `position` of `R`, or `None` when `R` has no such field.
    pub fn of<R: Schema>(_ position: usize, _ offset: usize) -> Option<Self> {
        match R::field(position) {
            Option::Some(field) => Option::Some(Self { position, offset, name: field.name }),
            Option::None => Option::None,
        }
    }

    /// Decodes this field's value into `slot`. Fails with `DuplicateField` when `slot`
    /// already holds a value, and names this field in any error from the value.
    pub fn read<T: Deserialize, D: Decoder>(
        self,
        _ decoder: mut D,
        _ slot: mut Option<T>,
    ) -> CodecResult<()> {
        if slot.is_some() {
            return Result::Err(self.duplicate())
        }
        match T::deserialize(mut decoder) {
            Result::Ok(value) => {
                slot = Option::Some(value)
                Result::Ok(())
            },
            Result::Err(error) => Result::Err(error.in_field(self.name)),
        }
    }

    /// Like `read`, decoding the value with the codec `C` instead of `T`'s own `Deserialize`.
    pub fn read_with<C: FieldCodec<T>, T, D: Decoder>(
        self,
        _ decoder: mut D,
        _ slot: mut Option<T>,
    ) -> CodecResult<()> {
        if slot.is_some() {
            return Result::Err(self.duplicate())
        }
        match <C as FieldCodec<T>>::deserialize(mut decoder) {
            Result::Ok(value) => {
                slot = Option::Some(value)
                Result::Ok(())
            },
            Result::Err(error) => Result::Err(error.in_field(self.name)),
        }
    }

    /// Like `read_with` for a field of type `Option<T>`: reads whether a value follows, then
    /// decodes it with the codec `C`. An absent value and an explicit `None` both fill the slot
    /// with `None`, as `read` does.
    pub fn read_optional_with<C: FieldCodec<T>, T, D: Decoder>(
        self,
        _ decoder: mut D,
        _ slot: mut Option<Option<T>>,
    ) -> CodecResult<()> {
        if slot.is_some() {
            return Result::Err(self.duplicate())
        }
        let present = match decoder.read_some() {
            Result::Ok(present) => present,
            Result::Err(error) => {
                return Result::Err(error.in_field(self.name))
            },
        }
        if !present {
            slot = Option::Some(Option::None)
            return Result::Ok(())
        }
        match <C as FieldCodec<T>>::deserialize(mut decoder) {
            Result::Ok(value) => {
                slot = Option::Some(Option::Some(value))
                Result::Ok(())
            },
            Result::Err(error) => Result::Err(error.in_field(self.name)),
        }
    }

    fn duplicate(self) -> CodecError {
        CodecError::at(kind: ErrorKind::DuplicateField, offset: self.offset).in_field(self.name)
    }

    /// The error for a field the deserializer does not handle.
    pub fn unknown(self) -> CodecError {
        CodecError::at(kind: ErrorKind::UnknownField, offset: self.offset)
    }
}

/// The value collected for an optional field: absent and explicit `None` both give `None`.
pub fn optional<T>(_ slot: own Option<Option<T>>) -> Option<T> {
    match slot {
        Option::Some(value) => value,
        Option::None => Option::None,
    }
}

/// A variant a decoder found on the wire: its index in the schema, whether a payload follows,
/// and the byte offset where the variant starts, for errors. A variant written bare has no
/// payload; one written as a wrapper has one, which the decoder is positioned at.
pub struct VariantKey { pub index: usize, pub payload: bool, pub offset: usize }
impl Copy for VariantKey {}

impl VariantKey {
    /// Fails with `TypeMismatch` at the variant when it carries a payload: the variant has
    /// none, so the wrapper is the wrong form.
    pub fn expect_unit(self) -> CodecResult<()> {
        if self.payload {
            return Result::Err(
                CodecError::at(kind: ErrorKind::TypeMismatch, offset: self.offset),
            )
        }
        Result::Ok(())
    }

    /// Fails with `TypeMismatch` at the variant when it carries no payload: the variant has
    /// one, so the bare form is the wrong one.
    pub fn expect_payload(self) -> CodecResult<()> {
        if !self.payload {
            return Result::Err(
                CodecError::at(kind: ErrorKind::TypeMismatch, offset: self.offset),
            )
        }
        Result::Ok(())
    }

    /// The error for a variant the deserializer does not handle.
    pub fn unknown(self) -> CodecError {
        CodecError::at(kind: ErrorKind::UnknownVariant, offset: self.offset)
    }
}
