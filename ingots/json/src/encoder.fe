use core::num::IntDowncast
use core::bytes::PackedBytes
use std::evm::Address
use fe_codec_core::{
    address_bytes,
    bounded_bytes,
    CodecError,
    CodecResult,
    Encoder,
    ErrorKind,
    Frame,
    Limits,
    MAX_NAME_BYTES,
    Schema,
    SchemaName,
    Structure,
    Text,
    TextWriter,
    checked_signed,
    checked_unsigned,
    checked_wide_signed,
    checked_wide_unsigned,
}
use fe_codec_io::{BoundedBuffer, ByteWriter}

/// `key` is set while a map key is written, which must be a string: text, an unsigned integer
/// in quotes, or hex bytes.
pub struct JsonEncoder<const N: usize> { output: ByteWriter<N>, structure: Structure, key: bool }

impl<const N: usize> JsonEncoder<N> {
    pub fn new(_ limits: Limits) -> Self {
        Self { output: ByteWriter<N>::new(), structure: Structure::new(limits), key: false }
    }

    pub fn finish(own self) -> CodecResult<BoundedBuffer<N>> {
        self.structure.finish(self.offset())?
        Result::Ok(self.output.finish())
    }

    fn error(self, _ kind: ErrorKind) -> CodecError {
        CodecError::at(kind, offset: self.offset())
    }

    fn byte(mut self, _ byte: u8) -> CodecResult<()> {
        self.output.write(byte).map_err(CodecError::from_io)
    }

    /// Opens a value position for a kind of value that cannot be a map key, which is
    /// `Unsupported` in key position.
    fn value(mut self, _ offset: usize) -> CodecResult<()> {
        if self.key {
            return Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset))
        }
        self.structure.value(offset)
    }

    /// The quote around an unsigned integer in key position.
    fn key_quote(mut self) -> CodecResult<()> {
        if self.key {
            self.byte(b'"')?
        }
        Result::Ok(())
    }

    fn bytes<const M: usize>(mut self, _ bytes: [u8; M]) -> CodecResult<()> {
        var index: usize = 0
        while index < M {
            self.byte(bytes[index])?
            index += 1
        }
        Result::Ok(())
    }

    fn decimal(mut self, _ number: u64) -> CodecResult<()> {
        var digits: [u8; 20] = [0; 20]
        var at: usize = 20
        var remaining = number
        loop {
            at -= 1
            let digit: u8 = (remaining % 10).downcast_unchecked()
            digits[at] = b'0' + digit
            remaining /= 10
            if remaining == 0 { break }
        }
        while at < 20 {
            self.byte(digits[at])?
            at += 1
        }
        Result::Ok(())
    }

    fn wide_decimal(mut self, _ number: u256) -> CodecResult<()> {
        var digits: [u8; 78] = [0; 78]
        var at: usize = 78
        var remaining = number
        loop {
            at -= 1
            let digit: u8 = (remaining % 10).downcast_unchecked()
            digits[at] = b'0' + digit
            remaining /= 10
            if remaining == 0 { break }
        }
        while at < 78 {
            self.byte(digits[at])?
            at += 1
        }
        Result::Ok(())
    }

    fn name(mut self, _ name: SchemaName) -> CodecResult<()> {
        var text = TextWriter<MAX_NAME_BYTES>::new()
        var index: usize = 0
        let offset = self.offset()
        while index < name.len() {
            text.write(name.byte_at(index).unwrap(), offset)?
            index += 1
        }
        self.string(text.finish(offset)?)
    }

    fn string<const M: usize>(mut self, _ value: Text<M>) -> CodecResult<()> {
        self.byte(b'"')?
        var index: usize = 0
        while index < value.len() {
            self.escaped(value.byte_at(index).unwrap())?
            index += 1
        }
        self.byte(b'"')
    }

    fn escaped(mut self, _ byte: u8) -> CodecResult<()> {
        match byte {
            b'"' => self.bytes<2>("\\\""),
            b'\\' => self.bytes<2>("\\\\"),
            8 => self.bytes<2>("\\b"),
            9 => self.bytes<2>("\\t"),
            10 => self.bytes<2>("\\n"),
            12 => self.bytes<2>("\\f"),
            13 => self.bytes<2>("\\r"),
            _ => {
                if byte < 32 {
                    self.bytes<4>("\\u00")?
                    self.byte(hex(byte >> 4))?
                    self.byte(hex(byte & 15))
                } else {
                    self.byte(byte)
                }
            },
        }
    }

    fn begin(mut self, _ marker: u8, _ count: usize) -> CodecResult<Frame> {
        let offset = self.offset()
        if self.key {
            return Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset))
        }
        self.structure.check_items(count, offset)?
        self.structure.begin(offset)?
        self.byte(marker)?
        Result::Ok(Frame::new(count))
    }

    /// Writes the separator before an entry; `first` is whether the frame was empty.
    fn separate(mut self, _ first: bool, _ offset: usize) -> CodecResult<()> {
        self.structure.member(offset)?
        if !first { self.byte(b',')? }
        Result::Ok(())
    }

    fn end(mut self, _ marker: u8, _ frame: own Frame) -> CodecResult<()> {
        let offset = self.offset()
        frame.complete(offset)?
        self.structure.end(offset)?
        self.byte(marker)
    }
}

impl<const N: usize> Encoder for JsonEncoder<N> {
    const OMIT_NONE: bool = true
    type Record = Frame
    type Sequence = Frame

    fn offset(self) -> usize {
        self.output.offset()
    }

    fn write_bool(mut self, _ value: bool) -> CodecResult<()> {
        let offset = self.offset()
        self.value(offset)?
        if value {
            self.bytes<4>("true")
        } else {
            self.bytes<5>("false")
        }
    }

    fn write_unsigned(mut self, _ value: u64, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        checked_unsigned(value, bits, offset)?
        self.key_quote()?
        self.decimal(value)?
        self.key_quote()
    }

    fn write_signed(mut self, _ value: i64, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.value(offset)?
        checked_signed(value, bits, offset)?
        if value < 0 {
            self.byte(b'-')?
            let magnitude_minus_one: u64 = (-(value + 1)).downcast_unchecked()
            self.decimal(magnitude_minus_one + 1)
        } else {
            self.decimal(value.downcast_unchecked())
        }
    }

    fn write_wide_unsigned(mut self, _ value: u256, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        checked_wide_unsigned(value, bits, offset)?
        self.key_quote()?
        self.wide_decimal(value)?
        self.key_quote()
    }

    fn write_wide_signed(mut self, _ value: i256, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.value(offset)?
        checked_wide_signed(value, bits, offset)?
        if value < 0 {
            self.byte(b'-')?
            let magnitude_minus_one: u256 = (-(value + 1)).downcast_unchecked()
            self.wide_decimal(magnitude_minus_one + 1)
        } else {
            self.wide_decimal(value.downcast_unchecked())
        }
    }

    fn write_text<const M: usize>(mut self, _ value: Text<M>) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        self.string(value)
    }

    /// Bytes are a string of `0x` and two lowercase hex digits per byte.
    fn write_bytes<const M: usize>(mut self, _ value: BoundedBuffer<M>) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        self.bytes<3>("\"0x")?
        var index: usize = 0
        while index < value.len() {
            let byte = value.byte_at(index).unwrap()
            self.byte(hex(byte >> 4))?
            self.byte(hex(byte & 15))?
            index += 1
        }
        self.byte(b'"')
    }

    fn write_fixed_bytes<const M: usize>(mut self, _ value: PackedBytes<M>) -> CodecResult<()> {
        self.write_bytes(bounded_bytes(value))
    }

    fn write_address(mut self, _ value: Address) -> CodecResult<()> {
        self.write_fixed_bytes(address_bytes(value))
    }

    fn write_none(mut self) -> CodecResult<()> {
        let offset = self.offset()
        self.value(offset)?
        self.bytes<4>("null")
    }

    fn write_some(mut self) -> CodecResult<()> {
        if self.key {
            return Result::Err(self.error(ErrorKind::Unsupported))
        }
        Result::Ok(())
    }

    fn write_variant<V: Schema>(mut self, _ index: usize) -> CodecResult<()> {
        let offset = self.offset()
        self.value(offset)?
        match V::variant(index) {
            Option::Some(variant) => self.name(variant.name),
            Option::None => Result::Err(self.error(ErrorKind::InvalidState)),
        }
    }

    /// A variant with a payload is an object of one member: the variant's name and the payload.
    fn begin_variant<V: Schema>(mut self, _ index: usize) -> CodecResult<Frame> {
        let offset = self.offset()
        let variant = match V::variant(index) {
            Option::Some(variant) => variant,
            Option::None => {
                return Result::Err(self.error(ErrorKind::InvalidState))
            },
        }
        var wrapper = self.begin(b'{', 1)?
        wrapper.take(offset)?
        self.separate(true, offset)?
        self.name(variant.name)?
        self.byte(b':')?
        Result::Ok(wrapper)
    }

    fn end_variant(mut self, _ variant: own Frame) -> CodecResult<()> {
        self.end(b'}', variant)
    }

    fn begin_record<R: Schema>(mut self, _ present: usize) -> CodecResult<Frame> {
        self.begin(b'{', present)
    }

    fn field<R: Schema>(mut self, _ record: mut Frame, _ position: usize) -> CodecResult<()> {
        let offset = self.offset()
        let field = match R::field(position) {
            Option::Some(field) => field,
            Option::None => {
                return Result::Err(self.error(ErrorKind::InvalidState))
            },
        }
        let first = record.taken() == 0
        record.key(field.id, offset)?
        self.separate(first, offset)?
        self.name(field.name)?
        self.byte(b':')
    }

    fn end_record(mut self, _ record: own Frame) -> CodecResult<()> {
        self.end(b'}', record)
    }

    fn begin_sequence(mut self, _ length: usize) -> CodecResult<Frame> {
        self.begin(b'[', length)
    }

    fn element(mut self, _ sequence: mut Frame) -> CodecResult<()> {
        let offset = self.offset()
        let first = sequence.taken() == 0
        sequence.take(offset)?
        self.separate(first, offset)
    }

    fn end_sequence(mut self, _ sequence: own Frame) -> CodecResult<()> {
        self.end(b']', sequence)
    }

    /// An object whose members are the entries, in the map's order.
    fn begin_map(mut self, _ length: usize) -> CodecResult<Frame> {
        self.begin(b'{', length)
    }

    fn map_key(mut self, _ map: mut Frame) -> CodecResult<()> {
        let offset = self.offset()
        let first = map.taken() == 0
        map.take(offset)?
        self.separate(first, offset)?
        self.key = true
        Result::Ok(())
    }

    fn map_value(mut self, _ map: mut Frame) -> CodecResult<()> {
        self.key = false
        let offset = self.offset()
        self.structure.member(offset)?
        self.byte(b':')
    }

    fn end_map(mut self, _ map: own Frame) -> CodecResult<()> {
        self.end(b'}', map)
    }
}

fn hex(_ digit: u8) -> u8 {
    if digit < 10 {
        b'0' + digit
    } else {
        b'a' + (digit - 10)
    }
}
