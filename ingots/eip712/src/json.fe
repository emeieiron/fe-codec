//! The `eth_signTypedData_v4` request a wallet signs: `types`, `primaryType`, `domain` and
//! `message`, as compact JSON.
//!
//! Integers are decimal strings, since JavaScript numbers lose precision above 2^53.
//! Addresses and byte strings are `0x` and lowercase hex. Everything else follows JSON.

use core::bytes::PackedBytes
use core::num::IntDowncast
use fe_codec_core::{
    BoundedBuffer,
    ByteWriter,
    CodecError,
    CodecResult,
    Encoder,
    ErrorKind,
    Frame,
    Limits,
    Schema,
    SchemaName,
    Structure,
    Text,
    address_bytes,
    bounded_bytes,
    checked_signed,
    checked_unsigned,
    checked_wide_signed,
    checked_wide_unsigned,
}
use std::evm::Address
use ingot::domain::Domain
use ingot::types::{TypeTable, bit}

pub struct TypedDataJsonEncoder<const N: usize> { output: ByteWriter<N>, structure: Structure }

impl<const N: usize> TypedDataJsonEncoder<N> {
    pub fn new(_ limits: Limits) -> Self {
        Self { output: ByteWriter<N>::new(), structure: Structure::new(limits) }
    }

    pub fn finish(own self) -> CodecResult<BoundedBuffer<N>> {
        self.structure.finish(self.offset())?
        Result::Ok(self.output.finish())
    }

    pub(ingot) fn byte(mut self, _ byte: u8) -> CodecResult<()> {
        self.output.write(byte).map_err(CodecError::from_io)
    }

    pub(ingot) fn literal<const M: usize>(mut self, _ bytes: [u8; M]) -> CodecResult<()> {
        var index: usize = 0
        while index < M {
            self.byte(bytes[index])?
            index += 1
        }
        Result::Ok(())
    }

    pub(ingot) fn quoted_name(mut self, _ name: SchemaName) -> CodecResult<()> {
        self.byte(b'"')?
        var index: usize = 0
        while index < name.len() {
            self.escaped(name.byte_at(index).unwrap())?
            index += 1
        }
        self.byte(b'"')
    }

    pub(ingot) fn quoted_text<const M: usize>(mut self, _ value: Text<M>) -> CodecResult<()> {
        self.byte(b'"')?
        var index: usize = 0
        while index < value.len() {
            self.escaped(value.byte_at(index).unwrap())?
            index += 1
        }
        self.byte(b'"')
    }

    fn escaped(mut self, _ byte: u8) -> CodecResult<()> {
        match byte {
            b'"' => self.literal<2>("\\\""),
            b'\\' => self.literal<2>("\\\\"),
            8 => self.literal<2>("\\b"),
            9 => self.literal<2>("\\t"),
            10 => self.literal<2>("\\n"),
            12 => self.literal<2>("\\f"),
            13 => self.literal<2>("\\r"),
            _ => {
                if byte < 32 {
                    self.literal<4>("\\u00")?
                    self.byte(hex(byte >> 4))?
                    self.byte(hex(byte & 15))
                } else {
                    self.byte(byte)
                }
            },
        }
    }

    /// `value` as a decimal string, negative when `negative`.
    pub(ingot) fn quoted_decimal(mut self, _ negative: bool, _ magnitude: u256) -> CodecResult<()> {
        var digits: [u8; 78] = [0; 78]
        var count: usize = 0
        var rest = magnitude
        loop {
            let digit: u8 = (rest % 10).downcast_truncate()
            digits[count] = b'0' + digit
            count += 1
            rest /= 10
            if rest == 0 { break }
        }
        self.byte(b'"')?
        if negative {
            self.byte(b'-')?
        }
        while count != 0 {
            count -= 1
            self.byte(digits[count])?
        }
        self.byte(b'"')
    }

    pub(ingot) fn quoted_hex<const M: usize>(mut self, _ value: BoundedBuffer<M>) -> CodecResult<
        (),
    > {
        self.literal<3>("\"0x")?
        var index: usize = 0
        while index < value.len() {
            let byte = value.byte_at(index).unwrap()
            self.byte(hex(byte >> 4))?
            self.byte(hex(byte & 15))?
            index += 1
        }
        self.byte(b'"')
    }

    fn signed(mut self, _ value: i256) -> CodecResult<()> {
        if value < 0 {
            let below: u256 = (-(value + 1)).downcast_unchecked()
            return self.quoted_decimal(true, below + 1)
        }
        self.quoted_decimal(false, value.downcast_unchecked())
    }

    fn begin(mut self, _ marker: u8, _ count: usize) -> CodecResult<Frame> {
        let offset = self.offset()
        self.structure.check_items(count, offset)?
        self.structure.begin(offset)?
        self.byte(marker)?
        Result::Ok(Frame::new(count))
    }

    fn end(mut self, _ marker: u8, _ frame: own Frame) -> CodecResult<()> {
        let offset = self.offset()
        frame.complete(offset)?
        self.structure.end(offset)?
        self.byte(marker)
    }
}

impl<const N: usize> Encoder for TypedDataJsonEncoder<N> {
    const OMIT_NONE: bool = false
    type Record = Frame
    type Sequence = Frame

    fn offset(self) -> usize {
        self.output.offset()
    }

    fn write_bool(mut self, _ value: bool) -> CodecResult<()> {
        self.structure.value(self.offset())?
        if value {
            self.literal<4>("true")
        } else {
            self.literal<5>("false")
        }
    }

    fn write_unsigned(mut self, _ value: u64, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        checked_unsigned(value, bits, offset)?
        self.quoted_decimal(false, value as u256)
    }

    fn write_signed(mut self, _ value: i64, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        checked_signed(value, bits, offset)?
        self.signed(value as i256)
    }

    fn write_wide_unsigned(mut self, _ value: u256, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        checked_wide_unsigned(value, bits, offset)?
        self.quoted_decimal(false, value)
    }

    fn write_wide_signed(mut self, _ value: i256, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        checked_wide_signed(value, bits, offset)?
        self.signed(value)
    }

    fn write_text<const M: usize>(mut self, _ value: Text<M>) -> CodecResult<()> {
        self.structure.value(self.offset())?
        self.quoted_text(value)
    }

    fn write_bytes<const M: usize>(mut self, _ value: BoundedBuffer<M>) -> CodecResult<()> {
        self.structure.value(self.offset())?
        self.quoted_hex(value)
    }

    fn write_fixed_bytes<const M: usize>(mut self, _ value: PackedBytes<M>) -> CodecResult<()> {
        self.write_bytes(bounded_bytes(value))
    }

    fn write_address(mut self, _ value: Address) -> CodecResult<()> {
        self.write_fixed_bytes(address_bytes(value))
    }

    fn write_none(mut self) -> CodecResult<()> {
        Result::Err(
            CodecError::at(kind: ErrorKind::Unsupported, offset: self.offset()),
        )
    }

    fn write_some(mut self) -> CodecResult<()> {
        Result::Err(
            CodecError::at(kind: ErrorKind::Unsupported, offset: self.offset()),
        )
    }

    fn write_variant<V: Schema>(mut self, _ index: usize) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        match V::variant(index) {
            Option::Some(variant) => {
                if variant.id > 255 {
                    return Result::Err(CodecError::at(kind: ErrorKind::IntegerOutOfRange, offset))
                }
                self.quoted_decimal(false, variant.id as u256)
            },
            Option::None => Result::Err(CodecError::at(kind: ErrorKind::InvalidState, offset)),
        }
    }

    fn begin_record<R: Schema>(mut self, _ present: usize) -> CodecResult<Frame> {
        self.begin(b'{', present)
    }

    fn field<R: Schema>(mut self, _ record: mut Frame, _ position: usize) -> CodecResult<()> {
        let offset = self.offset()
        let field = match R::field(position) {
            Option::Some(field) => field,
            Option::None => {
                return Result::Err(CodecError::at(kind: ErrorKind::InvalidState, offset))
            },
        }
        let first = record.taken() == 0
        record.key(field.id, offset)?
        self.structure.member(offset)?
        if !first { self.byte(b',')? }
        self.quoted_name(field.name)?
        self.byte(b':')
    }

    fn end_record(mut self, _ record: own Frame) -> CodecResult<()> {
        self.end(b'}', record)
    }

    fn begin_sequence(mut self, _ length: usize) -> CodecResult<Frame> {
        self.begin(b'[', length)
    }

    fn element(mut self, _ sequence: mut Frame) -> CodecResult<()> {
        let offset = self.offset()
        let first = sequence.taken() == 0
        sequence.take(offset)?
        self.structure.member(offset)?
        if !first { self.byte(b',')? }
        Result::Ok(())
    }

    fn end_sequence(mut self, _ sequence: own Frame) -> CodecResult<()> {
        self.end(b']', sequence)
    }
}

/// Writes `"types":{...}` for the domain and every struct in `table`: the primary type
/// first, the others in name order.
pub(ingot) fn write_types<const N: usize>(
    _ out: mut TypedDataJsonEncoder<N>,
    _ table: TypeTable,
    _ domain: Domain,
) -> CodecResult<()> {
    out.literal<25>("\"types\":{\"EIP712Domain\":[")?
    var first = true
    if domain.name.is_some() {
        member(mut out, mut first, "name", "string")?
    }
    if domain.version.is_some() {
        member(mut out, mut first, "version", "string")?
    }
    if domain.chain_id.is_some() {
        member(mut out, mut first, "chainId", "uint256")?
    }
    if domain.verifying_contract.is_some() {
        member(mut out, mut first, "verifyingContract", "address")?
    }
    if domain.salt.is_some() {
        member(mut out, mut first, "salt", "bytes32")?
    }
    out.byte(b']')?

    let primary = table.primary()?
    write_type(mut out, table, primary)?
    var done: u32 = bit(primary)
    loop {
        var best: Option<usize> = Option::None
        var index: usize = 0
        while index < table.count() {
            if done & bit(index) == 0 {
                best = match best {
                    Option::Some(current) => {
                        if table.entry(index).name.before(table.entry(current).name) {
                            Option::Some(index)
                        } else {
                            Option::Some(current)
                        }
                    },
                    Option::None => Option::Some(index),
                }
            }
            index += 1
        }
        match best {
            Option::Some(chosen) => {
                write_type(mut out, table, chosen)?
                done = done | bit(chosen)
            },
            Option::None => {
                return out.byte(b'}')
            },
        }
    }
}

fn member<const N: usize, const A: usize, const B: usize>(
    _ out: mut TypedDataJsonEncoder<N>,
    _ first: mut bool,
    _ name: [u8; A],
    _ ty: [u8; B],
) -> CodecResult<()> {
    if !first { out.byte(b',')? }
    first = false
    out.literal<9>("{\"name\":\"")?
    out.literal(name)?
    out.literal<10>("\",\"type\":\"")?
    out.literal(ty)?
    out.literal<2>("\"}")
}

/// `,"Name":[{"name":..,"type":..},...]`, read back from the type's definition
/// `Name(type name,type name)`.
fn write_type<const N: usize>(
    _ out: mut TypedDataJsonEncoder<N>,
    _ table: TypeTable,
    _ index: usize,
) -> CodecResult<()> {
    let entry = table.entry(index)
    out.byte(b',')?
    out.quoted_name(entry.name)?
    out.literal<2>(":[")?
    var at = entry.start + entry.name.len() + 1
    let end = entry.start + entry.len - 1
    var first = true
    while at < end {
        if !first { out.byte(b',')? }
        first = false
        // The type runs to the space, the name to the comma or the closing parenthesis.
        var type_end = at
        while table.arena_byte(type_end) != b' ' {
            type_end += 1
        }
        var name_end = type_end + 1
        while name_end < end && table.arena_byte(name_end) != b',' {
            name_end += 1
        }
        out.literal<9>("{\"name\":\"")?
        var position = type_end + 1
        while position < name_end {
            out.byte(table.arena_byte(position))?
            position += 1
        }
        out.literal<10>("\",\"type\":\"")?
        position = at
        while position < type_end {
            out.byte(table.arena_byte(position))?
            position += 1
        }
        out.literal<2>("\"}")?
        at = name_end + 1
    }
    out.byte(b']')
}

/// `"domain":{...}` with the domain's set fields.
pub(ingot) fn write_domain<const N: usize>(
    _ out: mut TypedDataJsonEncoder<N>,
    _ domain: Domain,
) -> CodecResult<()> {
    out.literal<10>("\"domain\":{")?
    var first = true
    // A wallet shows the name and version, so a domain set only by hashes has no request.
    if domain.name.is_some() {
        let name = match domain.name_text {
            Option::Some(name) => name,
            Option::None => {
                return Result::Err(
                    CodecError::at(kind: ErrorKind::Unsupported, offset: out.offset()),
                )
            },
        }
        key(mut out, mut first, "name")?
        out.quoted_text(name)?
    }
    if domain.version.is_some() {
        let version = match domain.version_text {
            Option::Some(version) => version,
            Option::None => {
                return Result::Err(
                    CodecError::at(kind: ErrorKind::Unsupported, offset: out.offset()),
                )
            },
        }
        key(mut out, mut first, "version")?
        out.quoted_text(version)?
    }
    if let Option::Some(chain_id) = domain.chain_id {
        key(mut out, mut first, "chainId")?
        out.quoted_decimal(false, chain_id)?
    }
    if let Option::Some(verifier) = domain.verifying_contract {
        key(mut out, mut first, "verifyingContract")?
        out.quoted_hex(bounded_bytes(address_bytes(verifier)))?
    }
    if let Option::Some(salt) = domain.salt {
        key(mut out, mut first, "salt")?
        out.quoted_hex(bounded_bytes(salt))?
    }
    out.byte(b'}')
}

fn key<const N: usize, const A: usize>(
    _ out: mut TypedDataJsonEncoder<N>,
    _ first: mut bool,
    _ name: [u8; A],
) -> CodecResult<()> {
    if !first { out.byte(b',')? }
    first = false
    out.byte(b'"')?
    out.literal(name)?
    out.literal<2>("\":")
}

fn hex(_ digit: u8) -> u8 {
    if digit < 10 {
        b'0' + digit
    } else {
        b'a' + (digit - 10)
    }
}
