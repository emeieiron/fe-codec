use core::num::IntDowncast
use core::bytes::PackedBytes
use std::evm::Address
use fe_codec_core::{
    address_from_bytes,
    exact_bytes,
    CodecError,
    CodecResult,
    Decoder,
    ErrorKind,
    FieldKey,
    Limits,
    MAX_NAME_BYTES,
    Schema,
    Structure,
    Text,
    TextWriter,
    Utf8,
    checked_signed,
    checked_unsigned,
    checked_wide_signed,
    checked_wide_unsigned,
}
use fe_codec_io::{BoundedBuffer, ByteReader, ByteWriter}

const MAX_UNSIGNED: u64 = 0xffffffffffffffff
const MAX_SIGNED: u64 = 0x7fffffffffffffff
const MAX_WIDE_UNSIGNED: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
const MAX_WIDE_SIGNED: u256 = 0x7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

pub struct Record { seen: usize }
/// An array being read. A list has no expected length: `expected` is its capacity, and it
/// ends where the array does.
pub struct Sequence { expected: usize, seen: usize, list: bool }

pub struct JsonDecoder<const N: usize> { input: ByteReader<N>, structure: Structure }

impl<const N: usize> JsonDecoder<N> {
    pub fn new(_ input: own BoundedBuffer<N>, _ limits: Limits) -> Self {
        Self { input: ByteReader<N>::new(input), structure: Structure::new(limits) }
    }

    pub fn finish(mut self) -> CodecResult<()> {
        self.structure.finish(self.offset())?
        self.whitespace()?
        if self.input.remaining() != 0 {
            return Result::Err(self.error(ErrorKind::TrailingData))
        }
        Result::Ok(())
    }

    fn error(self, _ kind: ErrorKind) -> CodecError {
        CodecError::at(kind, offset: self.offset())
    }

    fn byte(mut self) -> CodecResult<u8> {
        self.input.read().map_err(CodecError::from_io)
    }

    fn peek(self) -> CodecResult<u8> {
        match self.input.peek() {
            Option::Some(byte) => Result::Ok(byte),
            Option::None => Result::Err(self.error(ErrorKind::UnexpectedEnd)),
        }
    }

    fn whitespace(mut self) -> CodecResult<()> {
        while let Option::Some(byte) = self.input.peek() {
            if !is_whitespace(byte) {
                break
            }
            self.byte()?
        }
        Result::Ok(())
    }

    fn expect(mut self, _ marker: u8, _ kind: ErrorKind) -> CodecResult<()> {
        if self.peek()? != marker {
            return Result::Err(self.error(kind))
        }
        self.byte()?
        Result::Ok(())
    }

    fn word<const M: usize>(mut self, _ value: [u8; M]) -> CodecResult<()> {
        var index: usize = 0
        while index < M {
            self.expect(value[index], ErrorKind::InvalidSyntax)?
            index += 1
        }
        self.scalar_end()
    }

    fn scalar_end(self) -> CodecResult<()> {
        if let Option::Some(byte) = self.input.peek() {
            if !is_whitespace(byte) && byte != b',' && byte != b']' && byte != b'}' {
                return Result::Err(self.error(ErrorKind::InvalidSyntax))
            }
        }
        Result::Ok(())
    }

    /// Reads an optional minus sign and the first digit, which must follow it.
    fn integer_start(mut self) -> CodecResult<(bool, u8)> {
        let negative = self.peek()? == b'-'
        if negative { self.byte()? }
        let first = self.peek()?
        if !is_digit(first) {
            let kind = if negative {
                ErrorKind::InvalidSyntax
            } else {
                ErrorKind::TypeMismatch
            }
            return Result::Err(self.error(kind))
        }
        self.byte()?
        Result::Ok((negative, first))
    }

    /// Rejects a fraction or exponent and checks what follows the digits.
    fn integer_end(self) -> CodecResult<()> {
        if let Option::Some(byte) = self.input.peek() {
            if byte == b'.' || byte == b'e' || byte == b'E' {
                return Result::Err(self.error(ErrorKind::Unsupported))
            }
        }
        self.scalar_end()
    }

    /// A decimal integer whose magnitude fits 64 bits. A digit that would exceed them is
    /// reported where it stands.
    fn integer(mut self) -> CodecResult<(bool, u64)> {
        let (negative, first) = self.integer_start()?
        var value: u64 = (first - b'0') as u64
        while let Option::Some(byte) = self.input.peek() {
            if !is_digit(byte) { break }
            if first == b'0' {
                return Result::Err(self.error(ErrorKind::InvalidSyntax))
            }
            let digit = (byte - b'0') as u64
            if value > (MAX_UNSIGNED - digit) / 10 {
                return Result::Err(self.error(ErrorKind::IntegerOutOfRange))
            }
            self.byte()?
            value = value * 10 + digit
        }
        self.integer_end()?
        Result::Ok((negative, value))
    }

    /// A decimal integer whose magnitude fits 256 bits.
    fn wide_integer(mut self) -> CodecResult<(bool, u256)> {
        let (negative, first) = self.integer_start()?
        var value: u256 = (first - b'0') as u256
        while let Option::Some(byte) = self.input.peek() {
            if !is_digit(byte) { break }
            if first == b'0' {
                return Result::Err(self.error(ErrorKind::InvalidSyntax))
            }
            let digit = (byte - b'0') as u256
            if value > (MAX_WIDE_UNSIGNED - digit) / 10 {
                return Result::Err(self.error(ErrorKind::IntegerOutOfRange))
            }
            self.byte()?
            value = value * 10 + digit
        }
        self.integer_end()?
        Result::Ok((negative, value))
    }

    fn hex_digit(mut self) -> CodecResult<u8> {
        let offset = self.offset()
        let byte = self.byte()?
        if is_digit(byte) {
            return Result::Ok(byte - b'0')
        }
        if byte >= b'a' && byte <= b'f' {
            return Result::Ok(byte - b'a' + 10)
        }
        if byte >= b'A' && byte <= b'F' {
            return Result::Ok(byte - b'A' + 10)
        }
        Result::Err(CodecError::at(kind: ErrorKind::InvalidSyntax, offset))
    }

    fn hex_quad(mut self) -> CodecResult<u32> {
        var value: u32 = 0
        var index: usize = 0
        while index < 4 {
            let digit = self.hex_digit()?
            value = (value << 4) | (digit as u32)
            index += 1
        }
        Result::Ok(value)
    }

    fn codepoint(mut self, _ offset: usize) -> CodecResult<u32> {
        let first = self.hex_quad()?
        if first >= 0xd800 && first <= 0xdbff {
            let second_offset = self.offset()
            self.expect(b'\\', ErrorKind::InvalidUtf8)?
            self.expect(b'u', ErrorKind::InvalidUtf8)?
            let second = self.hex_quad()?
            if second < 0xdc00 || second > 0xdfff {
                return Result::Err(
                    CodecError::at(kind: ErrorKind::InvalidUtf8, offset: second_offset),
                )
            }
            return Result::Ok(0x10000 + ((first - 0xd800) << 10) + (second - 0xdc00))
        }
        if first >= 0xdc00 && first <= 0xdfff {
            return Result::Err(CodecError::at(kind: ErrorKind::InvalidUtf8, offset))
        }
        Result::Ok(first)
    }

    /// The code point an escape stands for, after its backslash.
    fn escape_value(mut self, _ offset: usize) -> CodecResult<u32> {
        let marker_offset = self.offset()
        let value: u32 = match self.byte()? {
            b'"' => 0x22,
            b'\\' => 0x5c,
            b'/' => 0x2f,
            b'b' => 8,
            b'f' => 12,
            b'n' => 10,
            b'r' => 13,
            b't' => 9,
            b'u' => self.codepoint(offset)?,
            _ => {
                return Result::Err(
                    CodecError::at(kind: ErrorKind::InvalidSyntax, offset: marker_offset),
                )
            },
        }
        Result::Ok(value)
    }

    fn escape<const M: usize>(mut self, _ text: mut TextWriter<M>, _ offset: usize) -> CodecResult<
        (),
    > {
        let value = self.escape_value(offset)?
        write_codepoint(mut text, value, offset)
    }

    fn string<const M: usize>(mut self) -> CodecResult<Text<M>> {
        self.expect(b'"', ErrorKind::TypeMismatch)?
        var text = TextWriter<M>::new()
        loop {
            let offset = self.offset()
            let byte = self.byte()?
            if byte == b'"' {
                return text.finish(offset)
            }
            if byte == b'\\' {
                text.boundary(offset)?
                self.escape(mut text, offset)?
            } else {
                if byte < 32 {
                    return Result::Err(CodecError::at(kind: ErrorKind::InvalidSyntax, offset))
                }
                text.write(byte, offset)?
            }
        }
    }

    fn begin(mut self, _ marker: u8) -> CodecResult<()> {
        self.whitespace()?
        let offset = self.offset()
        self.structure.begin(offset)?
        self.expect(marker, ErrorKind::TypeMismatch)
    }

    fn end(mut self, _ marker: u8, _ kind: ErrorKind) -> CodecResult<()> {
        self.whitespace()?
        let offset = self.offset()
        self.expect(marker, kind)?
        self.structure.end(offset)
    }

    fn separator(mut self, _ seen: usize) -> CodecResult<()> {
        if seen != 0 {
            self.expect(b',', ErrorKind::InvalidSyntax)?
            self.whitespace()?
        }
        let offset = self.offset()
        self.structure.check_items(seen + 1, offset)
    }

    /// A member name. One longer than any schema name can hold is reported as `unknown`.
    fn member_name(mut self, _ unknown: ErrorKind, _ offset: usize) -> CodecResult<Text<MAX_NAME_BYTES>> {
        match self.string<MAX_NAME_BYTES>() {
            Result::Ok(name) => Result::Ok(name),
            Result::Err(error) => {
                if error.kind == ErrorKind::CapacityExceeded {
                    return Result::Err(CodecError::at(kind: unknown, offset))
                }
                Result::Err(error)
            },
        }
    }

    /// Reads a string and validates it as `string` does, without keeping it.
    fn skip_string(mut self) -> CodecResult<()> {
        self.expect(b'"', ErrorKind::TypeMismatch)?
        var utf8 = Utf8::new()
        loop {
            let offset = self.offset()
            let byte = self.byte()?
            if byte == b'"' {
                return utf8.finish(offset)
            }
            if byte == b'\\' {
                utf8.finish(offset)?
                let _ = self.escape_value(offset)?
            } else {
                if byte < 32 {
                    return Result::Err(CodecError::at(kind: ErrorKind::InvalidSyntax, offset))
                }
                utf8.push(byte, offset)?
            }
        }
    }

    /// One or more digits.
    fn skip_digits(mut self) -> CodecResult<()> {
        if !is_digit(self.peek()?) {
            return Result::Err(self.error(ErrorKind::InvalidSyntax))
        }
        while let Option::Some(byte) = self.input.peek() {
            if !is_digit(byte) { break }
            self.byte()?
        }
        Result::Ok(())
    }

    /// A number of RFC 8259's grammar: an integer without leading zeros, then an optional
    /// fraction and exponent.
    fn skip_number(mut self) -> CodecResult<()> {
        if self.peek()? == b'-' {
            self.byte()?
        }
        if self.peek()? == b'0' {
            self.byte()?
            if let Option::Some(byte) = self.input.peek() {
                if is_digit(byte) {
                    return Result::Err(self.error(ErrorKind::InvalidSyntax))
                }
            }
        } else {
            self.skip_digits()?
        }
        if self.input.peek() == Option::Some(b'.') {
            self.byte()?
            self.skip_digits()?
        }
        if self.input.peek() == Option::Some(b'e') || self.input.peek() == Option::Some(b'E') {
            self.byte()?
            if self.input.peek() == Option::Some(b'+') || self.input.peek() == Option::Some(b'-') {
                self.byte()?
            }
            self.skip_digits()?
        }
        self.scalar_end()
    }

    /// An object whose members are skipped. Repeated names are not detected: no state is kept
    /// for them.
    fn skip_object(mut self) -> CodecResult<()> {
        self.begin(b'{')?
        var seen: usize = 0
        loop {
            self.whitespace()?
            if self.peek()? == b'}' {
                break
            }
            self.separator(seen)?
            let offset = self.offset()
            self.skip_string()?
            self.whitespace()?
            self.expect(b':', ErrorKind::InvalidSyntax)?
            self.structure.member(offset)?
            self.skip_value()?
            seen += 1
        }
        self.end(b'}', ErrorKind::InvalidSyntax)
    }

    fn skip_array(mut self) -> CodecResult<()> {
        self.begin(b'[')?
        var seen: usize = 0
        loop {
            self.whitespace()?
            if self.peek()? == b']' {
                break
            }
            self.separator(seen)?
            let offset = self.offset()
            self.structure.member(offset)?
            self.skip_value()?
            seen += 1
        }
        self.end(b']', ErrorKind::InvalidSyntax)
    }
}

impl<const N: usize> Decoder for JsonDecoder<N> {
    type Record = Record
    type Sequence = Sequence

    fn offset(self) -> usize {
        self.input.offset()
    }

    fn read_bool(mut self) -> CodecResult<bool> {
        self.whitespace()?
        let offset = self.offset()
        self.structure.value(offset)?
        match self.peek()? {
            b't' => {
                self.word<4>("true")?
                Result::Ok(true)
            },
            b'f' => {
                self.word<5>("false")?
                Result::Ok(false)
            },
            _ => Result::Err(self.error(ErrorKind::TypeMismatch)),
        }
    }

    fn read_unsigned(mut self, _ bits: u16) -> CodecResult<u64> {
        self.whitespace()?
        let offset = self.offset()
        self.structure.value(offset)?
        let (negative, value) = self.integer()?
        if negative {
            return Result::Err(CodecError::at(kind: ErrorKind::IntegerOutOfRange, offset))
        }
        checked_unsigned(value, bits, offset)
    }

    fn read_signed(mut self, _ bits: u16) -> CodecResult<i64> {
        self.whitespace()?
        let offset = self.offset()
        self.structure.value(offset)?
        let (negative, magnitude) = self.integer()?
        if magnitude > MAX_SIGNED + (negative as u64) {
            return Result::Err(CodecError::at(kind: ErrorKind::IntegerOutOfRange, offset))
        }
        let value: i64 = if negative && magnitude != 0 {
            let magnitude_minus_one: i64 = (magnitude - 1).downcast_unchecked()
            (-magnitude_minus_one) - 1
        } else {
            magnitude.downcast_unchecked()
        }
        checked_signed(value, bits, offset)
    }

    fn read_wide_unsigned(mut self, _ bits: u16) -> CodecResult<u256> {
        self.whitespace()?
        let offset = self.offset()
        self.structure.value(offset)?
        let (negative, value) = self.wide_integer()?
        if negative {
            return Result::Err(CodecError::at(kind: ErrorKind::IntegerOutOfRange, offset))
        }
        checked_wide_unsigned(value, bits, offset)
    }

    fn read_wide_signed(mut self, _ bits: u16) -> CodecResult<i256> {
        self.whitespace()?
        let offset = self.offset()
        self.structure.value(offset)?
        let (negative, magnitude) = self.wide_integer()?
        let limit = if negative { MAX_WIDE_SIGNED + 1 } else { MAX_WIDE_SIGNED }
        if magnitude > limit {
            return Result::Err(CodecError::at(kind: ErrorKind::IntegerOutOfRange, offset))
        }
        let value: i256 = if negative && magnitude != 0 {
            let magnitude_minus_one: i256 = (magnitude - 1).downcast_unchecked()
            (-magnitude_minus_one) - 1
        } else {
            magnitude.downcast_unchecked()
        }
        checked_wide_signed(value, bits, offset)
    }

    fn read_text<const M: usize>(mut self) -> CodecResult<Text<M>> {
        self.whitespace()?
        let offset = self.offset()
        self.structure.value(offset)?
        self.string<M>()
    }

    /// A string of `0x` and an even number of hex digits in either case.
    fn read_bytes<const M: usize>(mut self) -> CodecResult<BoundedBuffer<M>> {
        self.whitespace()?
        let offset = self.offset()
        self.structure.value(offset)?
        self.expect(b'"', ErrorKind::TypeMismatch)?
        self.expect(b'0', ErrorKind::InvalidSyntax)?
        self.expect(b'x', ErrorKind::InvalidSyntax)?
        var output = ByteWriter<M>::new()
        loop {
            let at = self.offset()
            if self.peek()? == b'"' {
                self.byte()?
                return Result::Ok(output.finish())
            }
            let high = self.hex_digit()?
            if self.peek()? == b'"' {
                return Result::Err(self.error(ErrorKind::InvalidSyntax))
            }
            let low = self.hex_digit()?
            if output.write((high << 4) | low).is_err() {
                return Result::Err(CodecError::at(kind: ErrorKind::CapacityExceeded, offset: at))
            }
        }
    }

    fn read_fixed_bytes<const M: usize>(mut self) -> CodecResult<PackedBytes<M>> {
        let start = self.offset()
        match exact_bytes(self.read_bytes<M>()?) {
            Option::Some(bytes) => Result::Ok(bytes),
            Option::None => Result::Err(CodecError::at(kind: ErrorKind::InvalidLength, offset: start)),
        }
    }

    fn read_address(mut self) -> CodecResult<Address> {
        Result::Ok(address_from_bytes(self.read_fixed_bytes<20>()?))
    }

    fn read_some(mut self) -> CodecResult<bool> {
        self.whitespace()?
        if self.input.peek() == Option::Some(b'n') {
            let offset = self.offset()
            self.structure.value(offset)?
            self.word<4>("null")?
            return Result::Ok(false)
        }
        Result::Ok(true)
    }

    fn read_variant<V: Schema>(mut self) -> CodecResult<usize> {
        self.whitespace()?
        let offset = self.offset()
        self.structure.value(offset)?
        let name = self.member_name(ErrorKind::UnknownVariant, offset)?
        var index: usize = 0
        while let Option::Some(variant) = V::variant(index) {
            if variant.name.equals(name) {
                return Result::Ok(index)
            }
            index += 1
        }
        Result::Err(CodecError::at(kind: ErrorKind::UnknownVariant, offset))
    }

    /// Any RFC 8259 value. Numbers may have fractions and exponents. Containers count toward
    /// `Limits.max_depth` and `Limits.max_items`.
    fn skip_value(mut self) -> CodecResult<()> {
        self.whitespace()?
        let offset = self.offset()
        let first = self.peek()?
        if first == b'{' {
            return self.skip_object()
        }
        if first == b'[' {
            return self.skip_array()
        }
        if first == b'"' {
            self.structure.value(offset)?
            return self.skip_string()
        }
        if first == b'-' || is_digit(first) {
            self.structure.value(offset)?
            return self.skip_number()
        }
        if first == b't' {
            self.structure.value(offset)?
            return self.word<4>("true")
        }
        if first == b'f' {
            self.structure.value(offset)?
            return self.word<5>("false")
        }
        if first == b'n' {
            self.structure.value(offset)?
            return self.word<4>("null")
        }
        Result::Err(CodecError::at(kind: ErrorKind::InvalidSyntax, offset))
    }

    fn begin_record<R: Schema>(mut self) -> CodecResult<Record> {
        self.begin(b'{')?
        Result::Ok(Record { seen: 0 })
    }

    fn next_field<R: Schema>(mut self, _ record: mut Record) -> CodecResult<Option<FieldKey>> {
        loop {
            self.whitespace()?
            if self.peek()? == b'}' {
                return Result::Ok(Option::None)
            }
            self.separator(record.seen)?
            let offset = self.offset()
            let skips = R::skips_unknown_fields()
            var known: Option<Text<MAX_NAME_BYTES>> = Option::None
            match self.member_name(ErrorKind::UnknownField, offset) {
                Result::Ok(name) => known = Option::Some(name),
                Result::Err(error) => {
                    // A name too long for any field is unknown. Read it again to skip it.
                    if !skips || error.kind != ErrorKind::UnknownField {
                        return Result::Err(error)
                    }
                    self.input.rewind(offset)
                    self.skip_string()?
                },
            }
            self.whitespace()?
            self.expect(b':', ErrorKind::InvalidSyntax)?
            self.structure.member(offset)?
            record.seen += 1

            if let Option::Some(name) = known {
                var position: usize = 0
                while let Option::Some(field) = R::field(position) {
                    if field.name.equals(name) {
                        return Result::Ok(FieldKey::of<R>(position, offset))
                    }
                    position += 1
                }
            }
            if !skips {
                return Result::Err(CodecError::at(kind: ErrorKind::UnknownField, offset))
            }
            self.skip_value()?
        }
    }

    fn end_record(mut self, _ record: own Record) -> CodecResult<()> {
        self.end(b'}', ErrorKind::InvalidSyntax)
    }

    fn begin_sequence(mut self, _ length: usize) -> CodecResult<Sequence> {
        self.begin(b'[')?
        Result::Ok(Sequence { expected: length, seen: 0, list: false })
    }

    fn element(mut self, _ sequence: mut Sequence) -> CodecResult<()> {
        self.whitespace()?
        if self.peek()? == b']' || sequence.seen == sequence.expected {
            return Result::Err(self.error(ErrorKind::InvalidLength))
        }
        self.separator(sequence.seen)?
        if self.peek()? == b']' {
            return Result::Err(self.error(ErrorKind::InvalidLength))
        }
        let offset = self.offset()
        self.structure.member(offset)?
        sequence.seen += 1
        Result::Ok(())
    }

    fn end_sequence(mut self, _ sequence: own Sequence) -> CodecResult<()> {
        if !sequence.list && sequence.seen != sequence.expected {
            return Result::Err(self.error(ErrorKind::InvalidLength))
        }
        self.end(b']', ErrorKind::InvalidLength)
    }

    fn begin_list(mut self, _ capacity: usize) -> CodecResult<Sequence> {
        self.begin(b'[')?
        Result::Ok(Sequence { expected: capacity, seen: 0, list: true })
    }

    /// An element past the capacity is `CapacityExceeded` where it starts. `Limits.max_items`
    /// is checked first.
    fn next_element(mut self, _ sequence: mut Sequence) -> CodecResult<bool> {
        self.whitespace()?
        if self.peek()? == b']' {
            return Result::Ok(false)
        }
        self.separator(sequence.seen)?
        // A comma must be followed by an element.
        if self.peek()? == b']' {
            return Result::Err(self.error(ErrorKind::InvalidSyntax))
        }
        let offset = self.offset()
        if sequence.seen == sequence.expected {
            return Result::Err(CodecError::at(kind: ErrorKind::CapacityExceeded, offset))
        }
        self.structure.member(offset)?
        sequence.seen += 1
        Result::Ok(true)
    }
}

fn is_whitespace(_ byte: u8) -> bool {
    byte == b' ' || byte == 9 || byte == 10 || byte == 13
}

fn is_digit(_ byte: u8) -> bool {
    byte >= b'0' && byte <= b'9'
}

fn continuation<const N: usize>(
    _ text: mut TextWriter<N>,
    _ value: u32,
    _ offset: usize,
) -> CodecResult<()> {
    let byte: u8 = (value & 0x3f).downcast_unchecked()
    text.write(0x80 | byte, offset)
}

fn write_codepoint<const N: usize>(
    _ text: mut TextWriter<N>,
    _ value: u32,
    _ offset: usize,
) -> CodecResult<()> {
    if value < 0x80 {
        return text.write(value.downcast_unchecked(), offset)
    }
    if value < 0x800 {
        let leading: u8 = (value >> 6).downcast_unchecked()
        text.write(0xc0 | leading, offset)?
    } else if value < 0x10000 {
        let leading: u8 = (value >> 12).downcast_unchecked()
        text.write(0xe0 | leading, offset)?
        continuation(mut text, value >> 6, offset)?
    } else {
        let leading: u8 = (value >> 18).downcast_unchecked()
        text.write(0xf0 | leading, offset)?
        continuation(mut text, value >> 12, offset)?
        continuation(mut text, value >> 6, offset)?
    }
    continuation(mut text, value, offset)
}
