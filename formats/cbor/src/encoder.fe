use core::num::IntDowncast
use fe_codec_core::{
    CodecError,
    CodecResult,
    Encoder,
    ErrorKind,
    Frame,
    Limits,
    Schema,
    Structure,
    Text,
    checked_signed,
    checked_unsigned,
    checked_wide_signed,
    checked_wide_unsigned,
}
use fe_codec_io::{BoundedBuffer, ByteWriter}
use ingot::canonical::{additional_info, head_width}

const MAX_ARGUMENT: u256 = 0xffffffffffffffff

pub struct CborEncoder<const N: usize> { output: ByteWriter<N>, structure: Structure }

impl<const N: usize> CborEncoder<N> {
    pub fn new(_ limits: Limits) -> Self {
        Self { output: ByteWriter<N>::new(), structure: Structure::new(limits) }
    }

    pub fn finish(own self) -> CodecResult<BoundedBuffer<N>> {
        self.structure.finish(self.offset())?
        Result::Ok(self.output.finish())
    }

    fn byte(mut self, _ byte: u8) -> CodecResult<()> {
        self.output.write(byte).map_err(CodecError::from_io)
    }

    fn length(self, _ length: usize) -> CodecResult<u64> {
        match length.downcast() {
            Option::Some(value) => Result::Ok(value),
            Option::None => Result::Err(
                CodecError::at(kind: ErrorKind::InvalidLength, offset: self.offset()),
            ),
        }
    }

    fn header(mut self, _ major: u8, _ argument: u64) -> CodecResult<()> {
        let tag = major << 5
        let width = head_width(argument)
        if width == 0 {
            return self.byte(tag | argument.downcast_unchecked())
        }
        self.byte(tag | additional_info(width))?
        var remaining = width
        while remaining != 0 {
            remaining -= 1
            self.byte(
                (argument >> ((remaining * 8) as u64)).downcast_truncate(),
            )?
        }
        Result::Ok(())
    }

    /// A non-negative integer: major type `major` when it fits 64 bits, otherwise the
    /// bignum tag `tag` around its big-endian bytes without leading zeros.
    fn integer(mut self, _ major: u8, _ tag: u8, _ value: u256) -> CodecResult<()> {
        if value <= MAX_ARGUMENT {
            return self.header(major, value.downcast_unchecked())
        }
        var width: u64 = 32
        while (value >> (((width - 1) * 8) as u256)) == 0 {
            width -= 1
        }
        self.header(6, tag as u64)?
        self.header(2, width)?
        while width != 0 {
            width -= 1
            self.byte((value >> ((width * 8) as u256)).downcast_truncate())?
        }
        Result::Ok(())
    }

    fn begin(mut self, _ major: u8, _ count: usize) -> CodecResult<Frame> {
        let offset = self.offset()
        self.structure.check_items(count, offset)?
        self.structure.begin(offset)?
        let argument = self.length(count)?
        self.header(major, argument)?
        Result::Ok(Frame::new(count))
    }

    fn end(mut self, _ frame: own Frame) -> CodecResult<()> {
        let offset = self.offset()
        frame.complete(offset)?
        self.structure.end(offset)
    }
}

impl<const N: usize> Encoder for CborEncoder<N> {
    const OMIT_NONE: bool = true
    type Record = Frame
    type Sequence = Frame

    fn offset(self) -> usize {
        self.output.offset()
    }

    fn write_bool(mut self, _ value: bool) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        self.byte(if value { 0xf5 } else { 0xf4 })
    }

    fn write_unsigned(mut self, _ value: u64, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        checked_unsigned(value, bits, offset)?
        self.header(0, value)
    }

    fn write_signed(mut self, _ value: i64, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        checked_signed(value, bits, offset)?
        if value < 0 {
            self.header(1, (-(value + 1)).downcast_unchecked())
        } else {
            self.header(0, value.downcast_unchecked())
        }
    }

    fn write_wide_unsigned(mut self, _ value: u256, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        checked_wide_unsigned(value, bits, offset)?
        self.integer(0, 2, value)
    }

    fn write_wide_signed(mut self, _ value: i256, _ bits: u16) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        checked_wide_signed(value, bits, offset)?
        if value < 0 {
            self.integer(1, 3, (-(value + 1)).downcast_unchecked())
        } else {
            self.integer(0, 2, value.downcast_unchecked())
        }
    }

    fn write_bytes<const M: usize>(mut self, _ value: BoundedBuffer<M>) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        let length = self.length(value.len())?
        self.header(2, length)?
        var index: usize = 0
        while index < value.len() {
            self.byte(value.byte_at(index).unwrap())?
            index += 1
        }
        Result::Ok(())
    }

    fn write_text<const M: usize>(mut self, _ value: Text<M>) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        let length = self.length(value.len())?
        self.header(3, length)?
        var index: usize = 0
        while index < value.len() {
            self.byte(value.byte_at(index).unwrap())?
            index += 1
        }
        Result::Ok(())
    }

    fn write_none(mut self) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        self.byte(0xf6)
    }

    fn write_some(mut self) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_variant<V: Schema>(mut self, _ index: usize) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.value(offset)?
        match V::variant(index) {
            Option::Some(variant) => self.header(0, variant.id),
            Option::None => Result::Err(CodecError::at(kind: ErrorKind::InvalidState, offset)),
        }
    }

    fn begin_record<R: Schema>(mut self, _ present: usize) -> CodecResult<Frame> {
        self.begin(5, present)
    }

    fn field<R: Schema>(mut self, _ record: mut Frame, _ position: usize) -> CodecResult<()> {
        let offset = self.offset()
        let field = match R::field(position) {
            Option::Some(field) => field,
            Option::None => {
                return Result::Err(CodecError::at(kind: ErrorKind::InvalidState, offset))
            },
        }
        self.structure.member(offset)?
        record.key(field.id, offset)?
        self.header(0, field.id)
    }

    fn end_record(mut self, _ record: own Frame) -> CodecResult<()> {
        self.end(record)
    }

    fn begin_sequence(mut self, _ length: usize) -> CodecResult<Frame> {
        self.begin(4, length)
    }

    fn element(mut self, _ sequence: mut Frame) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.member(offset)?
        sequence.take(offset)
    }

    fn end_sequence(mut self, _ sequence: own Frame) -> CodecResult<()> {
        self.end(sequence)
    }
}
