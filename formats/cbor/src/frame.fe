use fe_codec_core::{CodecError, CodecResult, ErrorKind}

pub struct Frame { pub remaining: usize, pub last_id: Option<u64> }

impl Frame {
    pub fn new(_ count: usize) -> Self {
        Self { remaining: count, last_id: Option::None }
    }

    pub fn take(mut self, _ offset: usize) -> CodecResult<()> {
        if self.remaining == 0 {
            return Result::Err(CodecError::at(kind: ErrorKind::InvalidLength, offset))
        }
        self.remaining -= 1
        Result::Ok(())
    }

    pub fn key(mut self, _ id: u64, _ offset: usize) -> CodecResult<()> {
        if id == 0 {
            return Result::Err(CodecError::at(kind: ErrorKind::UnknownField, offset))
        }
        if let Option::Some(last_id) = self.last_id {
            if id == last_id {
                return Result::Err(CodecError::at(kind: ErrorKind::DuplicateField, offset))
            }
            if id < last_id {
                return Result::Err(CodecError::at(kind: ErrorKind::NonCanonical, offset))
            }
        }
        self.last_id = Option::Some(id)
        self.take(offset)
    }

    pub fn complete(self, _ offset: usize) -> CodecResult<()> {
        if self.remaining != 0 {
            return Result::Err(CodecError::at(kind: ErrorKind::InvalidLength, offset))
        }
        Result::Ok(())
    }
}
