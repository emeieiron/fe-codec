use core::num::IntDowncast
use core::bytes::PackedBytes
use std::evm::Address
use fe_codec_core::{
    address_from_bytes,
    exact_bytes,
    CodecError,
    CodecResult,
    Decoder,
    ErrorKind,
    FieldKey,
    Frame,
    Limits,
    Schema,
    Structure,
    Text,
    TextWriter,
    Utf8,
    checked_signed,
    checked_unsigned,
    checked_wide_signed,
    checked_wide_unsigned,
}
use fe_codec_io::{BoundedBuffer, ByteReader, ByteWriter}
use ingot::canonical::minimum_argument

const MAX_SIGNED: u256 = 0x7fffffffffffffff
const MAX_ARGUMENT: u256 = 0xffffffffffffffff
const MAX_WIDE_SIGNED: u256 = 0x7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

/// The order of two map keys, by their encoded bytes.
enum KeyOrder {
    Ascending,
    Equal,
    Descending,
}

/// An array or map being read. A map also remembers where the key it is reading starts and
/// the byte range of the key before it, to check that the keys ascend.
pub struct Sequence { frame: Frame, key: usize, previous: usize, previous_end: usize }

impl Sequence {
    fn new(_ frame: own Frame) -> Self {
        Self { frame, key: 0, previous: 0, previous_end: 0 }
    }
}

pub struct CborDecoder<const N: usize> { input: ByteReader<N>, structure: Structure }

impl<const N: usize> CborDecoder<N> {
    pub fn new(_ input: own BoundedBuffer<N>, _ limits: Limits) -> Self {
        Self { input: ByteReader<N>::new(input), structure: Structure::new(limits) }
    }

    pub fn finish(self) -> CodecResult<()> {
        self.structure.finish(self.offset())?
        if self.input.remaining() != 0 {
            return Result::Err(self.error(ErrorKind::TrailingData))
        }
        Result::Ok(())
    }

    fn error(self, _ kind: ErrorKind) -> CodecError {
        CodecError::at(kind, offset: self.offset())
    }

    fn byte(mut self) -> CodecResult<u8> {
        self.input.read().map_err(CodecError::from_io)
    }

    fn argument(mut self, _ additional: u8, _ offset: usize) -> CodecResult<u64> {
        if additional < 24 {
            return Result::Ok(additional as u64)
        }
        if additional > 27 {
            let kind = if additional == 31 {
                ErrorKind::NonCanonical
            } else {
                ErrorKind::InvalidSyntax
            }
            return Result::Err(CodecError::at(kind, offset))
        }
        let width: u8 = 1 << (additional - 24)
        var value: u64 = 0
        var index: u8 = 0
        while index < width {
            value = (value << 8) | (self.byte()? as u64)
            index += 1
        }
        if value < minimum_argument(width) {
            return Result::Err(CodecError::at(kind: ErrorKind::NonCanonical, offset))
        }
        Result::Ok(value)
    }

    fn header(mut self, _ major: u8) -> CodecResult<u64> {
        let offset = self.offset()
        let tag = self.byte()?
        if tag >> 5 != major {
            return Result::Err(CodecError::at(kind: ErrorKind::TypeMismatch, offset))
        }
        self.argument(tag & 31, offset)
    }

    /// An integer as its sign and magnitude, from major type 0 or 1 or from bignum tag 2
    /// or 3. A bignum must exceed 64 bits, fit 256 and have no leading zero bytes, which
    /// keeps every integer to one encoding. Errors report the item's first byte.
    fn integer(mut self) -> CodecResult<(bool, u256)> {
        let offset = self.offset()
        let tag = self.byte()?
        let major = tag >> 5
        if major == 0 || major == 1 {
            let argument = self.argument(tag & 31, offset)?
            return Result::Ok((major == 1, argument as u256))
        }
        if major != 6 {
            return Result::Err(CodecError::at(kind: ErrorKind::TypeMismatch, offset))
        }
        let number = self.argument(tag & 31, offset)?
        if number != 2 && number != 3 {
            return Result::Err(CodecError::at(kind: ErrorKind::TypeMismatch, offset))
        }
        self.bignum(number, offset)
    }

    /// The byte string of a bignum whose tag `number`, 2 or 3, was just read at `offset`.
    fn bignum(mut self, _ number: u64, _ offset: usize) -> CodecResult<(bool, u256)> {
        let length = self.header(2)?
        if length > 32 {
            return Result::Err(CodecError::at(kind: ErrorKind::IntegerOutOfRange, offset))
        }
        var value: u256 = 0
        var index: u64 = 0
        while index < length {
            let byte = self.byte()?
            if index == 0 && byte == 0 {
                return Result::Err(CodecError::at(kind: ErrorKind::NonCanonical, offset))
            }
            value = (value << 8) | (byte as u256)
            index += 1
        }
        if value <= MAX_ARGUMENT {
            return Result::Err(CodecError::at(kind: ErrorKind::NonCanonical, offset))
        }
        Result::Ok((number == 3, value))
    }

    /// How the encoded key at `first` to `first_end` sorts against the one at `second` to
    /// `second_end`, both already read: bytewise, with a prefix sorting first.
    fn compare_keys(
        self,
        _ first: usize,
        _ first_end: usize,
        _ second: usize,
        _ second_end: usize,
    ) -> KeyOrder {
        var index: usize = 0
        while first + index < first_end && second + index < second_end {
            let a = self.input.byte_at(first + index).unwrap()
            let b = self.input.byte_at(second + index).unwrap()
            if a != b {
                if a < b {
                    return KeyOrder::Ascending
                }
                return KeyOrder::Descending
            }
            index += 1
        }
        let first_length = first_end - first
        let second_length = second_end - second
        if first_length < second_length {
            KeyOrder::Ascending
        } else if first_length == second_length {
            KeyOrder::Equal
        } else {
            KeyOrder::Descending
        }
    }

    /// Checks that the key at `key` to `key_end` sorts strictly after the one before it, at
    /// `previous` to `previous_end`, which exists unless this is the first entry. A repeated
    /// key is `DuplicateField` and one out of order `NonCanonical`, both at the key.
    fn check_key_order(
        self,
        _ first: bool,
        _ previous: usize,
        _ previous_end: usize,
        _ key: usize,
        _ key_end: usize,
    ) -> CodecResult<()> {
        if first {
            return Result::Ok(())
        }
        match self.compare_keys(previous, previous_end, key, key_end) {
            KeyOrder::Ascending => Result::Ok(()),
            KeyOrder::Equal => Result::Err(CodecError::at(kind: ErrorKind::DuplicateField, offset: key)),
            KeyOrder::Descending => Result::Err(CodecError::at(kind: ErrorKind::NonCanonical, offset: key)),
        }
    }

    /// A map whose entries are skipped. Keys are items of any kind and must ascend in the
    /// bytes they are encoded as, as the keys of a record do.
    fn skip_map(mut self) -> CodecResult<()> {
        var frame = self.begin(5)?
        var previous: usize = 0
        var previous_end: usize = 0
        while frame.remaining() != 0 {
            let key = self.offset()
            self.structure.member(key)?
            frame.take(key)?
            self.skip_value()?
            let key_end = self.offset()
            self.check_key_order(frame.taken() == 1, previous, previous_end, key, key_end)?
            previous = key
            previous_end = key_end
            self.structure.member(key_end)?
            self.skip_value()?
        }
        self.end(frame)
    }

    fn begin(mut self, _ major: u8) -> CodecResult<Frame> {
        let offset = self.offset()
        self.structure.begin(offset)?
        let count = self.header(major)?
        Result::Ok(Frame::new(self.structure.wire_items(count, offset)?))
    }

    fn end(mut self, _ frame: own Frame) -> CodecResult<()> {
        let offset = self.offset()
        frame.complete(offset)?
        self.structure.end(offset)
    }
}

impl<const N: usize> Decoder for CborDecoder<N> {
    type Record = Frame
    type Sequence = Sequence

    fn offset(self) -> usize {
        self.input.offset()
    }

    fn read_bool(mut self) -> CodecResult<bool> {
        let offset = self.offset()
        self.structure.value(offset)?
        match self.byte()? {
            0xf4 => Result::Ok(false),
            0xf5 => Result::Ok(true),
            _ => Result::Err(CodecError::at(kind: ErrorKind::TypeMismatch, offset)),
        }
    }

    /// Fields of 64 bits or fewer accept only major types 0 and 1: a canonical bignum always
    /// exceeds them.
    fn read_unsigned(mut self, _ bits: u16) -> CodecResult<u64> {
        let offset = self.offset()
        self.structure.value(offset)?
        let value = self.header(0)?
        checked_unsigned(value, bits, offset)
    }

    fn read_signed(mut self, _ bits: u16) -> CodecResult<i64> {
        let offset = self.offset()
        self.structure.value(offset)?
        let tag = self.byte()?
        let major = tag >> 5
        if major > 1 {
            return Result::Err(CodecError::at(kind: ErrorKind::TypeMismatch, offset))
        }
        let argument = self.argument(tag & 31, offset)?
        if (argument as u256) > MAX_SIGNED {
            return Result::Err(CodecError::at(kind: ErrorKind::IntegerOutOfRange, offset))
        }
        let positive: i64 = argument.downcast_unchecked()
        let value = if major == 0 { positive } else { -1 - positive }
        checked_signed(value, bits, offset)
    }

    fn read_wide_unsigned(mut self, _ bits: u16) -> CodecResult<u256> {
        let offset = self.offset()
        self.structure.value(offset)?
        let (negative, magnitude) = self.integer()?
        if negative {
            return Result::Err(CodecError::at(kind: ErrorKind::IntegerOutOfRange, offset))
        }
        checked_wide_unsigned(magnitude, bits, offset)
    }

    fn read_wide_signed(mut self, _ bits: u16) -> CodecResult<i256> {
        let offset = self.offset()
        self.structure.value(offset)?
        let (negative, magnitude) = self.integer()?
        if magnitude > MAX_WIDE_SIGNED {
            return Result::Err(CodecError::at(kind: ErrorKind::IntegerOutOfRange, offset))
        }
        let positive: i256 = magnitude.downcast_unchecked()
        let value = if negative { -1 - positive } else { positive }
        checked_wide_signed(value, bits, offset)
    }

    fn read_bytes<const M: usize>(mut self) -> CodecResult<BoundedBuffer<M>> {
        let offset = self.offset()
        self.structure.value(offset)?
        let length = self.header(2)?
        if (length as u256) > (M as u256) {
            return Result::Err(CodecError::at(kind: ErrorKind::CapacityExceeded, offset))
        }
        var output = ByteWriter<M>::new()
        var index: u64 = 0
        while index < length {
            output.write(self.byte()?).map_err(CodecError::from_io)?
            index += 1
        }
        Result::Ok(output.finish())
    }

    fn read_text<const M: usize>(mut self) -> CodecResult<Text<M>> {
        let offset = self.offset()
        self.structure.value(offset)?
        let length = self.header(3)?
        if (length as u256) > (M as u256) {
            return Result::Err(CodecError::at(kind: ErrorKind::CapacityExceeded, offset))
        }
        var text = TextWriter<M>::new()
        var index: u64 = 0
        while index < length {
            let at = self.offset()
            let byte = self.byte()?
            text.write(byte, at)?
            index += 1
        }
        text.finish(self.offset())
    }

    fn read_fixed_bytes<const M: usize>(mut self) -> CodecResult<PackedBytes<M>> {
        let start = self.offset()
        match exact_bytes(self.read_bytes<M>()?) {
            Option::Some(bytes) => Result::Ok(bytes),
            Option::None => Result::Err(CodecError::at(kind: ErrorKind::InvalidLength, offset: start)),
        }
    }

    fn read_address(mut self) -> CodecResult<Address> {
        Result::Ok(address_from_bytes(self.read_fixed_bytes<20>()?))
    }

    fn read_some(mut self) -> CodecResult<bool> {
        if self.input.peek() == Option::Some(0xf6) {
            let offset = self.offset()
            self.structure.value(offset)?
            self.byte()?
            return Result::Ok(false)
        }
        Result::Ok(true)
    }

    fn read_variant<V: Schema>(mut self) -> CodecResult<usize> {
        let offset = self.offset()
        self.structure.value(offset)?
        let id = self.header(0)?
        var index: usize = 0
        while let Option::Some(variant) = V::variant(index) {
            if variant.id == id {
                return Result::Ok(index)
            }
            index += 1
        }
        Result::Err(CodecError::at(kind: ErrorKind::UnknownVariant, offset))
    }

    /// One data item of the profile: heads in their shortest form, definite lengths, major
    /// types 0 to 5, bignums within 256 bits, valid UTF-8 text, and false, true and null.
    /// Maps keep the profile's key order. Containers count toward `Limits.max_depth` and
    /// `Limits.max_items`. Anything else, such as a float or another tag, is `Unsupported`.
    fn skip_value(mut self) -> CodecResult<()> {
        let offset = self.offset()
        let first = match self.input.peek() {
            Option::Some(byte) => byte,
            Option::None => {
                return Result::Err(CodecError::at(kind: ErrorKind::UnexpectedEnd, offset))
            },
        }
        let major = first >> 5
        if major == 4 {
            var frame = self.begin(4)?
            while frame.remaining() != 0 {
                let at = self.offset()
                self.structure.member(at)?
                frame.take(at)?
                self.skip_value()?
            }
            return self.end(frame)
        }
        if major == 5 {
            return self.skip_map()
        }
        self.structure.value(offset)?
        if major < 2 {
            let _ = self.header(major)?
        } else if major == 2 {
            let length = self.header(2)?
            var index: u64 = 0
            while index < length {
                let _ = self.byte()?
                index += 1
            }
        } else if major == 3 {
            let length = self.header(3)?
            var utf8 = Utf8::new()
            var index: u64 = 0
            while index < length {
                let at = self.offset()
                utf8.push(self.byte()?, at)?
                index += 1
            }
            utf8.finish(self.offset())?
        } else if major == 6 {
            let _ = self.byte()?
            let number = self.argument(first & 31, offset)?
            if number != 2 && number != 3 {
                return Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset))
            }
            let _ = self.bignum(number, offset)?
        } else if first == 0xf4 || first == 0xf5 || first == 0xf6 {
            let _ = self.byte()?
        } else {
            // The rest of major type 7: a float, `undefined` or another simple value is well
            // formed but outside the profile, and 28 to 31 is not well formed at all.
            let kind = if first & 31 > 27 {
                ErrorKind::InvalidSyntax
            } else {
                ErrorKind::Unsupported
            }
            return Result::Err(CodecError::at(kind, offset))
        }
        Result::Ok(())
    }

    fn begin_record<R: Schema>(mut self) -> CodecResult<Frame> {
        self.begin(5)
    }

    fn next_field<R: Schema>(mut self, _ record: mut Frame) -> CodecResult<Option<FieldKey>> {
        loop {
            if record.remaining() == 0 {
                return Result::Ok(Option::None)
            }
            let offset = self.offset()
            let id = self.header(0)?
            var position: usize = 0
            while let Option::Some(field) = R::field(position) {
                if field.id == id {
                    // A repeated or out-of-order key names the field it repeats.
                    if let Result::Err(error) = record.key(id, offset) {
                        return Result::Err(error.in_field(field.name))
                    }
                    self.structure.member(offset)?
                    return Result::Ok(FieldKey::of<R>(position, offset))
                }
                position += 1
            }
            // An unknown ID still has to ascend.
            record.key(id, offset)?
            if !R::skips_unknown_fields() {
                return Result::Err(CodecError::at(kind: ErrorKind::UnknownField, offset))
            }
            self.structure.member(offset)?
            self.skip_value()?
        }
    }

    fn end_record(mut self, _ record: own Frame) -> CodecResult<()> {
        self.end(record)
    }

    fn begin_sequence(mut self, _ length: usize) -> CodecResult<Sequence> {
        let offset = self.offset()
        let frame = self.begin(4)?
        if frame.remaining() != length {
            return Result::Err(CodecError::at(kind: ErrorKind::InvalidLength, offset))
        }
        Result::Ok(Sequence::new(frame))
    }

    fn element(mut self, _ sequence: mut Sequence) -> CodecResult<()> {
        let offset = self.offset()
        self.structure.member(offset)?
        sequence.frame.take(offset)
    }

    fn end_sequence(mut self, _ sequence: own Sequence) -> CodecResult<()> {
        self.end(sequence.frame)
    }

    /// The array head gives the length, so an array longer than `capacity` is
    /// `CapacityExceeded` at the head, before any element is read. `Limits.max_items` is
    /// checked first.
    fn begin_list(mut self, _ capacity: usize) -> CodecResult<Sequence> {
        let offset = self.offset()
        let frame = self.begin(4)?
        if frame.remaining() > capacity {
            return Result::Err(CodecError::at(kind: ErrorKind::CapacityExceeded, offset))
        }
        Result::Ok(Sequence::new(frame))
    }

    fn next_element(mut self, _ sequence: mut Sequence) -> CodecResult<bool> {
        if sequence.frame.remaining() == 0 {
            return Result::Ok(false)
        }
        let offset = self.offset()
        self.structure.member(offset)?
        sequence.frame.take(offset)?
        Result::Ok(true)
    }

    /// A definite-length map. As for a list, one with more entries than `capacity` is
    /// `CapacityExceeded` at the head, after `Limits.max_items`.
    fn begin_map(mut self, _ capacity: usize) -> CodecResult<Sequence> {
        let offset = self.offset()
        let frame = self.begin(5)?
        if frame.remaining() > capacity {
            return Result::Err(CodecError::at(kind: ErrorKind::CapacityExceeded, offset))
        }
        Result::Ok(Sequence::new(frame))
    }

    fn next_key(mut self, _ map: mut Sequence) -> CodecResult<bool> {
        if map.frame.remaining() == 0 {
            return Result::Ok(false)
        }
        let offset = self.offset()
        self.structure.member(offset)?
        map.frame.take(offset)?
        map.key = offset
        Result::Ok(true)
    }

    /// The key has just been read, so its bytes are known: they must sort strictly after the
    /// previous key's, as RFC 8949 section 4.2.1 orders them. A repeat is `DuplicateField` and
    /// a key out of order `NonCanonical`, both at the key.
    fn map_value(mut self, _ map: mut Sequence) -> CodecResult<()> {
        let key_end = self.offset()
        self.check_key_order(map.frame.taken() == 1, map.previous, map.previous_end, map.key, key_end)?
        map.previous = map.key
        map.previous_end = key_end
        self.structure.member(key_end)
    }

    fn end_map(mut self, _ map: own Sequence) -> CodecResult<()> {
        self.end(map.frame)
    }
}
