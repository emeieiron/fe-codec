use fe_codec_core::{BoundedBuffer, CodecResult, Limits, Serializer}
use ingot::encoder::CborEncoder
use ingot::decoder::CborDecoder

pub fn encode<T, S: Serializer<T>, const N: usize>(_ value: T, _ limits: Limits) -> CodecResult<
    BoundedBuffer<N>,
> {
    var encoder = CborEncoder<N>::new(limits)
    S::encode(value, mut encoder)?
    encoder.finish()
}

pub fn decode<T, S: Serializer<T>, const N: usize>(
    _ input: own BoundedBuffer<N>,
    _ limits: Limits,
) -> CodecResult<T> {
    var decoder = CborDecoder<N>::new(input, limits)
    let value = S::decode(mut decoder)?
    decoder.finish()?
    Result::Ok(value)
}
