#[test]
fn cbor_rejects_unknown_ids_that_do_not_ascend() {
    let limits = Limits::standard()
    expect_error(
        cbor_lenient<7>([0xa3, 0x02, 0x01, 0x05, 0x02, 0x03, 0x00], limits),
        ErrorKind::NonCanonical,
        5,
    )
    expect_field(
        cbor_lenient<7>([0xa3, 0x03, 0x00, 0x02, 0x01, 0x05, 0x02], limits),
        ErrorKind::NonCanonical,
        3,
        "owner",
    )
    expect_error(
        cbor_lenient<9>(
            [0xa4, 0x02, 0x01, 0x03, 0x00, 0x03, 0x00, 0x05, 0x02],
            limits,
        ),
        ErrorKind::DuplicateField,
        5,
    )
    expect_field(
        cbor_lenient<7>([0xa3, 0x02, 0x01, 0x02, 0x03, 0x05, 0x02], limits),
        ErrorKind::DuplicateField,
        3,
        "owner",
    )
    expect_error(
        cbor_lenient<7>([0xa3, 0x00, 0x00, 0x02, 0x01, 0x05, 0x02], limits),
        ErrorKind::UnknownField,
        1,
    )
    // The unmarked record reports the same errors at the same offsets.
    expect_error(
        cbor_exact<7>([0xa3, 0x02, 0x01, 0x03, 0x00, 0x05, 0x02], limits),
        ErrorKind::UnknownField,
        3,
    )
    expect_error(
        cbor_exact<7>([0xa3, 0x02, 0x01, 0x05, 0x02, 0x03, 0x00], limits),
        ErrorKind::NonCanonical,
        5,
    )
    expect_error(
        cbor_exact<7>([0xa3, 0x00, 0x00, 0x02, 0x01, 0x05, 0x02], limits),
        ErrorKind::UnknownField,
        1,
    )
}

#[test]
fn cbor_rejects_malformed_unknown_values() {
    let limits = Limits::standard()
    expect_error(
        cbor_lenient<8>([0xa3, 0x02, 0x01, 0x03, 0x18, 0x01, 0x05, 0x02], limits),
        ErrorKind::NonCanonical,
        4,
    )
    expect_error(
        cbor_lenient<9>(
            [0xa3, 0x02, 0x01, 0x03, 0x19, 0x00, 0xff, 0x05, 0x02],
            limits,
        ),
        ErrorKind::NonCanonical,
        4,
    )
    expect_error(
        cbor_lenient<9>(
            [0xa3, 0x02, 0x01, 0x03, 0x9f, 0x00, 0xff, 0x05, 0x02],
            limits,
        ),
        ErrorKind::NonCanonical,
        4,
    )
    expect_error(
        cbor_lenient<10>(
            [0xa3, 0x02, 0x01, 0x03, 0x5f, 0x41, 0x00, 0xff, 0x05, 0x02],
            limits,
        ),
        ErrorKind::NonCanonical,
        4,
    )
    expect_error(
        cbor_lenient<8>([0xa3, 0x02, 0x01, 0x03, 0x7f, 0xff, 0x05, 0x02], limits),
        ErrorKind::NonCanonical,
        4,
    )
    expect_error(
        cbor_lenient<8>([0xa3, 0x02, 0x01, 0x03, 0xbf, 0xff, 0x05, 0x02], limits),
        ErrorKind::NonCanonical,
        4,
    )
    expect_error(
        cbor_lenient<7>([0xa3, 0x02, 0x01, 0x03, 0x1c, 0x05, 0x02], limits),
        ErrorKind::InvalidSyntax,
        4,
    )
    expect_error(
        cbor_lenient<7>([0xa3, 0x02, 0x01, 0x03, 0xfc, 0x05, 0x02], limits),
        ErrorKind::InvalidSyntax,
        4,
    )
    expect_error(
        cbor_lenient<7>([0xa3, 0x02, 0x01, 0x03, 0xff, 0x05, 0x02], limits),
        ErrorKind::InvalidSyntax,
        4,
    )
    expect_error(
        cbor_lenient<9>(
            [0xa3, 0x02, 0x01, 0x03, 0xf9, 0x3c, 0x00, 0x05, 0x02],
            limits,
        ),
        ErrorKind::Unsupported,
        4,
    )
    expect_error(
        cbor_lenient<15>(
            [
                0xa3,
                0x02,
                0x01,
                0x03,
                0xfb,
                0x3f,
                0xf0,
                0x00,
                0x00,
                0x00,
                0x00,
                0x00,
                0x00,
                0x05,
                0x02,
            ],
            limits,
        ),
        ErrorKind::Unsupported,
        4,
    )
    expect_error(
        cbor_lenient<7>([0xa3, 0x02, 0x01, 0x03, 0xf7, 0x05, 0x02], limits),
        ErrorKind::Unsupported,
        4,
    )
    expect_error(
        cbor_lenient<7>([0xa3, 0x02, 0x01, 0x03, 0xf0, 0x05, 0x02], limits),
        ErrorKind::Unsupported,
        4,
    )
    expect_error(
        cbor_lenient<8>([0xa3, 0x02, 0x01, 0x03, 0xf8, 0x20, 0x05, 0x02], limits),
        ErrorKind::Unsupported,
        4,
    )
    expect_error(
        cbor_lenient<8>([0xa3, 0x02, 0x01, 0x03, 0xc1, 0x00, 0x05, 0x02], limits),
        ErrorKind::Unsupported,
        4,
    )
    expect_error(
        cbor_lenient<9>(
            [0xa3, 0x02, 0x01, 0x03, 0xd8, 0x18, 0x40, 0x05, 0x02],
            limits,
        ),
        ErrorKind::Unsupported,
        4,
    )
    expect_error(
        cbor_lenient<17>(
            [
                0xa3,
                0x02,
                0x01,
                0x03,
                0xc2,
                0x49,
                0x00,
                0x01,
                0x00,
                0x00,
                0x00,
                0x00,
                0x00,
                0x00,
                0x00,
                0x05,
                0x02,
            ],
            limits,
        ),
        ErrorKind::NonCanonical,
        4,
    )
    expect_error(
        cbor_lenient<9>(
            [0xa3, 0x02, 0x01, 0x03, 0xc2, 0x41, 0x01, 0x05, 0x02],
            limits,
        ),
        ErrorKind::NonCanonical,
        4,
    )
    expect_error(
        cbor_lenient<16>(
            [
                0xa3,
                0x02,
                0x01,
                0x03,
                0xc3,
                0x48,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0x05,
                0x02,
            ],
            limits,
        ),
        ErrorKind::NonCanonical,
        4,
    )
    expect_error(
        cbor_lenient<42>(
            [
                0xa3,
                0x02,
                0x01,
                0x03,
                0xc2,
                0x58,
                0x21,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0x05,
                0x02,
            ],
            limits,
        ),
        ErrorKind::IntegerOutOfRange,
        4,
    )
    expect_error(
        cbor_lenient<8>([0xa3, 0x02, 0x01, 0x03, 0xc2, 0x01, 0x05, 0x02], limits),
        ErrorKind::TypeMismatch,
        5,
    )
    expect_error(
        cbor_lenient<11>(
            [0xa3, 0x02, 0x01, 0x03, 0xc2, 0x5f, 0x41, 0x01, 0xff, 0x05, 0x02],
            limits,
        ),
        ErrorKind::NonCanonical,
        5,
    )
    expect_error(
        cbor_lenient<9>(
            [0xa3, 0x02, 0x01, 0x03, 0x62, 0xc3, 0x28, 0x05, 0x02],
            limits,
        ),
        ErrorKind::InvalidUtf8,
        6,
    )
    expect_error(
        cbor_lenient<9>(
            [0xa3, 0x02, 0x01, 0x03, 0x62, 0xc0, 0x80, 0x05, 0x02],
            limits,
        ),
        ErrorKind::InvalidUtf8,
        5,
    )
    expect_error(
        cbor_lenient<10>(
            [0xa3, 0x02, 0x01, 0x03, 0x63, 0xed, 0xa0, 0x80, 0x05, 0x02],
            limits,
        ),
        ErrorKind::InvalidUtf8,
        6,
    )
    expect_error(
        cbor_lenient<6>([0xa3, 0x02, 0x01, 0x03, 0x61, 0xc3], limits),
        ErrorKind::InvalidUtf8,
        6,
    )
    expect_error(
        cbor_lenient<11>(
            [0xa3, 0x02, 0x01, 0x03, 0xa1, 0xf9, 0x00, 0x00, 0x00, 0x05, 0x02],
            limits,
        ),
        ErrorKind::Unsupported,
        5,
    )
    expect_error(
        cbor_lenient<6>([0xa3, 0x02, 0x01, 0x03, 0x82, 0x00], limits),
        ErrorKind::UnexpectedEnd,
        6,
    )
    expect_error(
        cbor_lenient<7>([0xa3, 0x02, 0x01, 0x03, 0x44, 0x01, 0x02], limits),
        ErrorKind::UnexpectedEnd,
        7,
    )
    expect_error(
        cbor_lenient<14>(
            [0xa3, 0x02, 0x01, 0x03, 0x5b, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x01],
            limits,
        ),
        ErrorKind::UnexpectedEnd,
        14,
    )
    // A value cut short at the end of the input.
    expect_error(
        cbor_lenient<6>([0xa3, 0x02, 0x01, 0x03, 0x82, 0x00], limits),
        ErrorKind::UnexpectedEnd,
        6,
    )
    expect_error(
        cbor_lenient<4>([0xa3, 0x02, 0x01, 0x03], limits),
        ErrorKind::UnexpectedEnd,
        4,
    )
    // Data after the record.
    expect_error(
        cbor_lenient<6>([0xa2, 0x02, 0x01, 0x05, 0x02, 0x00], limits),
        ErrorKind::TrailingData,
        5,
    )
    // A missing known field is still reported, naming the field.
    expect_field(
        cbor_lenient<5>([0xa2, 0x01, 0x00, 0x02, 0x01], limits),
        ErrorKind::MissingField,
        5,
        "balance",
    )
}

#[test]
fn cbor_keeps_key_order_inside_skipped_maps() {
    let limits = Limits::standard()
    expect_error(
        cbor_lenient<11>(
            [0xa3, 0x02, 0x01, 0x03, 0xa2, 0x02, 0x00, 0x01, 0x00, 0x05, 0x02],
            limits,
        ),
        ErrorKind::NonCanonical,
        7,
    )
    expect_error(
        cbor_lenient<11>(
            [0xa3, 0x02, 0x01, 0x03, 0xa2, 0x01, 0x00, 0x01, 0x00, 0x05, 0x02],
            limits,
        ),
        ErrorKind::DuplicateField,
        7,
    )
    expect_error(
        cbor_lenient<13>(
            [0xa3, 0x02, 0x01, 0x03, 0xa2, 0x61, 0x62, 0x00, 0x61, 0x61, 0x00, 0x05, 0x02],
            limits,
        ),
        ErrorKind::NonCanonical,
        8,
    )
    expect_error(
        cbor_lenient<12>(
            [0xa3, 0x02, 0x01, 0x03, 0xa2, 0x18, 0x18, 0x00, 0x17, 0x00, 0x05, 0x02],
            limits,
        ),
        ErrorKind::NonCanonical,
        8,
    )
    expect_error(
        cbor_lenient<13>(
            [0xa3, 0x02, 0x01, 0x03, 0x82, 0xa2, 0x02, 0x00, 0x01, 0x00, 0x00, 0x05, 0x02],
            limits,
        ),
        ErrorKind::NonCanonical,
        8,
    )
    expect_error(
        cbor_lenient<13>(
            [0xa3, 0x02, 0x01, 0x03, 0xa1, 0xa2, 0x02, 0x00, 0x01, 0x00, 0x00, 0x05, 0x02],
            limits,
        ),
        ErrorKind::NonCanonical,
        8,
    )
    expect_error(
        cbor_lenient<15>(
            [
                0xa3,
                0x02,
                0x01,
                0x03,
                0xa2,
                0xa1,
                0x02,
                0x00,
                0x00,
                0xa1,
                0x01,
                0x00,
                0x00,
                0x05,
                0x02,
            ],
            limits,
        ),
        ErrorKind::NonCanonical,
        9,
    )
    expect_error(
        cbor_lenient<15>(
            [
                0xa3,
                0x02,
                0x01,
                0x03,
                0xa2,
                0xa1,
                0x01,
                0x00,
                0x00,
                0xa1,
                0x01,
                0x00,
                0x00,
                0x05,
                0x02,
            ],
            limits,
        ),
        ErrorKind::DuplicateField,
        9,
    )
}

#[test]
fn cbor_limits_apply_inside_skipped_values() {
    let limits = Limits::standard()
    check_lenient(
        cbor_lenient<9>(
            [0xa3, 0x02, 0x01, 0x03, 0x81, 0x81, 0x00, 0x05, 0x02],
            Limits { max_depth: 3, max_items: 256 },
        ),
        1,
        2,
        false,
    )
    expect_error(
        cbor_lenient<10>(
            [0xa3, 0x02, 0x01, 0x03, 0x81, 0x81, 0x81, 0x00, 0x05, 0x02],
            Limits { max_depth: 3, max_items: 256 },
        ),
        ErrorKind::DepthLimit,
        6,
    )
    expect_error(
        cbor_lenient<11>(
            [0xa3, 0x02, 0x01, 0x03, 0x81, 0xa1, 0x01, 0x81, 0x00, 0x05, 0x02],
            Limits { max_depth: 3, max_items: 256 },
        ),
        ErrorKind::DepthLimit,
        7,
    )
    // With the standard limits, 31 nested arrays fit beside the record and the 32nd does not.
    check_lenient(
        cbor_lenient<38>(cbor_nested<38, 31>(), limits),
        1,
        2,
        false,
    )
    expect_error(
        cbor_lenient<39>(cbor_nested<39, 32>(), limits),
        ErrorKind::DepthLimit,
        35,
    )
    // Entries per container: the record, a skipped array and a skipped map.
    check_lenient(
        cbor_lenient<10>(
            [0xa3, 0x02, 0x01, 0x03, 0x83, 0x00, 0x00, 0x00, 0x05, 0x02],
            Limits { max_depth: 32, max_items: 3 },
        ),
        1,
        2,
        false,
    )
    expect_error(
        cbor_lenient<11>(
            [0xa3, 0x02, 0x01, 0x03, 0x84, 0x00, 0x00, 0x00, 0x00, 0x05, 0x02],
            Limits { max_depth: 32, max_items: 3 },
        ),
        ErrorKind::CollectionLimit,
        4,
    )
    expect_error(
        cbor_lenient<15>(
            [
                0xa3,
                0x02,
                0x01,
                0x03,
                0xa4,
                0x00,
                0x00,
                0x01,
                0x00,
                0x02,
                0x00,
                0x03,
                0x00,
                0x05,
                0x02,
            ],
            Limits { max_depth: 32, max_items: 3 },
        ),
        ErrorKind::CollectionLimit,
        4,
    )
    expect_error(
        cbor_lenient<9>(
            [0xa4, 0x02, 0x01, 0x03, 0x00, 0x04, 0x00, 0x05, 0x02],
            Limits { max_depth: 32, max_items: 3 },
        ),
        ErrorKind::CollectionLimit,
        0,
    )
    check_lenient(
        cbor_lenient<9>(
            [0xa4, 0x02, 0x01, 0x03, 0x00, 0x04, 0x00, 0x05, 0x02],
            Limits { max_depth: 32, max_items: 4 },
        ),
        1,
        2,
        false,
    )
}

#[test]
fn cbor_ledger_skips_only_in_the_marked_record() {
    let limits = Limits::standard()
    assert!(
        cbor_ledger<15>(
            [
                0xa2,
                0x01,
                0xa3,
                0x01,
                0x00,
                0x02,
                0x01,
                0x05,
                0x02,
                0x02,
                0xa2,
                0x02,
                0x01,
                0x05,
                0x02,
            ],
        )
            .is_ok(),
    )
    expect_field(
        cbor_ledger<15>(
            [
                0xa2,
                0x01,
                0xa2,
                0x02,
                0x01,
                0x05,
                0x02,
                0x02,
                0xa3,
                0x02,
                0x01,
                0x03,
                0x00,
                0x05,
                0x02,
            ],
        ),
        ErrorKind::UnknownField,
        11,
        "exact",
    )
    expect_error(
        cbor_ledger<15>(
            [
                0xa3,
                0x01,
                0xa2,
                0x02,
                0x01,
                0x05,
                0x02,
                0x02,
                0xa2,
                0x02,
                0x01,
                0x05,
                0x02,
                0x03,
                0x00,
            ],
        ),
        ErrorKind::UnknownField,
        13,
    )
}

#[test]
fn readers_skip_fields_added_by_later_versions() {
    let limits = Limits::standard()
    let labeled = AccountV2 {
        owner: 1,
        balance: 2,
        label: Option::Some(must(Text<8>::from_array([0x61]))),
    }
    let json = must(Json::new().encode<AccountV2, 40>(labeled))
    let reader = must(Json::new().decode<AccountReader, 40>(json))
    assert!(reader.owner == 1 && reader.balance == 2)
    let cbor = must(Cbor::new().encode<AccountV2, 40>(labeled))
    let reader = must(Cbor::new().decode<AccountReader, 40>(cbor))
    assert!(reader.owner == 1 && reader.balance == 2)
    // Without the attribute the same data is an error.
    expect_error(
        Json::new().decode<AccountV1, 40>(json),
        ErrorKind::UnknownField,
        23,
    )
    expect_error(
        Cbor::new().decode<AccountV1, 40>(cbor),
        ErrorKind::UnknownField,
        5,
    )
}

#[test]
fn compact_cannot_skip_and_ignores_the_attribute() {
    let limits = Limits::standard()
    let compact = Compact::new()
    let value = Lenient { owner: 1, balance: 2, label: Option::None }
    let bytes = must(compact.encode<Lenient, 32>(value))
    let decoded = must(compact.decode<Lenient, 32>(bytes))
    assert!(
        decoded.owner == 1 && decoded.balance == 2 && decoded.label.is_none(),
    )
    // A positional format has no markers to find a value's end by.
    var decoder = CompactDecoder<2>::new(BoundedBuffer<2>::from_array([1, 2]), Limits::standard())
    expect_error(decoder.skip_value(), ErrorKind::Unsupported, 0)
    assert!(
        Lenient::skips_unknown_fields() && !Exact::skips_unknown_fields(),
    )
    assert!(
        validate_schema<Lenient>() && validate_schema<AccountReader>(),
    )
}
