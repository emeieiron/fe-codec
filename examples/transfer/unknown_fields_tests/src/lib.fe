        json_lenient<30>("{\"owner\":1,\"x\":1e,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        17,
    )
    expect_error(
        json_lenient<31>("{\"owner\":1,\"x\":1e+,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        18,
    )
    expect_error(
        json_lenient<30>("{\"owner\":1,\"x\":.5,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        15,
    )
    expect_error(
        json_lenient<30>("{\"owner\":1,\"x\":+1,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        15,
    )
    expect_error(
        json_lenient<33>("{\"owner\":1,\"x\":1.5.2,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        18,
    )
    expect_error(
        json_lenient<30>("{\"owner\":1,\"x\":1x,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        16,
    )
    expect_error(
        json_lenient<32>("{\"owner\":1,\"x\":1e5e,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        18,
    )
    // Literals.
    expect_error(
        json_lenient<31>("{\"owner\":1,\"x\":tru,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        18,
    )
    expect_error(
        json_lenient<32>("{\"owner\":1,\"x\":True,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        15,
    )
    expect_error(
        json_lenient<33>("{\"owner\":1,\"x\":truex,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        19,
    )
    expect_error(
        json_lenient<19>("{\"owner\":1,\"x\":nul}", limits),
        ErrorKind::InvalidSyntax,
        18,
    )
    // Structure.
    expect_error(
        json_lenient<33>("{\"owner\":1,\"x\":[1,2},\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        19,
    )
    expect_error(
        json_lenient<35>("{\"owner\":1,\"x\":{\"a\":1],\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        21,
    )
    expect_error(
        json_lenient<33>("{\"owner\":1,\"x\":[1 2],\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        18,
    )
    expect_error(
        json_lenient<35>("{\"owner\":1,\"x\":{\"a\" 1},\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        20,
    )
    expect_error(
        json_lenient<33>("{\"owner\":1,\"x\":{1:2},\"balance\":2}", limits),
        ErrorKind::TypeMismatch,
        16,
    )
    expect_error(
        json_lenient<32>("{\"owner\":1,\"x\":[1,],\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        18,
    )
    expect_error(
        json_lenient<36>("{\"owner\":1,\"x\":{\"a\":1,},\"balance\":2}", limits),
        ErrorKind::TypeMismatch,
        22,
    )
    expect_error(
        json_lenient<29>("{\"owner\":1,\"x\":},\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        15,
    )
    expect_error(
        json_lenient<18>("{\"owner\":1,\"x\":[1,", limits),
        ErrorKind::UnexpectedEnd,
        18,
    )
    expect_error(
        json_lenient<20>("{\"owner\":1,\"x\":{\"a\":", limits),
        ErrorKind::UnexpectedEnd,
        20,
    )
    // What follows a skipped value is still checked.
    expect_field(
        json_lenient<19>("{\"owner\":1,\"x\":[1]}", limits),
        ErrorKind::MissingField,
        19,
        "balance",
    )
    expect_error(
        json_lenient<33>("{\"owner\":1,\"balance\":2,\"x\":[1]} 1", limits),
        ErrorKind::TrailingData,
        32,
    )
}

#[test]
fn json_limits_apply_inside_skipped_values() {
    let limits = Limits::standard()
    check_lenient(
        json_lenient<33>(
            "{\"owner\":1,\"x\":[[1]],\"balance\":2}",
            Limits { max_depth: 3, max_items: 256 },
        ),
        1,
        2,
        false,
    )
    expect_error(
        json_lenient<35>(
            "{\"owner\":1,\"x\":[[[1]]],\"balance\":2}",
            Limits { max_depth: 3, max_items: 256 },
        ),
        ErrorKind::DepthLimit,
        17,
    )
    expect_error(
        json_lenient<41>(
            "{\"owner\":1,\"x\":{\"a\":{\"b\":1}},\"balance\":2}",
            Limits { max_depth: 2, max_items: 256 },
        ),
        ErrorKind::DepthLimit,
        20,
    )
    // With the standard limits, 31 nested arrays fit beside the record and the 32nd does not.
    check_lenient(
        json_lenient<90>(nested_arrays<90, 31>(), limits),
        1,
        2,
        false,
    )
    expect_error(
        json_lenient<92>(nested_arrays<92, 32>(), limits),
        ErrorKind::DepthLimit,
        46,
    )
    // Entries per container, in the record itself and in skipped arrays and objects.
    expect_error(
        json_lenient<37>(
            "{\"owner\":1,\"x\":[1,2,3,4],\"balance\":2}",
            Limits { max_depth: 32, max_items: 3 },
        ),
        ErrorKind::CollectionLimit,
        22,
    )
    check_lenient(
        json_lenient<35>(
            "{\"owner\":1,\"x\":[1,2,3],\"balance\":2}",
            Limits { max_depth: 32, max_items: 3 },
        ),
        1,
        2,
        false,
    )
    expect_error(
        json_lenient<53>(
            "{\"owner\":1,\"x\":{\"a\":1,\"b\":2,\"c\":3,\"d\":4},\"balance\":2}",
            Limits { max_depth: 32, max_items: 3 },
        ),
        ErrorKind::CollectionLimit,
        34,
    )
    expect_error(
        json_lenient<35>(
            "{\"owner\":1,\"a\":1,\"b\":2,\"balance\":2}",
            Limits { max_depth: 32, max_items: 3 },
        ),
        ErrorKind::CollectionLimit,
        23,
    )
    check_lenient(
        json_lenient<35>(
            "{\"owner\":1,\"a\":1,\"b\":2,\"balance\":2}",
            Limits { max_depth: 32, max_items: 4 },
        ),
        1,
        2,
        false,
    )
}

#[test]
fn json_still_rejects_what_skipping_does_not_excuse() {
    let limits = Limits::standard()
    // A type without the attribute rejects the same input, where it always did.
    expect_error(
        json_exact<33>("{\"owner\":1,\"extra\":2,\"balance\":2}", limits),
        ErrorKind::UnknownField,
        11,
    )
    check_lenient(
        json_lenient<33>("{\"owner\":1,\"extra\":2,\"balance\":2}", limits),
        1,
        2,
        false,
    )
    expect_error(
        json_exact<62>(
            "{\"owner\":1,\"a_key_longer_than_thirty_one_bytes\":2,\"balance\":2}",
            limits,
        ),
        ErrorKind::UnknownField,
        11,
    )
    check_lenient(
        json_lenient<62>(
            "{\"owner\":1,\"a_key_longer_than_thirty_one_bytes\":2,\"balance\":2}",
            limits,
        ),
        1,
        2,
        false,
    )
    // Known fields are still checked for duplicates, types and presence.
    expect_field(
        json_lenient<39>("{\"owner\":1,\"x\":0,\"owner\":2,\"balance\":2}", limits),
        ErrorKind::DuplicateField,
        17,
        "owner",
    )
    expect_field(
        json_lenient<31>("{\"x\":1,\"owner\":\"a\",\"balance\":2}", limits),
        ErrorKind::TypeMismatch,
        15,
        "owner",
    )
    expect_field(
        json_lenient<17>("{\"x\":1,\"owner\":1}", limits),
        ErrorKind::MissingField,
        17,
        "balance",
    )
    // Only the marked record skips: the unmarked one beside it, and the unmarked parent, do not.
    assert!(
        json_ledger<73>(
            "{\"lenient\":{\"x\":1,\"owner\":1,\"balance\":2},\"exact\":{\"owner\":1,\"balance\":2}}",
        )
            .is_ok(),
    )
    expect_field(
        json_ledger<77>(
            "{\"lenient\":{\"owner\":1,\"balance\":2},\"exact\":{\"owner\":1,\"extra\":0,\"balance\":2}}",
        ),
        ErrorKind::UnknownField,
        54,
        "exact",
    )
    expect_error(
        json_ledger<77>(
            "{\"extra\":0,\"lenient\":{\"owner\":1,\"balance\":2},\"exact\":{\"owner\":1,\"balance\":2}}",
        ),
        ErrorKind::UnknownField,
        1,
    )
}

#[test]
fn cbor_skips_unknown_fields_of_every_value_kind() {
    let limits = Limits::standard()
    check_lenient(
        cbor_lenient<5>([0xa2, 0x02, 0x01, 0x05, 0x02], limits),
        1,
        2,
        false,
    )
    // Unknown IDs before, between and after the known ones.
    check_lenient(
        cbor_lenient<11>(
            [0xa5, 0x01, 0x00, 0x02, 0x01, 0x03, 0xf6, 0x05, 0x02, 0x09, 0xf5],
            limits,
        ),
        1,
        2,
        false,
    )
    // Integers of every head width, positive and negative, and the simple values.
    check_lenient(
        cbor_lenient<82>(
            [
                0xb4,
                0x01,
                0x00,
                0x02,
                0x01,
                0x03,
                0x17,
                0x04,
                0x18,
                0x18,
                0x05,
                0x02,
                0x06,
                0x18,
                0xff,
                0x07,
                0x19,
                0x01,
                0x00,
                0x09,
                0x19,
                0xff,
                0xff,
                0x0a,
                0x1a,
                0x00,
                0x01,
                0x00,
                0x00,
                0x0b,
                0x1a,
                0xff,
                0xff,
                0xff,
                0xff,
                0x0c,
                0x1b,
                0x00,
                0x00,
                0x00,
                0x01,
                0x00,
                0x00,
                0x00,
                0x00,
                0x0d,
                0x1b,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0xff,
                0x0e,
                0x20,
                0x0f,
