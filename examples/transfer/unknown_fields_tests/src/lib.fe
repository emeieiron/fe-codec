// A record marked #[codec_skip_unknown] reads data with fields it does not know; one without
// the attribute rejects them. The inputs are written out byte for byte, and each rejected case
// names the offset its error is reported at. These tests are their own ingot because `fe test` on the
// EVM backend deploys all the tests of an ingot as one contract, which has a size limit (see
// tools/README.md).

use fe_codec_cbor::Cbor
use fe_codec_core::{
    BoundedBuffer,
    CodecResult,
    Decoder,
    ErrorKind,
    Format,
    Limits,
    Schema,
    Text,
    validate_schema,
}
use fe_codec_json::Json
use codec_compact::{Compact, CompactDecoder}
use codec_transfer::models::{AccountReader, AccountV1, AccountV2, Exact, Ledger, Lenient}
use codec_transfer::testkit::{expect_error, expect_field, must}

/// The value every accepted input stands for: owner and balance, and the label "hi" if any.
fn check_lenient(_ result: own CodecResult<Lenient>, _ owner: u64, _ balance: u64, _ label: bool) {
    let value = must(result)
    assert!(value.owner == owner && value.balance == balance)
    assert!(value.label.is_some() == label)
    if label {
        assert!(
            value.label.unwrap().equals(must(Text<8>::from_array("hi"))),
        )
    }
}

fn json_lenient<const N: usize>(_ input: [u8; N], _ limits: Limits) -> CodecResult<Lenient> {
    Json::with_limits(limits).decode<Lenient, N>(BoundedBuffer<N>::from_array(input))
}

fn json_exact<const N: usize>(_ input: [u8; N], _ limits: Limits) -> CodecResult<Exact> {
    Json::with_limits(limits).decode<Exact, N>(BoundedBuffer<N>::from_array(input))
}

fn json_ledger<const N: usize>(_ input: [u8; N]) -> CodecResult<Ledger> {
    Json::new().decode<Ledger, N>(BoundedBuffer<N>::from_array(input))
}

fn cbor_lenient<const N: usize>(_ input: [u8; N], _ limits: Limits) -> CodecResult<Lenient> {
    Cbor::with_limits(limits).decode<Lenient, N>(BoundedBuffer<N>::from_array(input))
}

fn cbor_exact<const N: usize>(_ input: [u8; N], _ limits: Limits) -> CodecResult<Exact> {
    Cbor::with_limits(limits).decode<Exact, N>(BoundedBuffer<N>::from_array(input))
}

fn cbor_ledger<const N: usize>(_ input: [u8; N]) -> CodecResult<Ledger> {
    Cbor::new().decode<Ledger, N>(BoundedBuffer<N>::from_array(input))
}

/// `{"owner":1,"x":[[...]],"balance":2}` with `depth` nested empty arrays, as bytes.
fn nested_arrays<const N: usize, const DEPTH: usize>() -> [u8; N] {
    var bytes: [u8; N] = [0; N]
    let head: [u8; 15] = "{\"owner\":1,\"x\":"
    let tail: [u8; 13] = ",\"balance\":2}"
    var at: usize = 0
    while at < 15 {
        bytes[at] = head[at]
        at += 1
    }
    var level: usize = 0
    while level < DEPTH {
        bytes[15 + level] = b'['
        bytes[15 + DEPTH + level] = b']'
        level += 1
    }
    var index: usize = 0
    while index < 13 {
        bytes[15 + 2 * DEPTH + index] = tail[index]
        index += 1
    }
    bytes
}

/// `a3 02 01 03 81 .. 81 00 05 02`: a record with `DEPTH` nested arrays under an unknown ID.
fn cbor_nested<const N: usize, const DEPTH: usize>() -> [u8; N] {
    var bytes: [u8; N] = [0; N]
    let head: [u8; 4] = [0xa3, 0x02, 0x01, 0x03]
    var at: usize = 0
    while at < 4 {
        bytes[at] = head[at]
        at += 1
    }
    var level: usize = 0
    while level < DEPTH {
        bytes[4 + level] = 0x81
        level += 1
    }
    bytes[4 + DEPTH] = 0x00
    bytes[5 + DEPTH] = 0x05
    bytes[6 + DEPTH] = 0x02
    bytes
}

#[test]
fn json_skips_unknown_members_of_every_value_kind() {
    let limits = Limits::standard()
    check_lenient(
        json_lenient<23>("{\"owner\":1,\"balance\":2}", limits),
        1,
        2,
        false,
    )
    // Unknown members before, between and after the known ones.
    check_lenient(
        json_lenient<41>(
            "{\"x\":1,\"owner\":1,\"y\":2,\"balance\":2,\"z\":3}",
            limits,
        ),
        1,
        2,
        false,
    )
    check_lenient(
        json_lenient<59>(
            "{\"a\":1,\"b\":2,\"owner\":1,\"c\":3,\"d\":4,\"balance\":2,\"e\":5,\"f\":6}",
            limits,
        ),
        1,
        2,
        false,
    )
    // Numbers, with fractions and exponents, and the literals.
    check_lenient(
        json_lenient<153>(
            "{\"a\":0,\"b\":-0,\"c\":-12,\"d\":1.5,\"e\":-0.25,\"f\":2e3,\"g\":1E+3,\"h\":1.5e-7,\"i\":123456789012345678901234567890,\"j\":true,\"k\":false,\"l\":null,\"owner\":1,\"balance\":2}",
            limits,
        ),
        1,
        2,
        false,
    )
    // Strings, with every escape, a surrogate pair and raw UTF-8.
    check_lenient(
        json_lenient<93>(
            "{\"owner\":1,\"s\":\"\",\"t\":\"plain\",\"u\":\"q\\\"b\\\\s\\/\\b\\f\\n\\r\\t\\u00e9\\uD83D\\uDE00 é😀\",\"balance\":2}",
            limits,
        ),
        1,
        2,
        false,
    )
    // Arrays and objects, nested, with whitespace.
    check_lenient(
        json_lenient<82>(
            "{\"owner\":1,\"a\":[],\"b\":{},\"c\":[1,[2,[3]],{\"d\":{\"e\":[null,{\"f\":\"g\"}]}}],\"balance\":2}",
            limits,
        ),
        1,
        2,
        false,
    )
    check_lenient(
        json_lenient<76>(
            " { \"x\" : [ 1 , { \"y\" : [ ] } ] , \"owner\" : 1 , \"z\" : { } , \"balance\" : 2 } \n",
            limits,
        ),
        1,
        2,
        false,
    )
    // Names that only resemble known ones, and a known name inside an unknown value.
    check_lenient(
        json_lenient<66>(
            "{\"Owner\":9,\"owner\":1,\"owne\":9,\"owners\":9,\"label\":\"hi\",\"balance\":2}",
            limits,
        ),
        1,
        2,
        true,
    )
    check_lenient(
        json_lenient<58>(
            "{\"x\":{\"owner\":\"nope\",\"balance\":[1]},\"owner\":1,\"balance\":2}",
            limits,
        ),
        1,
        2,
        false,
    )
    // A name longer than any field name: plain, as surrogate pairs, and cut inside a character.
    check_lenient(
        json_lenient<72>(
            "{\"owner\":1,\"a_key_longer_than_thirty_one_bytes\":[1,{\"x\":2}],\"balance\":2}",
            limits,
        ),
        1,
        2,
        false,
    )
    check_lenient(
        json_lenient<127>(
            "{\"owner\":1,\"\\ud83d\\ude00\\ud83d\\ude00\\ud83d\\ude00\\ud83d\\ude00\\ud83d\\ude00\\ud83d\\ude00\\ud83d\\ude00\\ud83d\\ude00\":null,\"balance\":2}",
            limits,
        ),
        1,
        2,
        false,
    )
    check_lenient(
        json_lenient<65>(
            "{\"owner\":1,\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa😀\":null,\"balance\":2}",
            limits,
        ),
        1,
        2,
        false,
    )
    // Repeated unknown names are not detected: no state is kept for them.
    check_lenient(
        json_lenient<47>(
            "{\"x\":1,\"x\":{\"y\":1,\"y\":2},\"owner\":1,\"balance\":2}",
            limits,
        ),
        1,
        2,
        false,
    )
}

#[test]
fn json_rejects_malformed_unknown_values() {
    let limits = Limits::standard()
    // Strings.
    expect_error(
        json_lenient<33>("{\"owner\":1,\"s\":\"a\\q\",\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        18,
    )
    expect_error(
        json_lenient<36>("{\"owner\":1,\"s\":\"\\udc00\",\"balance\":2}", limits),
        ErrorKind::InvalidUtf8,
        16,
    )
    expect_error(
        json_lenient<37>("{\"owner\":1,\"s\":\"\\ud83dx\",\"balance\":2}", limits),
        ErrorKind::InvalidUtf8,
        22,
    )
    expect_error(
        json_lenient<33>("{\"owner\":1,\"s\":\"a\nb\",\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        17,
    )
    expect_error(
        json_lenient<19>("{\"owner\":1,\"s\":\"abc", limits),
        ErrorKind::UnexpectedEnd,
        19,
    )
    // Bytes that are not UTF-8 in a skipped string, and in a skipped name.
    expect_error(
        json_lenient<32>(
            [
                0x7b,
                0x22,
                0x6f,
                0x77,
                0x6e,
                0x65,
                0x72,
                0x22,
                0x3a,
                0x31,
                0x2c,
                0x22,
                0x73,
                0x22,
                0x3a,
                0x22,
                0xc3,
                0x28,
                0x22,
                0x2c,
                0x22,
                0x62,
                0x61,
                0x6c,
                0x61,
                0x6e,
                0x63,
                0x65,
                0x22,
                0x3a,
                0x32,
                0x7d,
            ],
            limits,
        ),
        ErrorKind::InvalidUtf8,
        17,
    )
    expect_error(
        json_lenient<32>(
            [
                0x7b,
                0x22,
                0x6f,
                0x77,
                0x6e,
                0x65,
                0x72,
                0x22,
                0x3a,
                0x31,
                0x2c,
                0x22,
                0x73,
                0x22,
                0x3a,
                0x22,
                0xc0,
                0x80,
                0x22,
                0x2c,
                0x22,
                0x62,
                0x61,
                0x6c,
                0x61,
                0x6e,
                0x63,
                0x65,
                0x22,
                0x3a,
                0x32,
                0x7d,
            ],
            limits,
        ),
        ErrorKind::InvalidUtf8,
        16,
    )
    expect_error(
        json_lenient<31>(
            [
                0x7b,
                0x22,
                0x6f,
                0x77,
                0x6e,
                0x65,
                0x72,
                0x22,
                0x3a,
                0x31,
                0x2c,
                0x22,
                0x73,
                0x22,
                0x3a,
                0x22,
                0xc3,
                0x22,
                0x2c,
                0x22,
                0x62,
                0x61,
                0x6c,
                0x61,
                0x6e,
                0x63,
                0x65,
                0x22,
                0x3a,
                0x32,
                0x7d,
            ],
            limits,
        ),
        ErrorKind::InvalidUtf8,
        17,
    )
    expect_error(
        json_lenient<60>(
            [
                0x7b,
                0x22,
                0x6f,
                0x77,
                0x6e,
                0x65,
                0x72,
                0x22,
                0x3a,
                0x31,
                0x2c,
                0x22,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0x61,
                0xff,
                0x22,
                0x3a,
                0x31,
                0x2c,
                0x22,
                0x62,
                0x61,
                0x6c,
                0x61,
                0x6e,
                0x63,
                0x65,
                0x22,
                0x3a,
                0x32,
                0x7d,
            ],
            limits,
        ),
        ErrorKind::InvalidUtf8,
        43,
    )
    // Numbers.
    expect_error(
        json_lenient<30>("{\"owner\":1,\"x\":01,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        16,
    )
    expect_error(
        json_lenient<30>("{\"owner\":1,\"x\":1.,\"balance\":2}", limits),
        ErrorKind::InvalidSyntax,
        17,
