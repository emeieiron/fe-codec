use core::MemBuffer
use fe_codec_core::{BoundedBuffer, CodecError}
use std::env::Args
use std::io::{Stdout, Stderr}

pub fn main() -> i32 uses (args: Args, out: mut Stdout, err: mut Stderr) {
    if args.count() == 1 {
        if codec_transfer::verify_formats() {
            println!("JSON and CBOR match")
            return 0
        }
        return 1
    }

    let cbor = args.count() == 3 && args.get(1) == "--cbor"
    if args.count() != 2 && !cbor {
        eprintln!("usage: codec_transfer_native [--cbor] JSON")
        return 2
    }
    let argument = args.get(if cbor { 2 } else { 1 })
    let json = match BoundedBuffer<256>::from_span(argument.span()) {
        Result::Ok(buffer) => buffer,
        Result::Err(error) => {
            return report(CodecError::from_io(error))
        },
    }
    let encoded = match codec_transfer::transcode_sample(json, cbor) {
        Result::Ok(buffer) => buffer,
        Result::Err(error) => {
            return report(error)
        },
    }
    var bytes = MemBuffer::new(encoded.len())
    if encoded.copy_to(mut bytes.slice(offset: 0, len: encoded.len())).is_err() {
        return 1
    }
    if !out.write_stdout(bytes.slice(offset: 0, len: bytes.len())) {
        return 1
    }
    if !cbor { println!("") }
    0
}

fn report(_ error: CodecError) -> i32 uses (err: mut Stderr) {
    if let Option::Some(field) = codec_transfer::sample_error_field(error) {
        let name = field.as_bytes()
        var display = MemBuffer::new(name.len())
        if name.copy_to(mut display.slice(offset: 0, len: name.len())).is_ok() {
            let name_text = core::abi::DynString::from_payload(
                source: display.slice(offset: 0, len: name.len()),
            )
            eprintln!("field ", name_text)
        }
    }
    eprintln!(
        "codec error ",
        error.kind.code(),
        " at byte ",
        error.offset,
    )
    1
}
