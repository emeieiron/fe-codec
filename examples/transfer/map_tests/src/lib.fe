/// The map holding `keys[i] -> values[i]`, inserted in the order given.
fn map_of<K: MapKey, V: Copy, const N: usize, const M: usize>(_ keys: [K; M], _ values: [V; M]) -> Map<K, V, N> {
    var map = Map<K, V, N>::new()
    var index: usize = 0
    while index < M {
        assert!(must(map.insert(keys[index], values[index])).is_none())
        index += 1
    }
    map
}

/// The entries of `map` in key order are exactly `keys` and `values`.
fn holds<K: MapKey, V: Copy + Eq, const N: usize, const M: usize>(_ map: Map<K, V, N>, _ keys: [K; M], _ values: [V; M]) -> bool {
    if map.len() != M {
        return false
    }
    var index: usize = 0
    while index < M {
        if !map.key_at(index).unwrap().same(keys[index]) || map.value_at(index).unwrap() != values[index] {
            return false
        }
        index += 1
    }
    true
}

/// `result` is an error of `kind` that names the field `name`.
fn expect_named<T, const M: usize>(_ result: own CodecResult<T>, _ kind: ErrorKind, _ name: [u8; M]) {
    match result {
        Result::Err(error) => {
            assert!(error.kind == kind)
            assert!(error.field().unwrap().as_bytes().equals(BoundedBuffer<M>::from_array(name)))
        },
        Result::Ok(_) => assert!(false),
    }
}

/// Encoding and decoding in `format` agree, and a second encoding is the first.
fn stable<T: Serialize + Deserialize, F: Format, const N: usize>(_ format: F, _ value: T) {
    let first = must(format.encode<T, N>(value))
    let back = must(format.decode<T, N>(first))
    assert!(must(format.encode<T, N>(back)).equals(first))
}

fn text8<const M: usize>(_ bytes: [u8; M]) -> Text<8> {
    must(Text<8>::from_array(bytes))
}

fn yo() -> Text<8> {
    text8("yo")
}

fn low_address() -> Address {
    Address::new(1)
}

fn address() -> Address {
    Address::new(0xd8da6bf26964af9d7eed9e03e53415d37aa96045)
}

fn bytes2(_ a: u8, _ b: u8) -> PackedBytes<2> {
    PackedBytes<2>::from_array([a, b])
}

fn member(_ id: u8, _ name: Text<8>) -> Member {
    Member { id, name }
}

fn treasury() -> Treasury {
    Treasury {
        balances: map_of([address(), low_address()], [5, 6]),
        labels: map_of([yo(), hi()], [2, 1]),
    }
}

fn check_treasury(_ value: Treasury) {
    assert!(holds(value.balances, [low_address(), address()], [6, 5]))
    assert!(value.labels.len() == 2)
    assert!(value.labels.get(hi()) == Option::Some(1) && value.labels.get(yo()) == Option::Some(2))
}

fn roster() -> Roster {
    Roster {
        members: map_of([2, 1], [member(2, yo()), member(1, hi())]),
        groups: map_of([300, 5], [must(List<u8, 2>::from_array([7])), must(List<u8, 2>::from_array([1, 2]))]),
        guests: Option::Some(map_of([9, 3], [1, 2])),
    }
}

fn check_roster(_ value: Roster) {
    assert!(value.members.len() == 2)
    let first = value.members.get(1).unwrap()
    let second = value.members.get(2).unwrap()
    assert!(first.id == 1 && first.name.equals(hi()) && second.id == 2 && second.name.equals(yo()))
    assert!(value.members.key_at(0) == Option::Some(1) && value.members.key_at(1) == Option::Some(2))
    assert!(value.groups.len() == 2)
    assert!(value.groups.get(5).unwrap() == must(List<u8, 2>::from_array([1, 2])))
    assert!(value.groups.get(300).unwrap() == must(List<u8, 2>::from_array([7])))
    assert!(holds(value.guests.unwrap(), [3, 9], [2, 1]))
}

fn bare_roster() -> Roster {
    Roster {
        members: Map<u8, Member, 3>::new(),
        groups: Map<u16, List<u8, 2>, 2>::new(),
        guests: Option::None,
    }
}

// Exact bytes for every key type. The entries are inserted out of order, and come out in key order.

fn map_u8() -> Map<u8, u8, 4> {
    map_of([200, 1, 17], [3, 1, 2])
}

#[test]
fn json_and_cbor_write_u8_keys_in_key_order() {
    assert!(encodes(Json::new(), map_u8(), MAP_U8_JSON))
    assert!(encodes(Cbor::new(), map_u8(), MAP_U8_CBOR))
    assert!(holds(map_u8(), [1, 17, 200], [1, 2, 3]))
    // The same entries inserted in key order give the same map.
    assert!(map_u8() == map_of([1, 17, 200], [1, 2, 3]))
}

#[test]
fn json_and_cbor_read_u8_keys() {
    assert!(holds(must(decodes<Map<u8, u8, 4>, Json, 22>(Json::new(), MAP_U8_JSON)), [1, 17, 200], [1, 2, 3]))
    assert!(holds(must(decodes<Map<u8, u8, 4>, Cbor, 8>(Cbor::new(), MAP_U8_CBOR)), [1, 17, 200], [1, 2, 3]))
    stable<Map<u8, u8, 4>, Json, 30>(Json::new(), map_u8())
    stable<Map<u8, u8, 4>, Cbor, 16>(Cbor::new(), map_u8())
}

fn map_u16() -> Map<u16, u8, 4> {
    map_of([65535, 256, 0], [1, 2, 3])
}

