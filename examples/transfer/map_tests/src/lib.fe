    assert!(holds(must(decodes<Map<Text<8>, u8, 5>, Cbor, 19>(Cbor::new(), MAP_TEXT_CBOR)), [text8(""), text8("a"), text8("bb"), text8([0xc3, 0xa9]), text8("ccc")], [3, 2, 1, 5, 4]))
    stable<Map<Text<8>, u8, 5>, Json, 42>(Json::new(), map_text())
    stable<Map<Text<8>, u8, 5>, Cbor, 27>(Cbor::new(), map_text())
}

