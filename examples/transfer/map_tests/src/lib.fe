    assert!(holds(must(decodes<Map<Address, u8, 2>, Json, 95>(Json::new(), MAP_ADDRESS_JSON)), [low_address(), address()], [2, 1]))
    assert!(holds(must(decodes<Map<Address, u8, 2>, Cbor, 45>(Cbor::new(), MAP_ADDRESS_CBOR)), [low_address(), address()], [2, 1]))
