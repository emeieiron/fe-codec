// Maps, `Map<K, V, N>`: up to N entries with unique keys, kept in the canonical order of the
// keys. JSON writes an object, CBOR a definite-length map whose keys ascend in the bytes they are
// encoded as (RFC 8949 section 4.2.1), so equal maps always give identical bytes. The exact bytes
// come from tests/vectors/reference.py, which shares no code with the Fe implementation, and
// which sorts keys by their CBOR encodings; the inputs that must fail are written out byte for
// byte, with the offset each error is reported at. The compact example format has no maps, and
// EIP-712 has no map type; both are checked here too. These tests are their own ingot because
// `fe test` on the EVM backend deploys all the tests of an ingot as one contract, which has a
// size limit (see tools/README.md).

use core::bytes::PackedBytes
use core::ops::Eq
use fe_codec_cbor::Cbor
use fe_codec_core::{BoundedBuffer, CodecResult, Decoder, Deserialize, Encoder, ErrorKind, Format, Limits, List, Map, MapKey, Serialize, Text}
use fe_codec_eip712::{Domain, Eip712}
use fe_codec_json::{Json, JsonDecoder, JsonEncoder}
use codec_compact::Compact
use codec_transfer::models::{Atlas, Treasury, Member, Roster, Shape, Status}
use codec_transfer::testkit::{decodes, encodes, expect_error, expect_field, hi, must}
use codec_transfer::typed::Registry
use std::evm::Address

