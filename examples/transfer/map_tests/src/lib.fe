    assert!(encodes(Json::new(), map_text(), MAP_TEXT_JSON))
    assert!(encodes(Cbor::new(), map_text(), MAP_TEXT_CBOR))
    assert!(holds(map_text(), [text8(""), text8("a"), text8("bb"), text8([0xc3, 0xa9]), text8("ccc")], [3, 2, 1, 5, 4]))
    // The same entries inserted in key order give the same map.
    assert!(map_text() == map_of([text8(""), text8("a"), text8("bb"), text8([0xc3, 0xa9]), text8("ccc")], [3, 2, 1, 5, 4]))
