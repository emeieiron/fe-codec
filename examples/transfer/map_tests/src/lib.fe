    assert!(map_u16() == map_of([0, 256, 65535], [3, 2, 1]))
}

#[test]
fn json_and_cbor_read_u16_keys() {
    assert!(holds(must(decodes<Map<u16, u8, 4>, Json, 25>(Json::new(), MAP_U16_JSON)), [0, 256, 65535], [3, 2, 1]))
    assert!(holds(must(decodes<Map<u16, u8, 4>, Cbor, 11>(Cbor::new(), MAP_U16_CBOR)), [0, 256, 65535], [3, 2, 1]))
    stable<Map<u16, u8, 4>, Json, 33>(Json::new(), map_u16())
    stable<Map<u16, u8, 4>, Cbor, 19>(Cbor::new(), map_u16())
}

