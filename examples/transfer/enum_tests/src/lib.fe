// Enums with payloads, in every format: a variant with none is written as in any other enum,
// and one with a payload is a wrapper of one entry, the variant and its payload. JSON writes an
// object `{"Point":5}` and CBOR a map `{1: 5}`. The exact bytes come from tests/vectors/reference.py,
// which shares no code with the Fe implementation; the inputs that must fail are written out byte
// for byte, with the offset each error is reported at. The compact example format and EIP-712 have
// no payload variants, and are checked here too. These tests are their own ingot because `fe test`
// on the EVM backend deploys all the tests of an ingot as one contract, which has a size limit (see
// tools/README.md).

use fe_codec_cbor::Cbor
use fe_codec_core::{
    BoundedBuffer,
    CodecError,
    CodecResult,
    Deserialize,
    Describe,
    Describer,
    ErrorKind,
    Format,
    Limits,
    List,
    Map,
    Schema,
    Serialize,
    Text,
}
use fe_codec_eip712::Eip712
use fe_codec_json::Json
use codec_compact::Compact
use codec_transfer::models::{Canvas, Event, Layout, Parts, Recipient, Shape, Status, Tolerant}
use codec_transfer::testkit::{expect_error, expect_field, must, text}
use codec_transfer::typed::Drawing

