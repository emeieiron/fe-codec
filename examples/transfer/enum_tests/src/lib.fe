// Values and what they must decode to.

/// The capacity every value is encoded into and every input is read from. Encoding and decoding in
/// one buffer size keeps each type's serializers to one copy in the test contract, which has a size
/// limit; the tests of a buffer too small to hold a value are the exception.
const CAPACITY: usize = 192

/// Whether `format` encodes `value` as exactly `expected`.
fn writes<T: Serialize, F: Format, const M: usize>(
    _ format: F,
    _ value: T,
    _ expected: [u8; M],
) -> bool {
    match format.encode<T, CAPACITY>(value) {
        Result::Ok(bytes) => bytes.equals(BoundedBuffer<M>::from_array(expected)),
        Result::Err(_) => false,
    }
}

/// Decodes `input` as a `T` in `format`.
fn reads<T: Deserialize, F: Format, const M: usize>(_ format: F, _ input: [u8; M]) -> CodecResult<
    T,
> {
    format.decode<T, CAPACITY>(BoundedBuffer<CAPACITY>::from_prefix(input).unwrap())
}

fn circle(_ radius: u64, _ label: Option<Text<8>>) -> Shape {
    Shape::Circle { radius, label }
}

fn same_label(_ first: Option<Text<8>>, _ second: Option<Text<8>>) -> bool {
    match (first, second) {
        (Option::Some(a), Option::Some(b)) => a.equals(b),
        (Option::None, Option::None) => true,
        _ => false,
    }
}

fn is_empty(_ shape: Shape) -> bool {
    match shape {
        Shape::Empty => true,
        _ => false,
    }
}

fn is_point(_ shape: Shape, _ expected: u64) -> bool {
    match shape {
        Shape::Point(value) => value == expected,
        _ => false,
    }
}

fn is_pair(_ shape: Shape, _ first: u64, _ second: Text<8>) -> bool {
    match shape {
        Shape::Pair(a, b) => a == first && b.equals(second),
        _ => false,
    }
}

fn is_circle(_ shape: Shape, _ radius: u64, _ label: Option<Text<8>>) -> bool {
    match shape {
        Shape::Circle { radius: r, label: l } => r == radius && same_label(l, label),
        _ => false,
    }
}

fn is_some_point(_ shape: Option<Shape>, _ expected: u64) -> bool {
    match shape {
        Option::Some(value) => is_point(value, expected),
        Option::None => false,
    }
}

fn named() -> Map<u8, Shape, 2> {
    var map = Map<u8, Shape, 2>::new()
    assert!(must(map.insert(9, Shape::Empty)).is_none())
    assert!(must(map.insert(3, Shape::Point(2))).is_none())
    map
}

fn canvas() -> Canvas {
    Canvas {
        main: Shape::Pair(1, text("a")),
        spare: Option::Some(Shape::Point(7)),
        ring: [Shape::Empty, Shape::Point(1)],
        layers: must(List<Shape, 2>::from_array([circle(1, Option::None)])),
        named: named(),
    }
}

fn check_canvas(_ value: Canvas) {
    assert!(is_pair(value.main, 1, text("a")))
    assert!(is_some_point(value.spare, 7))
    assert!(is_empty(value.ring[0]) && is_point(value.ring[1], 1))
    assert!(
        value.layers.len() == 1 && is_circle(value.layers.get(0).unwrap(), 1, Option::None),
    )
    assert!(value.named.len() == 2)
    assert!(
        is_point(value.named.get(3).unwrap(), 2) && is_empty(value.named.get(9).unwrap()),
    )
}

fn bare_canvas() -> Canvas {
    Canvas {
        main: Shape::Empty,
        spare: Option::None,
        ring: [circle(0, Option::Some(text("y"))), Shape::Empty],
        layers: List<Shape, 2>::new(),
        named: Map<u8, Shape, 2>::new(),
    }
}

fn check_bare_canvas(_ value: Canvas) {
    assert!(is_empty(value.main) && value.spare.is_none())
    assert!(
        is_circle(value.ring[0], 0, Option::Some(text("y"))) && is_empty(value.ring[1]),
    )
    assert!(value.layers.is_empty() && value.named.is_empty())
}

fn movement() -> Event {
    Event::Move { dx: 300, dy: -3, note: Option::Some(text("hi")) }
}

fn is_move(_ event: Event, _ dx: i16, _ dy: i16, _ note: Option<Text<8>>) -> bool {
    match event {
        Event::Move { dx: x, dy: y, note: n } => x == dx && y == dy && same_label(n, note),
        _ => false,
    }
}

fn is_draw(_ event: Event, _ check: bool) -> bool {
    match event {
        Event::Draw(shape) => if check {
            is_point(shape, 5)
        } else {
            is_empty(shape)
        },
        _ => false,
    }
}

fn is_pay(_ event: Event, _ amount: u64, _ tip: Option<u64>) -> bool {
    match event {
        Event::Pay { amount: a, tip: t } => a == amount && t == tip,
        _ => false,
    }
}

fn is_sent(_ status: Status) -> bool {
    match status {
        Status::Sent => true,
        _ => false,
    }
}

fn is_start(_ event: Event) -> bool {
    match event {
        Event::Start => true,
        _ => false,
    }
}

fn recipient(_ active: bool, _ label: Text<8>) -> Recipient {
    Recipient { active, label }
}

fn row() -> Layout {
    Layout::Row { cells: [recipient(true, text("a")), recipient(false, text("b"))], flags: [] }
}

fn is_row(_ layout: Layout) -> bool {
    match layout {
        Layout::Row { ref cells, ref flags } => {
            cells[0].active
                && cells[0].label.equals(text<1, 8>("a"))
                && !cells[1].active
                && cells[1].label.equals(text<1, 8>("b"))
        },
        _ => false,
    }
}

fn is_cell(_ layout: Layout) -> bool {
    match layout {
        Layout::Cell(ref value) => value.active && value.label.equals(text<1, 8>("c")),
        _ => false,
    }
}

fn mixed(_ first: Option<u8>, _ array: [u8; 2], _ pair: (bool, u8), _ list: List<u8, 2>) -> Parts {
    Parts::Mixed(first, array, pair, list)
}

fn bytes_list<const M: usize>(_ items: [u8; M]) -> List<u8, 2> {
    must(List<u8, 2>::from_array(items))
}

fn is_mixed(
    _ parts: Parts,
    _ first: Option<u8>,
    _ array: [u8; 2],
    _ pair: (bool, u8),
    _ list: List<u8, 2>,
) -> bool {
    match parts {
        Parts::Mixed(a, b, c, d) => a == first && b == array && c == pair && d == list,
        _ => false,
    }
}

fn is_maybe(_ parts: Parts, _ expected: Option<u8>) -> bool {
    match parts {
        Parts::Maybe(value) => value == expected,
        _ => false,
    }
}

fn is_pair_of_bytes(_ parts: Parts, _ expected: [u8; 2]) -> bool {
    match parts {
        Parts::Pair(value) => value == expected,
        _ => false,
    }
}

fn is_account(_ value: Tolerant, _ owner: u64, _ balance: u64) -> bool {
    match value {
        Tolerant::Account { owner: o, balance: b } => o == owner && b == balance,
        _ => false,
    }
}

fn is_plain(_ value: Tolerant, _ expected: u64) -> bool {
    match value {
        Tolerant::Plain(number) => number == expected,
        _ => false,
    }
}

fn is_ping(_ value: Tolerant) -> bool {
    match value {
        Tolerant::Ping {} => true,
        _ => false,
    }
}

fn is_gone(_ value: Tolerant) -> bool {
    match value {
        Tolerant::Gone => true,
        _ => false,
    }
}

/// Encoding and decoding in `format` agree, and a second encoding is the first.
fn stable<T: Serialize + Deserialize, F: Format>(_ format: F, _ value: T) {
    let first = must(format.encode<T, CAPACITY>(value))
    let back = must(format.decode<T, CAPACITY>(first))
    assert!(must(format.encode<T, CAPACITY>(back)).equals(first))
}

// A unit variant is written exactly as in an enum with no payloads, a variant with one as a
// wrapper of one entry. A tuple variant of one element holds the element itself.

#[test]
fn json_writes_each_kind_of_variant() {
    assert!(writes(Json::new(), Shape::Empty, SHAPE_EMPTY_JSON))
    assert!(writes(Json::new(), Shape::Point(5), SHAPE_POINT_JSON))
    assert!(
        writes(
            Json::new(),
            Shape::Point(18446744073709551615),
            SHAPE_POINT_MAX_JSON,
        ),
    )
    assert!(
        writes(Json::new(), Shape::Pair(1, text("a")), SHAPE_PAIR_JSON),
    )
    assert!(
        writes(
            Json::new(),
            circle(2, Option::Some(text("x"))),
            SHAPE_CIRCLE_JSON,
        ),
    )
    // An absent optional field is left out of the record.
    assert!(
        writes(
            Json::new(),
            circle(2, Option::None),
            SHAPE_CIRCLE_BARE_JSON,
        ),
    )
}

#[test]
fn cbor_writes_each_kind_of_variant() {
    assert!(writes(Cbor::new(), Shape::Empty, SHAPE_EMPTY_CBOR))
    assert!(writes(Cbor::new(), Shape::Point(5), SHAPE_POINT_CBOR))
    assert!(
        writes(
            Cbor::new(),
            Shape::Point(18446744073709551615),
            SHAPE_POINT_MAX_CBOR,
        ),
    )
    assert!(
        writes(Cbor::new(), Shape::Pair(1, text("a")), SHAPE_PAIR_CBOR),
    )
    assert!(
        writes(
            Cbor::new(),
            circle(2, Option::Some(text("x"))),
            SHAPE_CIRCLE_CBOR,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            circle(2, Option::None),
            SHAPE_CIRCLE_BARE_CBOR,
        ),
    )
}

#[test]
fn json_reads_each_kind_of_variant() {
    assert!(
        is_empty(must(reads<Shape, Json>(Json::new(), SHAPE_EMPTY_JSON))),
    )
    assert!(
        is_point(
            must(reads<Shape, Json>(Json::new(), SHAPE_POINT_JSON)),
            5,
        ),
    )
    assert!(
        is_point(
            must(reads<Shape, Json>(Json::new(), SHAPE_POINT_MAX_JSON)),
            18446744073709551615,
        ),
    )
    assert!(
        is_pair(
            must(reads<Shape, Json>(Json::new(), SHAPE_PAIR_JSON)),
            1,
            text("a"),
        ),
    )
    assert!(
        is_circle(
            must(reads<Shape, Json>(Json::new(), SHAPE_CIRCLE_JSON)),
            2,
            Option::Some(text("x")),
        ),
    )
    assert!(
        is_circle(
            must(reads<Shape, Json>(Json::new(), SHAPE_CIRCLE_BARE_JSON)),
            2,
            Option::None,
        ),
    )
    // An explicit null is an absent optional field.
    assert!(
        is_circle(
            must(
                reads<Shape, Json>(Json::new(), "{\"Circle\":{\"radius\":2,\"label\":null}}"),
            ),
            2,
            Option::None,
        ),
    )
}

#[test]
fn cbor_reads_each_kind_of_variant() {
    assert!(
        is_empty(must(reads<Shape, Cbor>(Cbor::new(), SHAPE_EMPTY_CBOR))),
    )
    assert!(
        is_point(
            must(reads<Shape, Cbor>(Cbor::new(), SHAPE_POINT_CBOR)),
            5,
        ),
    )
    assert!(
        is_point(
            must(reads<Shape, Cbor>(Cbor::new(), SHAPE_POINT_MAX_CBOR)),
            18446744073709551615,
        ),
    )
    assert!(
        is_pair(
            must(reads<Shape, Cbor>(Cbor::new(), SHAPE_PAIR_CBOR)),
            1,
            text("a"),
        ),
    )
    assert!(
        is_circle(
            must(reads<Shape, Cbor>(Cbor::new(), SHAPE_CIRCLE_CBOR)),
            2,
            Option::Some(text("x")),
        ),
    )
    assert!(
        is_circle(
            must(reads<Shape, Cbor>(Cbor::new(), SHAPE_CIRCLE_BARE_CBOR)),
            2,
            Option::None,
        ),
    )
    assert!(
        is_circle(
            must(
                reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x03, 0xa2, 0x01, 0x02, 0x02, 0xf6]),
            ),
            2,
            Option::None,
        ),
    )
}

#[test]
fn unit_variants_of_a_payload_enum_are_written_as_those_of_an_enum_without_payloads() {
    // `Status` has no payloads: a string in JSON, an unsigned integer in CBOR. So does `Shape::Empty`.
    assert!(writes(Json::new(), Status::Pending, "\"Pending\""))
    assert!(writes(Cbor::new(), Status::Sent, [0x01]))
    assert!(writes(Json::new(), Shape::Empty, "\"Empty\""))
    assert!(writes(Cbor::new(), Shape::Empty, [0x00]))
    assert!(
        is_gone(
            must(reads<Tolerant, Json>(Json::new(), TOLERANT_GONE_JSON)),
        ),
    )
    assert!(
        is_gone(
            must(reads<Tolerant, Cbor>(Cbor::new(), TOLERANT_GONE_CBOR)),
        ),
    )
    assert!(
        is_start(must(reads<Event, Json>(Json::new(), EVENT_START_JSON))),
    )
    assert!(writes(Cbor::new(), Event::Start, EVENT_START_CBOR))
}

// Whitespace is allowed anywhere JSON allows it, and nowhere CBOR has any.

#[test]
fn json_accepts_whitespace_around_a_wrapper() {
    assert!(
        is_point(
            must(
                reads<Shape, Json>(Json::new(), " \n{ \"Point\"\t:\r\n 5 }\n "),
            ),
            5,
        ),
    )
    assert!(
        is_pair(
            must(
                reads<Shape, Json>(Json::new(), "{ \"Pair\" : [ 1 , \"a\" ] }"),
            ),
            1,
            text("a"),
        ),
    )
    assert!(
        is_circle(
            must(
                reads<Shape, Json>(Json::new(), "{ \"Circle\" : { \"radius\" : 2 } }"),
            ),
            2,
            Option::None,
        ),
    )
    assert!(
        is_empty(must(reads<Shape, Json>(Json::new(), " \"Empty\" "))),
    )
}

// A payload enum inside another, in an option, an array, a list and a map.

#[test]
fn payload_enums_nest_in_options_arrays_lists_and_maps() {
    assert!(writes(Json::new(), canvas(), CANVAS_JSON))
    assert!(writes(Cbor::new(), canvas(), CANVAS_CBOR))
    check_canvas(must(reads<Canvas, Json>(Json::new(), CANVAS_JSON)))
    check_canvas(must(reads<Canvas, Cbor>(Cbor::new(), CANVAS_CBOR)))
    // An absent option is left out, and an empty list and map are written.
    assert!(writes(Json::new(), bare_canvas(), CANVAS_BARE_JSON))
    assert!(writes(Cbor::new(), bare_canvas(), CANVAS_BARE_CBOR))
    check_bare_canvas(must(reads<Canvas, Json>(Json::new(), CANVAS_BARE_JSON)))
    check_bare_canvas(must(reads<Canvas, Cbor>(Cbor::new(), CANVAS_BARE_CBOR)))
}

#[test]
fn a_variant_holds_a_payload_enum() {
    assert!(
        writes(
            Json::new(),
            Event::Draw(Shape::Point(5)),
            EVENT_DRAW_JSON,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            Event::Draw(Shape::Point(5)),
            EVENT_DRAW_CBOR,
        ),
    )
    assert!(
        writes(
            Json::new(),
            Event::Draw(Shape::Empty),
            EVENT_DRAW_EMPTY_JSON,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            Event::Draw(Shape::Empty),
            EVENT_DRAW_EMPTY_CBOR,
        ),
    )
    assert!(
        is_draw(
            must(reads<Event, Json>(Json::new(), EVENT_DRAW_JSON)),
            true,
        ),
    )
    assert!(
        is_draw(
            must(reads<Event, Cbor>(Cbor::new(), EVENT_DRAW_CBOR)),
            true,
        ),
    )
    assert!(
        is_draw(
            must(reads<Event, Json>(Json::new(), EVENT_DRAW_EMPTY_JSON)),
            false,
        ),
    )
    assert!(
        is_draw(
            must(reads<Event, Cbor>(Cbor::new(), EVENT_DRAW_EMPTY_CBOR)),
            false,
        ),
    )
}

// Variants and the fields of a record variant take codec_id and codec_with, as a struct's do.

#[test]
fn variant_ids_and_field_ids_order_the_wire_form() {
    // The variant `Move` is ID 3, and its fields come in the order of their IDs: dy, note, dx.
    assert!(writes(Json::new(), movement(), EVENT_MOVE_JSON))
    assert!(writes(Cbor::new(), movement(), EVENT_MOVE_CBOR))
    assert!(
        writes(
            Json::new(),
            Event::Move { dx: -1, dy: 0, note: Option::None },
            EVENT_MOVE_BARE_JSON,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            Event::Move { dx: -1, dy: 0, note: Option::None },
            EVENT_MOVE_BARE_CBOR,
        ),
    )
    assert!(
        is_move(
            must(reads<Event, Json>(Json::new(), EVENT_MOVE_JSON)),
            300,
            -3,
            Option::Some(text("hi")),
        ),
    )
    assert!(
        is_move(
            must(reads<Event, Cbor>(Cbor::new(), EVENT_MOVE_CBOR)),
            300,
            -3,
            Option::Some(text("hi")),
        ),
    )
    assert!(
        is_move(
            must(reads<Event, Json>(Json::new(), EVENT_MOVE_BARE_JSON)),
            -1,
            0,
            Option::None,
        ),
    )
    assert!(
        is_move(
            must(reads<Event, Cbor>(Cbor::new(), EVENT_MOVE_BARE_CBOR)),
            -1,
            0,
            Option::None,
        ),
    )
    // Fields are matched by name in JSON, so they may come in any order.
    assert!(
        is_move(
            must(
                reads<Event, Json>(
                    Json::new(),
                    "{\"Move\":{\"dx\":300,\"note\":\"hi\",\"dy\":-3}}",
                ),
            ),
            300,
            -3,
            Option::Some(text("hi")),
        ),
    )
    // CBOR wants them in ascending order.
    expect_error(
        reads<Event, Cbor>(Cbor::new(), [0xa1, 0x03, 0xa2, 0x09, 0x20, 0x02, 0x00]),
        ErrorKind::NonCanonical,
        5,
    )
}

#[test]
fn variant_ids_name_the_variant_in_cbor() {
    assert!(writes(Cbor::new(), Event::Start, [0x07]))
    assert!(is_start(must(reads<Event, Cbor>(Cbor::new(), [0x07]))))
    // The IDs 0, 1 and 2 belong to no variant: they are not declaration positions.
    expect_error(
        reads<Event, Cbor>(Cbor::new(), [0x00]),
        ErrorKind::UnknownVariant,
        0,
    )
    expect_error(
        reads<Event, Cbor>(Cbor::new(), [0xa1, 0x01, 0x00]),
        ErrorKind::UnknownVariant,
        1,
    )
    // The ID of a variant of the enum it holds does not select a variant of this one.
    expect_error(
        reads<Event, Cbor>(Cbor::new(), [0xa1, 0x18, 0x28, 0xa1, 0x18, 0x28, 0x05]),
        ErrorKind::UnknownVariant,
        4,
    )
}

#[test]
fn a_codec_writes_the_field_of_a_record_variant() {
    // `amount` and `tip` are hexadecimal text, as in a struct field with the codec.
    assert!(
        writes(
            Json::new(),
            Event::Pay { amount: 255, tip: Option::Some(0) },
            EVENT_PAY_JSON,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            Event::Pay { amount: 255, tip: Option::Some(0) },
            EVENT_PAY_CBOR,
        ),
    )
    assert!(
        writes(
            Json::new(),
            Event::Pay { amount: 1, tip: Option::None },
            EVENT_PAY_BARE_JSON,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            Event::Pay { amount: 1, tip: Option::None },
            EVENT_PAY_BARE_CBOR,
        ),
    )
    assert!(
        is_pay(
            must(reads<Event, Json>(Json::new(), EVENT_PAY_JSON)),
            255,
            Option::Some(0),
        ),
    )
    assert!(
        is_pay(
            must(reads<Event, Cbor>(Cbor::new(), EVENT_PAY_CBOR)),
            255,
            Option::Some(0),
        ),
    )
    assert!(
        is_pay(
            must(reads<Event, Json>(Json::new(), EVENT_PAY_BARE_JSON)),
            1,
            Option::None,
        ),
    )
    assert!(
        is_pay(
            must(reads<Event, Cbor>(Cbor::new(), EVENT_PAY_BARE_CBOR)),
            1,
            Option::None,
        ),
    )
    // The codec's own checks apply, and name the field.
    expect_field(
        reads<Event, Json>(Json::new(), "{\"Pay\":{\"amount\":\"FF\"}}"),
        ErrorKind::InvalidSyntax,
        17,
        "amount",
    )
    expect_field(
        reads<Event, Cbor>(Cbor::new(), [0xa1, 0x0c, 0xa1, 0x01, 0x62, 0x30, 0x31]),
        ErrorKind::InvalidSyntax,
        4,
        "amount",
    )
}

// Arrays in a record variant decode element by element when their elements are not `Copy`.

#[test]
fn record_variants_hold_arrays_of_records_and_empty_arrays() {
    assert!(writes(Json::new(), row(), LAYOUT_ROW_JSON))
    assert!(writes(Cbor::new(), row(), LAYOUT_ROW_CBOR))
    assert!(
        is_row(must(reads<Layout, Json>(Json::new(), LAYOUT_ROW_JSON))),
    )
    assert!(
        is_row(must(reads<Layout, Cbor>(Cbor::new(), LAYOUT_ROW_CBOR))),
    )
    assert!(
        writes(
            Json::new(),
            Layout::Cell(recipient(true, text("c"))),
            LAYOUT_CELL_JSON,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            Layout::Cell(recipient(true, text("c"))),
            LAYOUT_CELL_CBOR,
        ),
    )
    assert!(
        is_cell(must(reads<Layout, Json>(Json::new(), LAYOUT_CELL_JSON))),
    )
    assert!(
        is_cell(must(reads<Layout, Cbor>(Cbor::new(), LAYOUT_CELL_CBOR))),
    )
    // One element too many or too few, a repeated field, and an element of the wrong type.
    expect_field(
        reads<Layout, Json>(Json::new(), "{\"Row\":{\"cells\":[],\"flags\":[]}}"),
        ErrorKind::InvalidLength,
        17,
        "cells",
    )
    expect_field(
        reads<Layout, Cbor>(Cbor::new(), [0xa1, 0x00, 0xa2, 0x01, 0x80, 0x02, 0x80]),
        ErrorKind::InvalidLength,
        4,
        "cells",
    )
    expect_field(
        reads<Layout, Json>(Json::new(), "{\"Row\":{\"cells\":[1,2],\"flags\":[]}}"),
        ErrorKind::TypeMismatch,
        17,
        "cells",
    )
    expect_field(
        reads<Layout, Cbor>(
            Cbor::new(),
            [0xa1, 0x00, 0xa2, 0x01, 0x82, 0x01, 0x02, 0x02, 0x80],
        ),
        ErrorKind::TypeMismatch,
        5,
        "cells",
    )
    expect_field(
        reads<Layout, Json>(Json::new(), "{\"Row\":{\"flags\":[],\"flags\":[]}}"),
        ErrorKind::DuplicateField,
        19,
        "flags",
    )
    expect_field(
        reads<Layout, Cbor>(Cbor::new(), [0xa1, 0x00, 0xa2, 0x02, 0x80, 0x02, 0x80]),
        ErrorKind::DuplicateField,
        5,
        "flags",
    )
    expect_field(
        reads<Layout, Cbor>(Cbor::new(), [0xa1, 0x00, 0xa1, 0x02, 0x80]),
        ErrorKind::MissingField,
        5,
        "cells",
    )
    expect_field(
        reads<Layout, Json>(Json::new(), "{\"Row\":{\"flags\":[true]}}"),
        ErrorKind::InvalidLength,
        17,
        "flags",
    )
    // A missing field is reported where the record ends.
    expect_field(
        reads<Layout, Json>(Json::new(), "{\"Row\":{\"flags\":[]}}"),
        ErrorKind::MissingField,
        19,
        "cells",
    )
}

// Tuple variants: elements of every kind, in a sequence, or alone.

#[test]
fn tuple_variants_hold_elements_of_every_kind() {
    assert!(
        writes(
            Json::new(),
            mixed(Option::None, [1, 2], (true, 3), bytes_list([4])),
            PARTS_MIXED_JSON,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            mixed(Option::None, [1, 2], (true, 3), bytes_list([4])),
            PARTS_MIXED_CBOR,
        ),
    )
    assert!(
        writes(
            Json::new(),
            mixed(Option::Some(9), [0, 255], (false, 0), bytes_list([0; 0])),
            PARTS_MIXED_SOME_JSON,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            mixed(Option::Some(9), [0, 255], (false, 0), bytes_list([0; 0])),
            PARTS_MIXED_SOME_CBOR,
        ),
    )
    assert!(
        is_mixed(
            must(reads<Parts, Json>(Json::new(), PARTS_MIXED_JSON)),
            Option::None,
            [1, 2],
            (true, 3),
            bytes_list([4]),
        ),
    )
    assert!(
        is_mixed(
            must(reads<Parts, Cbor>(Cbor::new(), PARTS_MIXED_CBOR)),
            Option::None,
            [1, 2],
            (true, 3),
            bytes_list([4]),
        ),
    )
    assert!(
        is_mixed(
            must(reads<Parts, Json>(Json::new(), PARTS_MIXED_SOME_JSON)),
            Option::Some(9),
            [0, 255],
            (false, 0),
            bytes_list([0; 0]),
        ),
    )
    assert!(
        is_mixed(
            must(reads<Parts, Cbor>(Cbor::new(), PARTS_MIXED_SOME_CBOR)),
            Option::Some(9),
            [0, 255],
            (false, 0),
            bytes_list([0; 0]),
        ),
    )
    // Too many or too few elements.
    expect_error(
        reads<Parts, Json>(Json::new(), "{\"Mixed\":[null,[1,2],[true,3]]}"),
        ErrorKind::InvalidLength,
        29,
    )
    expect_error(
        reads<Parts, Cbor>(
            Cbor::new(),
            [0xa1, 0x00, 0x83, 0xf6, 0x82, 0x01, 0x02, 0x82, 0xf5, 0x03],
        ),
        ErrorKind::InvalidLength,
        2,
    )
    expect_error(
        reads<Parts, Json>(Json::new(), "{\"Mixed\":[null,[1,2],[true,3],[],0]}"),
        ErrorKind::InvalidLength,
        32,
    )
}

#[test]
fn a_variant_of_one_element_holds_the_element_itself() {
    // An option is its value or null, in a wrapper that is always there; an array is an array.
    assert!(
        writes(
            Json::new(),
            Parts::Maybe(Option::None),
            PARTS_MAYBE_NONE_JSON,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            Parts::Maybe(Option::None),
            PARTS_MAYBE_NONE_CBOR,
        ),
    )
    assert!(
        writes(
            Json::new(),
            Parts::Maybe(Option::Some(3)),
            PARTS_MAYBE_SOME_JSON,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            Parts::Maybe(Option::Some(3)),
            PARTS_MAYBE_SOME_CBOR,
        ),
    )
    assert!(writes(Json::new(), Parts::Pair([1, 2]), PARTS_PAIR_JSON))
    assert!(writes(Cbor::new(), Parts::Pair([1, 2]), PARTS_PAIR_CBOR))
    assert!(
        is_maybe(
            must(reads<Parts, Json>(Json::new(), PARTS_MAYBE_NONE_JSON)),
            Option::None,
        ),
    )
    assert!(
        is_maybe(
            must(reads<Parts, Cbor>(Cbor::new(), PARTS_MAYBE_NONE_CBOR)),
            Option::None,
        ),
    )
    assert!(
        is_maybe(
            must(reads<Parts, Json>(Json::new(), PARTS_MAYBE_SOME_JSON)),
            Option::Some(3),
        ),
    )
    assert!(
        is_maybe(
            must(reads<Parts, Cbor>(Cbor::new(), PARTS_MAYBE_SOME_CBOR)),
            Option::Some(3),
        ),
    )
    assert!(
        is_pair_of_bytes(
            must(reads<Parts, Json>(Json::new(), PARTS_PAIR_JSON)),
            [1, 2],
        ),
    )
    assert!(
        is_pair_of_bytes(
            must(reads<Parts, Cbor>(Cbor::new(), PARTS_PAIR_CBOR)),
            [1, 2],
        ),
    )
    // The payload is not left out: the wrapper holds exactly one entry.
    expect_error(
        reads<Parts, Json>(Json::new(), "{\"Maybe\":}"),
        ErrorKind::TypeMismatch,
        9,
    )
    expect_error(
        reads<Parts, Cbor>(Cbor::new(), [0xa1, 0x01]),
        ErrorKind::UnexpectedEnd,
        2,
    )
    expect_error(
        reads<Parts, Json>(Json::new(), "{\"Pair\":[1]}"),
        ErrorKind::InvalidLength,
        10,
    )
    expect_error(
        reads<Parts, Cbor>(Cbor::new(), [0xa1, 0x02, 0x81, 0x01]),
        ErrorKind::InvalidLength,
        2,
    )
}

// An enum marked #[codec_skip_unknown] skips fields its record variants do not list.

#[test]
fn skip_unknown_applies_to_the_record_variants_of_an_enum() {
    assert!(
        writes(
            Json::new(),
            Tolerant::Account { owner: 1, balance: 2 },
            TOLERANT_ACCOUNT_JSON,
        ),
    )
    assert!(
        writes(
            Cbor::new(),
            Tolerant::Account { owner: 1, balance: 2 },
            TOLERANT_ACCOUNT_CBOR,
        ),
    )
    assert!(writes(Json::new(), Tolerant::Ping {}, TOLERANT_PING_JSON))
    assert!(writes(Cbor::new(), Tolerant::Ping {}, TOLERANT_PING_CBOR))
    assert!(
        writes(Json::new(), Tolerant::Plain(9), TOLERANT_PLAIN_JSON),
    )
    assert!(
        writes(Cbor::new(), Tolerant::Plain(9), TOLERANT_PLAIN_CBOR),
    )
    assert!(
        is_account(
            must(reads<Tolerant, Json>(Json::new(), TOLERANT_ACCOUNT_JSON)),
            1,
            2,
        ),
    )
    assert!(
        is_account(
            must(reads<Tolerant, Cbor>(Cbor::new(), TOLERANT_ACCOUNT_CBOR)),
            1,
            2,
        ),
    )
    assert!(
        is_ping(
            must(reads<Tolerant, Json>(Json::new(), TOLERANT_PING_JSON)),
        ),
    )
    assert!(
        is_ping(
            must(reads<Tolerant, Cbor>(Cbor::new(), TOLERANT_PING_CBOR)),
        ),
    )
    assert!(
        is_plain(
            must(reads<Tolerant, Json>(Json::new(), TOLERANT_PLAIN_JSON)),
            9,
        ),
    )
    assert!(
        is_plain(
            must(reads<Tolerant, Cbor>(Cbor::new(), TOLERANT_PLAIN_CBOR)),
            9,
        ),
    )
    // Unknown fields are skipped, well formed values of any kind.
    assert!(
        is_account(
            must(
                reads<Tolerant, Json>(
                    Json::new(),
                    "{\"Account\":{\"owner\":1,\"x\":[1,{\"a\":null},\"s\"],\"balance\":2,\"z\":1.5e3}}",
                ),
            ),
            1,
            2,
        ),
    )
    assert!(
        is_account(
            must(
                reads<Tolerant, Cbor>(
                    Cbor::new(),
                    [0xa1, 0x01, 0xa3, 0x01, 0x01, 0x02, 0x02, 0x05, 0x82, 0x01, 0x61, 0x78],
                ),
            ),
            1,
            2,
        ),
    )
    assert!(
        is_ping(
            must(
                reads<Tolerant, Json>(Json::new(), "{\"Ping\":{\"x\":1}}"),
            ),
        ),
    )
    assert!(
        is_ping(
            must(
                reads<Tolerant, Cbor>(Cbor::new(), [0xa1, 0x02, 0xa1, 0x05, 0x01]),
            ),
        ),
    )
    // The skipped value still has to be well formed, and what the enum does not skip is an error.
    expect_error(
        reads<Tolerant, Json>(
            Json::new(),
            "{\"Account\":{\"owner\":1,\"x\":[1,],\"balance\":2}}",
        ),
        ErrorKind::InvalidSyntax,
        29,
    )
    expect_error(
        reads<Tolerant, Cbor>(Cbor::new(), [0xa1, 0x01, 0xa2, 0x01, 0x01, 0x05, 0x1f]),
        ErrorKind::NonCanonical,
        6,
    )
    expect_error(
        reads<Tolerant, Json>(Json::new(), "{\"Other\":{}}"),
        ErrorKind::UnknownVariant,
        1,
    )
    expect_error(
        reads<Tolerant, Cbor>(Cbor::new(), [0xa1, 0x09, 0xa0]),
        ErrorKind::UnknownVariant,
        1,
    )
    expect_field(
        reads<Tolerant, Json>(Json::new(), "{\"Account\":{\"owner\":1}}"),
        ErrorKind::MissingField,
        22,
        "balance",
    )
    // An enum without the attribute rejects them.
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Circle\":{\"radius\":1,\"x\":2}}"),
        ErrorKind::UnknownField,
        22,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x03, 0xa2, 0x01, 0x02, 0x05, 0x00]),
        ErrorKind::UnknownField,
        5,
    )
}

// The variant in the wrong form for its kind, with the wrong number of entries, or unknown.

#[test]
fn json_rejects_a_variant_written_the_wrong_way() {
    // A variant with no payload as a wrapper, and one with a payload bare: at the variant.
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Empty\":null}"),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), " {\"Empty\":{}}"),
        ErrorKind::TypeMismatch,
        1,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "\"Point\""),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "\"Pair\""),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "\"Circle\""),
        ErrorKind::TypeMismatch,
        0,
    )
    // Neither a string nor an object.
    expect_error(
        reads<Shape, Json>(Json::new(), "5"),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "null"),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "[\"Point\",5]"),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{1:1}"),
        ErrorKind::TypeMismatch,
        1,
    )
}

#[test]
fn json_rejects_a_wrapper_that_does_not_hold_one_entry() {
    // No entry: at the closing brace.
    expect_error(
        reads<Shape, Json>(Json::new(), "{}"),
        ErrorKind::InvalidLength,
        1,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{ }"),
        ErrorKind::InvalidLength,
        2,
    )
    // A second one: at the comma after the first.
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Point\":1,\"Pair\":[1,\"a\"]}"),
        ErrorKind::InvalidLength,
        10,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Point\":1 ,\"Point\":1}"),
        ErrorKind::InvalidLength,
        11,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Pair\":[1,\"a\"],}"),
        ErrorKind::InvalidLength,
        15,
    )
}

#[test]
fn json_rejects_an_unknown_variant() {
    expect_error(
        reads<Shape, Json>(Json::new(), "\"Square\""),
        ErrorKind::UnknownVariant,
        0,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Square\":1}"),
        ErrorKind::UnknownVariant,
        1,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "\"\""),
        ErrorKind::UnknownVariant,
        0,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"point\":1}"),
        ErrorKind::UnknownVariant,
        1,
    )
    // A name too long for any variant.
    expect_error(
        reads<Shape, Json>(Json::new(), "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\""),
        ErrorKind::UnknownVariant,
        0,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\":1}"),
        ErrorKind::UnknownVariant,
        1,
    )
    // The variants of a payload enum inside another are the inner enum's.
    expect_error(
        reads<Event, Json>(Json::new(), "{\"Draw\":{\"Move\":1}}"),
        ErrorKind::UnknownVariant,
        9,
    )
}

#[test]
fn json_rejects_malformed_wrappers_and_payloads() {
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Point\" 1}"),
        ErrorKind::InvalidSyntax,
        9,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Point\"}"),
        ErrorKind::InvalidSyntax,
        8,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Point\":5 x}"),
        ErrorKind::InvalidSyntax,
        11,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Point\":5}x"),
        ErrorKind::TrailingData,
        11,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "\"Empty\"x"),
        ErrorKind::TrailingData,
        7,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Point\":5"),
        ErrorKind::UnexpectedEnd,
        10,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Point\""),
        ErrorKind::UnexpectedEnd,
        8,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Poi"),
        ErrorKind::UnexpectedEnd,
        5,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{"),
        ErrorKind::UnexpectedEnd,
        1,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), ""),
        ErrorKind::UnexpectedEnd,
        0,
    )
    // The payload's own errors are reported where they are found.
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Point\":\"x\"}"),
        ErrorKind::TypeMismatch,
        9,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Point\":-1}"),
        ErrorKind::IntegerOutOfRange,
        9,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Point\":18446744073709551616}"),
        ErrorKind::IntegerOutOfRange,
        28,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Pair\":1}"),
        ErrorKind::TypeMismatch,
        8,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Pair\":[1]}"),
        ErrorKind::InvalidLength,
        10,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Pair\":[1,\"a\",2]}"),
        ErrorKind::InvalidLength,
        14,
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Circle\":[2]}"),
        ErrorKind::TypeMismatch,
        10,
    )
}

#[test]
fn json_names_the_field_of_a_record_variant() {
    expect_field(
        reads<Shape, Json>(Json::new(), "{\"Circle\":{}}"),
        ErrorKind::MissingField,
        12,
        "radius",
    )
    expect_field(
        reads<Shape, Json>(Json::new(), "{\"Circle\":{\"radius\":true}}"),
        ErrorKind::TypeMismatch,
        20,
        "radius",
    )
    expect_field(
        reads<Shape, Json>(Json::new(), "{\"Circle\":{\"radius\":1,\"label\":5}}"),
        ErrorKind::TypeMismatch,
        30,
        "label",
    )
    expect_field(
        reads<Shape, Json>(Json::new(), "{\"Circle\":{\"radius\":1,\"radius\":2}}"),
        ErrorKind::DuplicateField,
        22,
        "radius",
    )
    expect_error(
        reads<Shape, Json>(Json::new(), "{\"Circle\":{\"radius\":1,\"x\":2}}"),
        ErrorKind::UnknownField,
        22,
    )
    // Inside a field of a record, the outer field names an error in a payload with none of its own.
    expect_field(
        reads<Canvas, Json>(Json::new(), "{\"main\":{\"Point\":\"x\"}}"),
        ErrorKind::TypeMismatch,
        17,
        "main",
    )
    expect_field(
        reads<Canvas, Json>(
            Json::new(),
            "{\"main\":\"Empty\",\"ring\":[\"Point\",\"Empty\"]}",
        ),
        ErrorKind::TypeMismatch,
        24,
        "ring",
    )
    expect_field(
        reads<Canvas, Json>(
            Json::new(),
            "{\"main\":\"Empty\",\"named\":{\"1\":{\"Pair\":[1]}}}",
        ),
        ErrorKind::InvalidLength,
        39,
        "named",
    )
    // The innermost field is the one named.
    expect_field(
        reads<Canvas, Json>(Json::new(), "{\"main\":{\"Circle\":{\"radius\":\"x\"}}}"),
        ErrorKind::TypeMismatch,
        28,
        "radius",
    )
}

#[test]
fn cbor_rejects_a_variant_written_the_wrong_way() {
    // A variant with no payload as a wrapper, and one with a payload bare: at the variant.
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x00, 0xf6]),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0x01]),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0x02]),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0x03]),
        ErrorKind::TypeMismatch,
        0,
    )
    // Neither an unsigned integer nor a map.
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0x61, 0x61]),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0x81, 0x01]),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0x20]),
        ErrorKind::TypeMismatch,
        0,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xf6]),
        ErrorKind::TypeMismatch,
        0,
    )
    // A key that is not an unsigned integer is at the key.
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x61, 0x61, 0x05]),
        ErrorKind::TypeMismatch,
        1,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x20, 0x05]),
        ErrorKind::TypeMismatch,
        1,
    )
}

#[test]
fn cbor_rejects_a_wrapper_that_does_not_hold_one_entry() {
    // At the head of the map, which holds the length.
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa0]),
        ErrorKind::InvalidLength,
        0,
    )
    expect_error(
        reads<Shape, Cbor>(
            Cbor::new(),
            [0xa2, 0x01, 0x05, 0x02, 0x82, 0x01, 0x61, 0x61],
        ),
        ErrorKind::InvalidLength,
        0,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0x82, 0x01, 0x05]),
        ErrorKind::TypeMismatch,
        0,
    )
    // An indefinite-length map is not canonical.
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xbf, 0x01, 0x05, 0xff]),
        ErrorKind::NonCanonical,
        0,
    )
}

#[test]
fn cbor_rejects_an_unknown_variant() {
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0x09]),
        ErrorKind::UnknownVariant,
        0,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0x04]),
        ErrorKind::UnknownVariant,
        0,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x09, 0x00]),
        ErrorKind::UnknownVariant,
        1,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x04, 0x05]),
        ErrorKind::UnknownVariant,
        1,
    )
    expect_error(
        reads<Shape, Cbor>(
            Cbor::new(),
            [0x1b, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01],
        ),
        ErrorKind::UnknownVariant,
        0,
    )
    // The ID is in its shortest form.
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0x18, 0x01]),
        ErrorKind::NonCanonical,
        0,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x18, 0x01, 0x05]),
        ErrorKind::NonCanonical,
        1,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xb8, 0x01, 0x01, 0x05]),
        ErrorKind::NonCanonical,
        0,
    )
}

#[test]
fn cbor_rejects_malformed_wrappers_and_payloads() {
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x01, 0x05, 0x00]),
        ErrorKind::TrailingData,
        3,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0x00, 0x00]),
        ErrorKind::TrailingData,
        1,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x01]),
        ErrorKind::UnexpectedEnd,
        2,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1]),
        ErrorKind::UnexpectedEnd,
        1,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), []),
        ErrorKind::UnexpectedEnd,
        0,
    )
    // The payload's own errors are reported where they are found.
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x01, 0x61, 0x78]),
        ErrorKind::TypeMismatch,
        2,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x01, 0x20]),
        ErrorKind::TypeMismatch,
        2,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x02, 0x81, 0x01]),
        ErrorKind::InvalidLength,
        2,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x02, 0x83, 0x01, 0x61, 0x61, 0x02]),
        ErrorKind::InvalidLength,
        2,
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x03, 0x81, 0x02]),
        ErrorKind::TypeMismatch,
        2,
    )
}

#[test]
fn cbor_names_the_field_of_a_record_variant() {
    expect_field(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x03, 0xa0]),
        ErrorKind::MissingField,
        3,
        "radius",
    )
    expect_field(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x03, 0xa1, 0x01, 0xf5]),
        ErrorKind::TypeMismatch,
        4,
        "radius",
    )
    expect_field(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x03, 0xa2, 0x01, 0x02, 0x02, 0x05]),
        ErrorKind::TypeMismatch,
        6,
        "label",
    )
    expect_field(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x03, 0xa2, 0x01, 0x02, 0x01, 0x03]),
        ErrorKind::DuplicateField,
        5,
        "radius",
    )
    expect_field(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x03, 0xa2, 0x02, 0xf6, 0x01, 0x02]),
        ErrorKind::NonCanonical,
        5,
        "radius",
    )
    expect_error(
        reads<Shape, Cbor>(Cbor::new(), [0xa1, 0x03, 0xa2, 0x01, 0x02, 0x05, 0x00]),
        ErrorKind::UnknownField,
        5,
    )
    expect_field(
        reads<Canvas, Cbor>(Cbor::new(), [0xa1, 0x01, 0xa1, 0x01, 0x61, 0x78]),
        ErrorKind::TypeMismatch,
        4,
        "main",
    )
    expect_field(
        reads<Canvas, Cbor>(Cbor::new(), [0xa2, 0x01, 0x00, 0x03, 0x82, 0x01, 0x00]),
        ErrorKind::TypeMismatch,
        5,
        "ring",
    )
}

// The wrapper is a container, which counts toward the limits.

#[test]
fn a_wrapper_counts_toward_the_limits_in_json() {
    let shallow = Json::with_limits(Limits { max_depth: 1, max_items: 256 })
    assert!(
        is_point(must(reads<Shape, Json>(shallow, SHAPE_POINT_JSON)), 5),
    )
    assert!(
        is_empty(must(reads<Shape, Json>(shallow, SHAPE_EMPTY_JSON))),
    )
    expect_error(
        reads<Shape, Json>(shallow, SHAPE_PAIR_JSON),
        ErrorKind::DepthLimit,
        8,
    )
    expect_error(
        reads<Shape, Json>(shallow, SHAPE_CIRCLE_JSON),
        ErrorKind::DepthLimit,
        10,
    )
    expect_error(
        reads<Event, Json>(shallow, EVENT_DRAW_JSON),
        ErrorKind::DepthLimit,
        8,
    )
    let flat = Json::with_limits(Limits { max_depth: 0, max_items: 256 })
    expect_error(
        reads<Shape, Json>(flat, SHAPE_POINT_JSON),
        ErrorKind::DepthLimit,
        0,
    )
    assert!(is_empty(must(reads<Shape, Json>(flat, SHAPE_EMPTY_JSON))))
    let narrow = Json::with_limits(Limits { max_depth: 32, max_items: 1 })
    assert!(
        is_point(must(reads<Shape, Json>(narrow, SHAPE_POINT_JSON)), 5),
    )
    expect_error(
        reads<Shape, Json>(narrow, SHAPE_PAIR_JSON),
        ErrorKind::CollectionLimit,
        11,
    )
    let none = Json::with_limits(Limits { max_depth: 32, max_items: 0 })
    expect_error(
        reads<Shape, Json>(none, SHAPE_POINT_JSON),
        ErrorKind::CollectionLimit,
        1,
    )
}

#[test]
fn a_wrapper_counts_toward_the_limits_in_cbor() {
    let shallow = Cbor::with_limits(Limits { max_depth: 1, max_items: 256 })
    assert!(
        is_point(must(reads<Shape, Cbor>(shallow, SHAPE_POINT_CBOR)), 5),
    )
    assert!(
        is_empty(must(reads<Shape, Cbor>(shallow, SHAPE_EMPTY_CBOR))),
    )
    expect_error(
        reads<Shape, Cbor>(shallow, SHAPE_PAIR_CBOR),
        ErrorKind::DepthLimit,
        2,
    )
    expect_error(
        reads<Shape, Cbor>(shallow, SHAPE_CIRCLE_CBOR),
        ErrorKind::DepthLimit,
        2,
    )
    expect_error(
        reads<Event, Cbor>(shallow, EVENT_DRAW_CBOR),
        ErrorKind::DepthLimit,
        3,
    )
    let flat = Cbor::with_limits(Limits { max_depth: 0, max_items: 256 })
    expect_error(
        reads<Shape, Cbor>(flat, SHAPE_POINT_CBOR),
        ErrorKind::DepthLimit,
        0,
    )
    let narrow = Cbor::with_limits(Limits { max_depth: 32, max_items: 1 })
    assert!(
        is_point(must(reads<Shape, Cbor>(narrow, SHAPE_POINT_CBOR)), 5),
    )
    expect_error(
        reads<Shape, Cbor>(narrow, SHAPE_PAIR_CBOR),
        ErrorKind::CollectionLimit,
        2,
    )
    let none = Cbor::with_limits(Limits { max_depth: 32, max_items: 0 })
    expect_error(
        reads<Shape, Cbor>(none, SHAPE_POINT_CBOR),
        ErrorKind::CollectionLimit,
        0,
    )
}

#[test]
fn encoders_count_a_wrapper_toward_the_limits_and_the_buffer() {
    let shallow = Json::with_limits(Limits { max_depth: 1, max_items: 256 })
    assert!(writes(shallow, Shape::Point(5), SHAPE_POINT_JSON))
    expect_error(
        shallow.encode<Shape, CAPACITY>(Shape::Pair(1, text("a"))),
        ErrorKind::DepthLimit,
        8,
    )
    expect_error(
        Json::with_limits(Limits { max_depth: 32, max_items: 0 })
            .encode<Shape, CAPACITY>(Shape::Point(5)),
        ErrorKind::CollectionLimit,
        0,
    )
    let shallow = Cbor::with_limits(Limits { max_depth: 1, max_items: 256 })
    assert!(writes(shallow, Shape::Point(5), SHAPE_POINT_CBOR))
    expect_error(
        shallow.encode<Shape, CAPACITY>(Shape::Pair(1, text("a"))),
        ErrorKind::DepthLimit,
        2,
    )
    expect_error(
        Cbor::with_limits(Limits { max_depth: 32, max_items: 0 })
            .encode<Shape, CAPACITY>(Shape::Point(5)),
        ErrorKind::CollectionLimit,
        0,
    )
    // The buffer runs out at the first byte that does not fit.
    expect_error(
        Json::new().encode<Shape, 10>(Shape::Point(5)),
        ErrorKind::CapacityExceeded,
        10,
    )
    expect_error(
        Json::new().encode<Shape, 3>(Shape::Point(5)),
        ErrorKind::CapacityExceeded,
        3,
    )
    expect_error(
        Cbor::new().encode<Shape, 2>(Shape::Point(5)),
        ErrorKind::CapacityExceeded,
        2,
    )
    expect_error(
        Cbor::new().encode<Shape, 0>(Shape::Point(5)),
        ErrorKind::CapacityExceeded,
        0,
    )
}

#[test]
fn every_format_round_trips_payload_enums() {
    stable<Shape, Json>(Json::new(), Shape::Empty)
    stable<Shape, Json>(Json::new(), Shape::Point(18446744073709551615))
    stable<Shape, Json>(
        Json::new(),
        Shape::Pair(18446744073709551615, text("héllo")),
    )
    stable<Shape, Json>(Json::new(), circle(0, Option::Some(text("a\"b"))))
    stable<Shape, Cbor>(Cbor::new(), Shape::Empty)
    stable<Shape, Cbor>(Cbor::new(), Shape::Point(18446744073709551615))
    stable<Shape, Cbor>(
        Cbor::new(),
        Shape::Pair(18446744073709551615, text("héllo")),
    )
    stable<Shape, Cbor>(Cbor::new(), circle(0, Option::Some(text("a\"b"))))
    stable<Canvas, Json>(Json::new(), canvas())
    stable<Canvas, Cbor>(Cbor::new(), canvas())
    stable<Canvas, Json>(Json::new(), bare_canvas())
    stable<Canvas, Cbor>(Cbor::new(), bare_canvas())
    stable<Event, Json>(Json::new(), movement())
    stable<Event, Cbor>(Cbor::new(), movement())
    stable<Event, Json>(
        Json::new(),
        Event::Pay { amount: 18446744073709551615, tip: Option::Some(0) },
    )
    stable<Event, Cbor>(
        Cbor::new(),
        Event::Pay { amount: 18446744073709551615, tip: Option::Some(0) },
    )
    stable<Layout, Json>(Json::new(), row())
    stable<Layout, Cbor>(Cbor::new(), row())
    stable<Parts, Json>(
        Json::new(),
        mixed(Option::Some(1), [2, 3], (true, 4), bytes_list([5, 6])),
    )
    stable<Parts, Cbor>(
        Cbor::new(),
        mixed(Option::Some(1), [2, 3], (true, 4), bytes_list([5, 6])),
    )
}

// The compact example format has no payload variants: a positional format cannot tell from the
// bytes whether a payload follows a variant's ID, so it keeps the defaults, which fail with
// `Unsupported`. A variant with no payload still encodes, as in any enum.

#[test]
fn compact_keeps_the_defaults_for_payload_variants() {
    assert!(writes(Compact::new(), Shape::Empty, [0x00]))
    expect_error(
        Compact::new().encode<Shape, CAPACITY>(Shape::Point(5)),
        ErrorKind::Unsupported,
        0,
    )
    expect_error(
        Compact::new().encode<Shape, CAPACITY>(Shape::Pair(1, text("a"))),
        ErrorKind::Unsupported,
        0,
    )
    expect_error(
        Compact::new().encode<Shape, CAPACITY>(circle(1, Option::None)),
        ErrorKind::Unsupported,
        0,
    )
    expect_error(
        Compact::new().encode<Canvas, CAPACITY>(canvas()),
        ErrorKind::Unsupported,
        0,
    )
    expect_error(
        reads<Shape, Compact>(Compact::new(), [0x00]),
        ErrorKind::Unsupported,
        0,
    )
    expect_error(
        reads<Shape, Compact>(Compact::new(), [0x01, 0x05]),
        ErrorKind::Unsupported,
        0,
    )
    // An enum with no payloads reads and writes as before.
    assert!(writes(Compact::new(), Status::Sent, [0x01]))
    assert!(
        is_sent(must(reads<Status, Compact>(Compact::new(), [0x01]))),
    )
}

// EIP-712 has no union type, so a struct holding a payload enum has no type, and the generic path
// names the field.

#[test]
fn eip712_rejects_payload_enums() {
    let eip712 = Eip712::new()
    expect_field(
        eip712.type_hash<Drawing>(),
        ErrorKind::Unsupported,
        0,
        "shape",
    )
    expect_field(
        eip712.encode_type<Drawing, 64>(),
        ErrorKind::Unsupported,
        0,
        "shape",
    )
    expect_field(
        eip712.hash_struct(Drawing { shape: Shape::Empty }),
        ErrorKind::Unsupported,
        0,
        "shape",
    )
    expect_error(eip712.type_hash<Shape>(), ErrorKind::Unsupported, 0)
}

// What a description of a payload enum says, in order.

/// Records the calls a description makes: 1 for `bool`, the width of an integer, 100 + the arity for
/// `begin_tuple`, 200 + the arity for `end_tuple`, 300 for `begin_option`, 400 for `end_option`,
/// 500 + the capacity for `text`, 600 + the capacity for `begin_list`, 700 + the length for
/// `begin_sequence`, 800 + the length for `end_sequence`, 900 + the capacity for `end_list`,
/// 1000 for `begin_union`, 1100 + the index for `union_variant`, 1200 for `end_union`, 1300 for
/// `begin_record`, 1400 + the position for `field` and 1500 for `end_record`.
struct Trace { events: [usize; 64], len: usize }

impl Trace {
    fn new() -> Self {
        Self { events: [0; 64], len: 0 }
    }

    fn push(mut self, _ event: usize) -> CodecResult<()> {
        self.events[self.len] = event
        self.len += 1
        Result::Ok(())
    }

    fn is<const M: usize>(self, _ expected: [usize; M]) -> bool {
        if self.len != M {
            return false
        }
        var index: usize = 0
        while index < M {
            if self.events[index] != expected[index] {
                return false
            }
            index += 1
        }
        true
    }
}

impl Describer for Trace {
    fn bool(mut self) -> CodecResult<()> {
        self.push(1)
    }

    fn unsigned(mut self, _ bits: u16) -> CodecResult<()> {
        self.push(bits as usize)
    }

    fn signed(mut self, _ bits: u16) -> CodecResult<()> {
        self.push(bits as usize)
    }

    fn text(mut self, _ capacity: usize) -> CodecResult<()> {
        self.push(500 + capacity)
    }

    fn bytes(mut self, _ capacity: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn fixed_bytes(mut self, _ length: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn address(mut self) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn begin_option(mut self) -> CodecResult<()> {
        self.push(300)
    }

    fn end_option(mut self) -> CodecResult<()> {
        self.push(400)
    }

    fn begin_sequence(mut self, _ length: usize) -> CodecResult<()> {
        self.push(700 + length)
    }

    fn end_sequence(mut self, _ length: usize) -> CodecResult<()> {
        self.push(800 + length)
    }

    fn begin_list(mut self, _ capacity: usize) -> CodecResult<()> {
        self.push(600 + capacity)
    }

    fn end_list(mut self, _ capacity: usize) -> CodecResult<()> {
        self.push(900 + capacity)
    }

    fn begin_tuple(mut self, _ length: usize) -> CodecResult<()> {
        self.push(100 + length)
    }

    fn end_tuple(mut self, _ length: usize) -> CodecResult<()> {
        self.push(200 + length)
    }

    fn enumeration<V: Schema>(mut self) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn begin_union<V: Schema>(mut self) -> CodecResult<()> {
        self.push(1000)
    }

    fn union_variant<V: Schema>(mut self, _ index: usize) -> CodecResult<()> {
        self.push(1100 + index)
    }

    fn end_union<V: Schema>(mut self) -> CodecResult<()> {
        self.push(1200)
    }

    fn begin_record<R: Schema>(mut self) -> CodecResult<()> {
        self.push(1300)
    }

    fn field<R: Schema>(mut self, _ position: usize) -> CodecResult<()> {
        self.push(1400 + position)
    }

    fn end_record<R: Schema>(mut self) -> CodecResult<()> {
        self.push(1500)
    }
}

#[test]
fn a_payload_enum_describes_each_variants_payload_between_union_calls() {
    // Nothing for `Empty`, the value for a variant of one element, a tuple for several, and a record.
    var shape = Trace::new()
    assert!(<Shape as Describe>::describe(mut shape).is_ok())
    assert!(
        shape
            .is(
                [
                    1000,
                    1100,
                    1101,
                    64,
                    1102,
                    102,
                    64,
                    508,
                    202,
                    1103,
                    1300,
                    1400,
                    64,
                    1401,
                    300,
                    508,
                    400,
                    1500,
                    1200,
                ],
            ),
    )
    // Elements of every kind.
    var parts = Trace::new()
    assert!(<Parts as Describe>::describe(mut parts).is_ok())
    assert!(
        parts
            .is(
                [
                    1000,
                    1100,
                    104,
                    300,
                    8,
                    400,
                    702,
                    8,
                    802,
                    102,
                    1,
                    8,
                    202,
                    602,
                    8,
                    902,
                    204,
                    1101,
                    300,
                    8,
                    400,
                    1102,
                    702,
                    8,
                    802,
                    1200,
                ],
            ),
    )
    // A codec describes itself in place of the field's type, and a variant holds a union.
    var event = Trace::new()
    assert!(<Event as Describe>::describe(mut event).is_ok())
    assert!(
        event
            .is(
                [
                    1000,
                    1100,
                    1101,
                    1300,
                    1400,
                    16,
                    1401,
                    300,
                    508,
                    400,
                    1402,
                    16,
                    1500,
