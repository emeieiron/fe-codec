use core::bytes::PackedBytes
use fe_codec_core::{BoundedBuffer, List, Map, MapKey, Text}
use std::evm::Address
use ingot::codecs::{HexAmount, HexWord, RecipientPair}
use ingot::custom::Celsius

#[serializable]
pub struct Recipient { pub active: bool, pub label: Text<8> }

#[serializable]
pub enum Status {
    Pending,
    Sent,
}

#[serializable]
pub struct Transfer {
    pub recipient: Recipient,
    pub amount: u64,
    pub delta: i64,
    pub status: Status,
    pub hops: [u8; 2],
    pub flags: [bool; 0],
    pub nonce: Option<u16>,
}

#[serializable]
pub struct Batch { pub transfers: [Transfer; 1] }

#[serializable]
pub struct Sample { pub value: u8, pub note: Option<Text<8>> }

#[serializable]
pub enum StableStatus {
    #[codec_id = 62]
    Ready,
    #[codec_id = 0]
    Waiting,
}

#[serializable]
pub struct StableTransfer {
    #[codec_id = 9]
    pub amount: u8,
    #[codec_id = 2]
    pub status: StableStatus,
}

/// Every integer wider than 64 bits.
#[serializable]
pub struct Wide { pub big: u256, pub signed: i256, pub mid: u128, pub small: i128 }

/// Byte strings: an exact-length hash, a bounded memo and an EVM address.
#[serializable]
pub struct Wallet {
    pub owner: Address,
    pub hash: PackedBytes<4>,
    pub memo: BoundedBuffer<8>,
    pub tag: Option<PackedBytes<2>>,
}

/// A generic record. Decoding the array makes `T` need `Copy`.
#[serializable]
pub struct Page<T, const N: usize> { pub items: [T; N], pub next: Option<u64> }

/// Optional values inside a sequence.
#[serializable]
pub struct Slots { pub values: [Option<u8>; 3] }

/// Tuples are fixed-length sequences: as fields, nested, in an array and inside an `Option`.
#[serializable]
pub struct Waypoint {
    pub at: (u8, Text<8>),
    pub bounds: ((i16, i16), (i16, i16)),
    pub legs: [(u8, bool); 2],
    pub next: Option<(u16, u64)>,
    pub tag: (u8,),
}

/// A list holds 0 to `N` elements: an array on the wire, whose length the value decides.
#[serializable]
pub struct Tally { pub counts: List<u16, 4> }

/// List elements are `Copy`, as records here must declare.
#[serializable]
pub struct Member { pub id: u8, pub name: Text<8> }
impl Copy for Member {}

/// A list of records, and an optional list.
#[serializable]
pub struct Crew { pub members: List<Member, 3>, pub guests: Option<List<u8, 2>> }

/// Lists of tuples, of lists and of optional values, and an array of lists.
#[serializable]
pub struct Routes {
    pub legs: List<(u8, bool), 3>,
    pub grid: List<List<u8, 2>, 2>,
    pub slots: List<Option<u8>, 3>,
    pub fixed: [List<u8, 2>; 2],
}

/// A generic record with a list: decoding the list makes `T` need `Copy`.
#[serializable]
pub struct Bag<T, const N: usize> { pub items: List<T, N> }

/// A map holds 0 to `N` entries with unique keys, in the keys' canonical order: an object in
/// JSON and a map in CBOR.
#[serializable]
pub struct Treasury { pub balances: Map<Address, u64, 3>, pub labels: Map<Text<8>, u8, 3> }

/// Maps of records and of lists, and an optional map.
#[serializable]
pub struct Roster {
    pub members: Map<u8, Member, 3>,
    pub groups: Map<u16, List<u8, 2>, 2>,
    pub guests: Option<Map<u8, u8, 2>>,
}

/// A generic record with a map: decoding the map makes `V` need `Copy`, and the key must be a
/// `MapKey`.
#[serializable]
pub struct Atlas<K: MapKey, V, const N: usize> { pub entries: Map<K, V, N> }

/// A field whose type has a handwritten serializer in another module.
#[serializable]
pub struct Reading { pub at: u64, pub temperature: Celsius }

/// A record with IDs 1 and 3, matching RFC 8949's map example `{1: 2, 3: 4}`.
#[serializable]
pub struct Pairs {
    #[codec_id = 1]
    pub first: u8,
    #[codec_id = 3]
    pub second: u8,
}

/// Three revisions of one record, for schema evolution.
#[serializable]
pub struct AccountV1 {
    #[codec_id = 1]
    pub owner: u64,
    #[codec_id = 2]
    pub balance: u64,
}

/// Version 2 appends an optional field with a new ID.
#[serializable]
pub struct AccountV2 {
    #[codec_id = 1]
    pub owner: u64,
    #[codec_id = 2]
    pub balance: u64,
    #[codec_id = 3]
    pub label: Option<Text<8>>,
}

/// Renames both fields but keeps their IDs.
#[serializable]
pub struct AccountRenamed {
    #[codec_id = 1]
    pub holder: u64,
    #[codec_id = 2]
    pub funds: u64,
}

/// Fields written by a codec rather than their types' own serializers: a scalar as hex text,
/// the same codec on an optional field, and an array handed to the codec whole.
#[serializable]
pub struct Payment {
    pub id: u8,
    #[codec_with = HexAmount]
    pub amount: u64,
    #[codec_with = HexAmount]
    pub tip: Option<u64>,
    #[codec_with = HexWord]
    pub hash: [u8; 4],
}

/// A codec that changes a record's shape, on a plain and an optional field.
#[serializable]
pub struct Booking {
    #[codec_with = RecipientPair]
    pub guest: Recipient,
    #[codec_with = RecipientPair]
    pub companion: Option<Recipient>,
}

/// Described through its codecs: a format that describes types sees the text each one writes.
#[serializable]
pub struct Receipt {
    #[codec_with = HexAmount]
    pub amount: u64,
    #[codec_with = HexWord]
    pub hash: [u8; 4],
}

/// A record that skips fields it does not know. Its IDs leave gaps for unknown ones.
#[serializable]
#[codec_skip_unknown]
pub struct Lenient {
    #[codec_id = 2]
    pub owner: u64,
    #[codec_id = 5]
    pub balance: u64,
    #[codec_id = 8]
    pub label: Option<Text<8>>,
}

/// `Lenient` without the attribute: any unknown field is an error.
#[serializable]
pub struct Exact {
    #[codec_id = 2]
    pub owner: u64,
    #[codec_id = 5]
    pub balance: u64,
    #[codec_id = 8]
    pub label: Option<Text<8>>,
}

/// Only the nested record skips unknown fields.
#[serializable]
pub struct Ledger { pub lenient: Lenient, pub exact: Exact }

/// An `AccountV1` reader that accepts data written by `AccountV2` and later versions.
#[serializable]
#[codec_skip_unknown]
pub struct AccountReader {
    #[codec_id = 1]
    pub owner: u64,
    #[codec_id = 2]
    pub balance: u64,
}

/// An enum with payloads: a variant with none, a one-element variant, whose payload is the value
/// itself, a tuple variant and a record variant. A variant with none is written as in an enum
/// without payloads.
#[serializable]
pub enum Shape {
    Empty,
    Point(u64),
    Pair(u64, Text<8>),
    Circle { pub radius: u64, pub label: Option<Text<8>> },
}

impl Copy for Shape {}

/// Payload enums inside an option, an array, a list and a map, which need them `Copy`.
#[serializable]
pub struct Canvas {
    pub main: Shape,
    pub spare: Option<Shape>,
    pub ring: [Shape; 2],
    pub layers: List<Shape, 2>,
    pub named: Map<u8, Shape, 2>,
}

/// Variant IDs, field IDs inside a record variant, a variant holding a payload enum and a
/// codec on the fields of a record variant.
#[serializable]
pub enum Event {
    #[codec_id = 7]
    Start,
    #[codec_id = 3]
    Move {
        #[codec_id = 9]
        pub dx: i16,
        #[codec_id = 2]
        pub dy: i16,
        #[codec_id = 4]
        pub note: Option<Text<8>>,
    },
    #[codec_id = 40]
    Draw(Shape),
    #[codec_id = 12]
    Pay {
        #[codec_with = HexAmount]
        pub amount: u64,
        #[codec_with = HexAmount]
        pub tip: Option<u64>,
    },
}

/// Record variants of arrays: one of records that are not `Copy`, which decodes element by
/// element, and an empty one. A variant of one such record.
#[serializable]
pub enum Layout {
    Row { pub cells: [Recipient; 2], pub flags: [bool; 0] },
    Cell(Recipient),
}

/// Tuple variants of every kind of element, and one-element variants of an option and an
/// array.
#[serializable]
pub enum Parts {
    Mixed(Option<u8>, [u8; 2], (bool, u8), List<u8, 2>),
    Maybe(Option<u8>),
    Pair([u8; 2]),
}

/// `#[codec_skip_unknown]` on an enum skips unknown fields of its record variants.
#[serializable]
#[codec_skip_unknown]
pub enum Tolerant {
    Gone,
    Account { pub owner: u64, pub balance: u64 },
    Ping {},
    Plain(u64),
}
