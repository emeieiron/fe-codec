use core::bytes::PackedBytes
use fe_codec_core::{BoundedBuffer, Text}
use std::evm::Address
use ingot::codecs::{HexAmount, HexWord, RecipientPair}
use ingot::custom::Celsius

#[serializable]
pub struct Recipient { pub active: bool, pub label: Text<8> }

#[serializable]
pub enum Status {
    Pending,
    Sent,
}

#[serializable]
pub struct Transfer {
    pub recipient: Recipient,
    pub amount: u64,
    pub delta: i64,
    pub status: Status,
    pub hops: [u8; 2],
    pub flags: [bool; 0],
    pub nonce: Option<u16>,
}

#[serializable]
pub struct Batch { pub transfers: [Transfer; 1] }

#[serializable]
pub struct Sample { pub value: u8, pub note: Option<Text<8>> }

#[serializable]
pub enum StableStatus {
    #[codec_id = 62]
    Ready,
    #[codec_id = 0]
    Waiting,
}

#[serializable]
pub struct StableTransfer {
    #[codec_id = 9]
    pub amount: u8,
    #[codec_id = 2]
    pub status: StableStatus,
}

/// Every integer wider than 64 bits.
#[serializable]
pub struct Wide { pub big: u256, pub signed: i256, pub mid: u128, pub small: i128 }

/// Byte strings: an exact-length hash, a bounded memo and an EVM address.
#[serializable]
pub struct Wallet {
    pub owner: Address,
    pub hash: PackedBytes<4>,
    pub memo: BoundedBuffer<8>,
    pub tag: Option<PackedBytes<2>>,
}

/// A generic record. Decoding the array makes `T` need `Copy`.
#[serializable]
pub struct Page<T, const N: usize> { pub items: [T; N], pub next: Option<u64> }

/// Optional values inside a sequence.
#[serializable]
pub struct Slots { pub values: [Option<u8>; 3] }

/// Tuples are fixed-length sequences: as fields, nested, in an array and inside an `Option`.
#[serializable]
pub struct Waypoint {
    pub at: (u8, Text<8>),
    pub bounds: ((i16, i16), (i16, i16)),
    pub legs: [(u8, bool); 2],
    pub next: Option<(u16, u64)>,
    pub tag: (u8,),
}

/// A field whose type has a handwritten serializer in another module.
#[serializable]
pub struct Reading { pub at: u64, pub temperature: Celsius }

/// A record with IDs 1 and 3, matching RFC 8949's map example `{1: 2, 3: 4}`.
#[serializable]
pub struct Pairs {
    #[codec_id = 1]
    pub first: u8,
    #[codec_id = 3]
    pub second: u8,
}

/// Three revisions of one record, for schema evolution.
#[serializable]
pub struct AccountV1 {
    #[codec_id = 1]
    pub owner: u64,
    #[codec_id = 2]
    pub balance: u64,
}

/// Version 2 appends an optional field with a new ID.
#[serializable]
pub struct AccountV2 {
    #[codec_id = 1]
    pub owner: u64,
    #[codec_id = 2]
    pub balance: u64,
    #[codec_id = 3]
    pub label: Option<Text<8>>,
}

/// Renames both fields but keeps their IDs.
#[serializable]
pub struct AccountRenamed {
    #[codec_id = 1]
    pub holder: u64,
    #[codec_id = 2]
    pub funds: u64,
}

/// Fields written by a codec rather than their types' own serializers: a scalar as hex text,
/// the same codec on an optional field, and an array handed to the codec whole.
#[serializable]
pub struct Payment {
    pub id: u8,
    #[codec_with = HexAmount]
    pub amount: u64,
    #[codec_with = HexAmount]
    pub tip: Option<u64>,
    #[codec_with = HexWord]
    pub hash: [u8; 4],
}

/// A codec that changes a record's shape, on a plain and an optional field.
#[serializable]
pub struct Booking {
    #[codec_with = RecipientPair]
    pub guest: Recipient,
    #[codec_with = RecipientPair]
    pub companion: Option<Recipient>,
}

/// Described through its codecs: a format that describes types sees the text each one writes.
#[serializable]
pub struct Receipt {
    #[codec_with = HexAmount]
    pub amount: u64,
    #[codec_with = HexWord]
    pub hash: [u8; 4],
}
