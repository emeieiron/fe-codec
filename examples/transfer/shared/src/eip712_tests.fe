const ORDER_DIGEST: u256 = 0x0889a96d73bdd82a5019683a1dffee0b508aba14e578ee92e94f0408541a6865
const ORDER_JSON: [u8; 1068] = "{\"types\":{\"EIP712Domain\":[{\"name\":\"name\",\"type\":\"string\"},{\"name\":\"version\",\"type\":\"string\"},{\"name\":\"chainId\",\"type\":\"uint256\"},{\"name\":\"verifyingContract\",\"type\":\"address\"},{\"name\":\"salt\",\"type\":\"bytes32\"}],\"Order\":[{\"name\":\"maker\",\"type\":\"Party\"},{\"name\":\"item\",\"type\":\"Asset\"},{\"name\":\"terms\",\"type\":\"Terms\"}],\"Asset\":[{\"name\":\"token\",\"type\":\"address\"},{\"name\":\"amount\",\"type\":\"uint256\"}],\"Contact\":[{\"name\":\"email\",\"type\":\"string\"}],\"Party\":[{\"name\":\"who\",\"type\":\"address\"},{\"name\":\"contact\",\"type\":\"Contact\"}],\"Terms\":[{\"name\":\"deadline\",\"type\":\"uint64\"},{\"name\":\"partial\",\"type\":\"bool\"}]},\"primaryType\":\"Order\",\"domain\":{\"name\":\"Full\",\"version\":\"2\",\"chainId\":\"137\",\"verifyingContract\":\"0xcccccccccccccccccccccccccccccccccccccccc\",\"salt\":\"0x0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20\"},\"message\":{\"maker\":{\"who\":\"0xcd2a3d9f938e13cd947ec05abc7fe734df8dd826\",\"contact\":{\"email\":\"cow@example.org\"}},\"item\":{\"token\":\"0x0000000000000000000000000000000000000001\",\"amount\":\"1000000000000000000\"},\"terms\":{\"deadline\":\"1700000000\",\"partial\":false}}}"
const MAIL_SEPARATOR: u256 = 0xf2cee375fa42b42143804025fc449deafd50cc031ca257e0b194a650a912090f
const FULL_SEPARATOR: u256 = 0x689beec36d8fc1b869233213ddb6b2fd7336e233af826094adbec714fa6ff3a1
const PARTIAL_SEPARATOR: u256 = 0x8d045f17569257da61874b78b18c6570bedc492bb70ffcac8db1ff6a94521e8a
const EMPTY_SEPARATOR: u256 = 0x6192106f129ce05c9075d319c1fa6ea9b3ae37cbd0c1ef92e2be7137bb07baa1
// Flat: Flat(uint256 a,address b,bool c)

const COW: u256 = 0xcd2a3d9f938e13cd947ec05abc7fe734df8dd826
const BOB: u256 = 0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
const VERIFIER: u256 = 0xcccccccccccccccccccccccccccccccccccccccc

fn must<T>(_ result: own CodecResult<T>) -> T {
    match result {
        Result::Ok(value) => value,
        Result::Err(_) => core::panic(),
    }
}

fn text<const M: usize, const N: usize>(_ bytes: [u8; M]) -> Text<N> {
    must(Text<N>::from_array(bytes))
}

fn expect_error<T>(_ result: own CodecResult<T>, _ kind: ErrorKind) {
    match result {
        Result::Err(error) => assert!(error.kind == kind),
        Result::Ok(_) => assert!(false),
    }
}

fn expect_field<T, const M: usize>(_ result: own CodecResult<T>, _ kind: ErrorKind, _ name: [u8; M]) {
    match result {
        Result::Err(error) => {
            assert!(error.kind == kind)
            assert!(error.field().unwrap().as_bytes().equals(BoundedBuffer<M>::from_array(name)))
        },
        Result::Ok(_) => assert!(false),
    }
}

/// Every EIP-712 output for one value: its type string and hash, its struct hash, the digest
/// in `domain`, and the wallet request, byte for byte. The generated static hashing must
/// agree with the generic path.
fn check<T: Serialize + Describe + Eip712Struct, const E: usize, const J: usize>(
    _ value: T,
    _ domain: Domain,
    _ encode_type: [u8; E],
    _ type_hash: u256,
    _ hash: u256,
    _ digest: u256,
    _ json: [u8; J],
) {
    let eip712 = Eip712::new()
    let expected = text<E, E>(encode_type)
    assert!(must(eip712.encode_type<T, E>()).equals(expected))
    assert!(must(eip712.type_hash<T>()) == type_hash)
    assert!(must(eip712.hash_struct(value)) == hash)
    assert!(must(eip712.signing_hash(domain, value)) == digest)
    let request = must(eip712.typed_data_json<T, J>(domain, value))
    assert!(request.equals(BoundedBuffer<J>::from_array(json)))
    assert!(T::TYPE_HASH == type_hash)
    assert!(value.hash_struct() == hash)
    assert!(domain.digest(value.hash_struct()) == digest)
}

fn cow() -> Person {
    Person { name: text("Cow"), wallet: Address::new(COW) }
}

fn bob() -> Person {
    Person { name: text("Bob"), wallet: Address::new(BOB) }
}

fn mail() -> Mail {
    Mail { from: cow(), to: bob(), contents: text("Hello, Bob!") }
}

fn mail_domain() -> Domain {
    Domain::new().name(text("Ether Mail")).version(text("1")).chain_id(1).verifying_contract(Address::new(VERIFIER))
}

fn salt() -> PackedBytes<32> {
    var bytes: [u8; 32] = [0; 32]
    var index: usize = 0
    while index < 32 {
        bytes[index] = (index + 1).downcast_truncate()
        index += 1
    }
    PackedBytes<32>::from_array(bytes)
}

fn full_domain() -> Domain {
    Domain::new().name(text("Full")).version(text("2")).chain_id(137).verifying_contract(Address::new(VERIFIER)).salt(salt())
}

fn partial_domain() -> Domain {
    Domain::new().name(text("Partial")).chain_id(10)
}

#[test]
fn matches_the_eip_reference_mail() {
    check(mail(), mail_domain(), MAIL_ENCODE_TYPE, MAIL_TYPE_HASH, MAIL_HASH, MAIL_DIGEST, MAIL_JSON)
}

#[test]
fn hashes_arrays_of_structs() {
    check(
        Group { name: text("Team"), members: [cow(), bob()] },
        full_domain(),
        GROUP_ENCODE_TYPE,
        GROUP_TYPE_HASH,
        GROUP_HASH,
        GROUP_DIGEST,
        GROUP_JSON,
    )
}

#[test]
fn hashes_nested_arrays() {
    check(
        Grid { cells: [[1, 2], [3, 4], [5, 255]] },
        partial_domain(),
        GRID_ENCODE_TYPE,
        GRID_TYPE_HASH,
        GRID_HASH,
        GRID_DIGEST,
        GRID_JSON,
    )
}

#[test]
fn includes_types_reachable_only_through_empty_arrays() {
    check(
        Inbox { owner: Address::new(COW), mails: [] },
        Domain::new(),
        INBOX_ENCODE_TYPE,
        INBOX_TYPE_HASH,
        INBOX_HASH,
        INBOX_DIGEST,
        INBOX_JSON,
    )
}

#[test]
fn encodes_every_atomic_and_dynamic_type() {
    var hash: [u8; 32] = [0; 32]
    var index: usize = 0
    while index < 32 {
        hash[index] = index.downcast_truncate()
        index += 1
    }
    let big: i256 = -(1 << 200)
    let ubig: u256 = (1 << 255) + 7
    let kinds = Kinds {
        flag: true,
        small: -12,
        big,
        ubig,
        data: BoundedBuffer<8>::from_prefix([1, 2, 3]).unwrap(),
        hash: PackedBytes<32>::from_array(hash),
        short: PackedBytes<4>::from_array([0xde, 0xad, 0xbe, 0xef]),
        label: text("say \"hi\" ü"),
        who: Address::new(BOB),
        level: Level::High,
    }
    check(kinds, mail_domain(), KINDS_ENCODE_TYPE, KINDS_TYPE_HASH, KINDS_HASH, KINDS_DIGEST, KINDS_JSON)
}

#[test]
fn sorts_referenced_types_by_name() {
    let order = Order {
        maker: Party { who: Address::new(COW), contact: Contact { email: text("cow@example.org") } },
        item: Asset { token: Address::new(1), amount: 1000000000000000000 },
        terms: Terms { deadline: 1700000000, partial: false },
    }
    check(order, full_domain(), ORDER_ENCODE_TYPE, ORDER_TYPE_HASH, ORDER_HASH, ORDER_DIGEST, ORDER_JSON)
}

#[test]
fn domain_separators_cover_every_field_combination() {
    assert!(mail_domain().separator() == MAIL_SEPARATOR)
    assert!(full_domain().separator() == FULL_SEPARATOR)
    assert!(partial_domain().separator() == PARTIAL_SEPARATOR)
    assert!(Domain::new().separator() == EMPTY_SEPARATOR)
    // std's four-field separator agrees with the general one.
    let standard = std::evm::eip712::domain_separator(
        name_hash: core::keccak("Ether Mail"),
        version_hash: core::keccak("1"),
        chain_id: 1,
        verifying_contract: Address::new(VERIFIER),
    )
    assert!(standard == MAIL_SEPARATOR)
    // Name and version set by hash give the same separator as text.
    let hashed = Domain::new()
        .name_hash(core::keccak("Ether Mail"))
        .version_hash(core::keccak("1"))
        .chain_id(1)
        .verifying_contract(Address::new(VERIFIER))
    assert!(hashed.separator() == MAIL_SEPARATOR)
    assert!(hashed.digest(MAIL_HASH) == MAIL_DIGEST)
    // The wallet request shows the name, so a domain named only by hash has none.
    expect_error(Eip712::new().typed_data_json<Mail, 1024>(hashed, mail()), ErrorKind::Unsupported)
}

#[test]
fn rejects_types_eip712_cannot_express() {
    let eip712 = Eip712::new()
    expect_field(eip712.type_hash<Maybe>(), ErrorKind::Unsupported, "value")
    expect_field(eip712.type_hash<TooLong>(), ErrorKind::Unsupported, "data")
    expect_field(eip712.type_hash<Conflict>(), ErrorKind::Unsupported, "Holder")
    expect_error(eip712.type_hash<EIP712Domain>(), ErrorKind::Unsupported)
    expect_error(eip712.type_hash<u64>(), ErrorKind::Unsupported)
    // A variant ID must fit the uint8 an enum is encoded as.
    assert!(eip712.type_hash<Ranked>().is_ok())
    expect_error(eip712.hash_struct(Ranked { rank: Many::Large }), ErrorKind::IntegerOutOfRange)
    assert!(eip712.hash_struct(Ranked { rank: Many::Zero }).is_ok())
    // One instantiation of a generic type is one struct.
    assert!(eip712.type_hash<Holder<u8>>().is_ok())
}

#[test]
fn respects_capacity_and_depth() {
    expect_error(Eip712::new().with_capacity(64).hash_struct(mail()), ErrorKind::CapacityExceeded)
    expect_error(
        Eip712::with_limits(Limits { max_depth: 1, max_items: 256 }).hash_struct(mail()),
        ErrorKind::DepthLimit,
    )
    expect_error(Eip712::new().typed_data_json<Mail, 100>(mail_domain(), mail()), ErrorKind::CapacityExceeded)
}
