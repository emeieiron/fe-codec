const ORDER_ENCODE_TYPE: [u8; 166] = "Order(Party maker,Asset item,Terms terms)Asset(address token,uint256 amount)Contact(string email)Party(address who,Contact contact)Terms(uint64 deadline,bool partial)"
const ORDER_TYPE_HASH: u256 = 0x4cfb7620b30b04b38e34abdcac7d5f7f41bb556d37f4954edbcc9bf97c374218
