// Flat: Flat(uint256 a,address b,bool c)

const COW: u256 = 0xcd2a3d9f938e13cd947ec05abc7fe734df8dd826
const BOB: u256 = 0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
const VERIFIER: u256 = 0xcccccccccccccccccccccccccccccccccccccccc

fn must<T>(_ result: own CodecResult<T>) -> T {
    match result {
        Result::Ok(value) => value,
        Result::Err(_) => core::panic(),
    }
}

fn expect_error<T>(_ result: own CodecResult<T>, _ kind: ErrorKind) {
    match result {
        Result::Err(error) => assert!(error.kind == kind),
        Result::Ok(_) => assert!(false),
    }
}

fn expect_field<T, const M: usize>(
    _ result: own CodecResult<T>,
    _ kind: ErrorKind,
    _ name: [u8; M],
) {
    match result {
        Result::Err(error) => {
            assert!(error.kind == kind)
            assert!(
                error.field().unwrap().as_bytes().equals(BoundedBuffer<M>::from_array(name)),
            )
        },
        Result::Ok(_) => assert!(false),
    }
}

fn cow() -> Person {
    Person { name: text("Cow"), wallet: Address::new(COW) }
}

fn bob() -> Person {
    Person { name: text("Bob"), wallet: Address::new(BOB) }
}

fn mail() -> Mail {
    Mail { from: cow(), to: bob(), contents: text("Hello, Bob!") }
}

fn mail_domain() -> Domain {
    Domain::new()
        .name(text("Ether Mail"))
        .version(text("1"))
        .chain_id(1)
        .verifying_contract(Address::new(VERIFIER))
}

fn salt() -> PackedBytes<32> {
    var bytes: [u8; 32] = [0; 32]
    var index: usize = 0
    while index < 32 {
        bytes[index] = (index + 1).downcast_truncate()
        index += 1
    }
    PackedBytes<32>::from_array(bytes)
}

fn full_domain() -> Domain {
    Domain::new()
        .name(text("Full"))
        .version(text("2"))
        .chain_id(137)
        .verifying_contract(Address::new(VERIFIER))
        .salt(salt())
}

fn partial_domain() -> Domain {
    Domain::new().name(text("Partial")).chain_id(10)
}

#[test]
fn matches_the_eip_reference_mail() {
    check_eip712(
        mail(),
        mail_domain(),
        MAIL_ENCODE_TYPE,
        MAIL_TYPE_HASH,
        MAIL_HASH,
        MAIL_DIGEST,
        MAIL_JSON,
    )
}

#[test]
fn hashes_arrays_of_structs() {
    check_eip712(
        Group { name: text("Team"), members: [cow(), bob()] },
        full_domain(),
        GROUP_ENCODE_TYPE,
        GROUP_TYPE_HASH,
        GROUP_HASH,
        GROUP_DIGEST,
        GROUP_JSON,
    )
}

#[test]
fn hashes_nested_arrays() {
    // Built element by element: Fe 26.7.0's Sonatina backend panics ("unsupported const
    // subreference source") on the literal `[[1, 2], [3, 4], [5, 255]]` passed to `check`.
    var cells: [[u8; 2]; 3] = [[0; 2]; 3]
    cells[0][0] = 1
    cells[0][1] = 2
    cells[1][0] = 3
    cells[1][1] = 4
    cells[2][0] = 5
    cells[2][1] = 255
    check_eip712(
        Grid { cells },
        partial_domain(),
        GRID_ENCODE_TYPE,
        GRID_TYPE_HASH,
        GRID_HASH,
        GRID_DIGEST,
        GRID_JSON,
    )
}

#[test]
fn includes_types_reachable_only_through_empty_arrays() {
    check_eip712(
        Inbox { owner: Address::new(COW), mails: [] },
        Domain::new(),
        INBOX_ENCODE_TYPE,
        INBOX_TYPE_HASH,
        INBOX_HASH,
        INBOX_DIGEST,
        INBOX_JSON,
    )
}

#[test]
fn encodes_every_atomic_and_dynamic_type() {
    var hash: [u8; 32] = [0; 32]
    var index: usize = 0
    while index < 32 {
        hash[index] = index.downcast_truncate()
        index += 1
    }
    let big: i256 = -(1 << 200)
    let ubig: u256 = (1 << 255) + 7
    let kinds = Kinds {
        flag: true,
        small: -12,
        big,
        ubig,
        data: BoundedBuffer<8>::from_prefix([1, 2, 3]).unwrap(),
        hash: PackedBytes<32>::from_array(hash),
        short: PackedBytes<4>::from_array([0xde, 0xad, 0xbe, 0xef]),
        label: text("say \"hi\" ü"),
        who: Address::new(BOB),
        level: Level::High,
    }
    check_eip712(
        kinds,
        mail_domain(),
        KINDS_ENCODE_TYPE,
        KINDS_TYPE_HASH,
        KINDS_HASH,
        KINDS_DIGEST,
        KINDS_JSON,
    )
}

#[test]
fn sorts_referenced_types_by_name() {
    let order = Order {
        maker: Party {
            who: Address::new(COW),
            contact: Contact { email: text("cow@example.org") },
        },
        item: Asset { token: Address::new(1), amount: 1000000000000000000 },
        terms: Terms { deadline: 1700000000, partial: false },
    }
    check_eip712(
        order,
        full_domain(),
        ORDER_ENCODE_TYPE,
        ORDER_TYPE_HASH,
        ORDER_HASH,
        ORDER_DIGEST,
        ORDER_JSON,
    )
}

#[test]
fn domain_separators_cover_every_field_combination() {
    assert!(mail_domain().separator() == MAIL_SEPARATOR)
    assert!(full_domain().separator() == FULL_SEPARATOR)
    assert!(partial_domain().separator() == PARTIAL_SEPARATOR)
    assert!(Domain::new().separator() == EMPTY_SEPARATOR)
    // std's four-field separator agrees with the general one.
    let standard = std::evm::eip712::domain_separator(
        name_hash: core::keccak("Ether Mail"),
        version_hash: core::keccak("1"),
        chain_id: 1,
        verifying_contract: Address::new(VERIFIER),
    )
    assert!(standard == MAIL_SEPARATOR)
    // Name and version set by hash give the same separator as text.
    let hashed = Domain::new()
        .name_hash(core::keccak("Ether Mail"))
        .version_hash(core::keccak("1"))
        .chain_id(1)
        .verifying_contract(Address::new(VERIFIER))
    assert!(hashed.separator() == MAIL_SEPARATOR)
    assert!(hashed.digest(MAIL_HASH) == MAIL_DIGEST)
    // The wallet request shows the name, so a domain named only by hash has none.
    expect_error(
        Eip712::new().typed_data_json<Mail, 1024>(hashed, mail()),
        ErrorKind::Unsupported,
    )
}

#[test]
fn rejects_types_eip712_cannot_express() {
    let eip712 = Eip712::new()
    expect_field(eip712.type_hash<Maybe>(), ErrorKind::Unsupported, "value")
    expect_field(
        eip712.type_hash<TooLong>(),
        ErrorKind::Unsupported,
        "data",
    )
    expect_field(
        eip712.type_hash<Conflict>(),
        ErrorKind::Unsupported,
        "Holder",
    )
    expect_error(eip712.type_hash<EIP712Domain>(), ErrorKind::Unsupported)
    // EIP-712 has no tuples: describing one fails, so no hash is produced for a value holding one.
    expect_field(
        eip712.type_hash<Coordinates>(),
        ErrorKind::Unsupported,
        "point",
    )
    expect_field(eip712.type_hash<Route>(), ErrorKind::Unsupported, "stops")
    expect_field(
        eip712.encode_type<Coordinates, 64>(),
        ErrorKind::Unsupported,
        "point",
    )
    expect_field(
        eip712.hash_struct(Coordinates { point: (1, 2) }),
        ErrorKind::Unsupported,
        "point",
    )
    expect_field(
        eip712.hash_struct(Route { stops: [(1, 2), (3, 4)] }),
        ErrorKind::Unsupported,
        "stops",
    )
    expect_field(
        eip712.typed_data_json<Coordinates, 256>(mail_domain(), Coordinates { point: (1, 2) }),
        ErrorKind::Unsupported,
        "point",
    )
    expect_error(eip712.type_hash<(u8, u8)>(), ErrorKind::Unsupported)
    expect_error(eip712.type_hash<u64>(), ErrorKind::Unsupported)
    // A variant ID must fit the uint8 an enum is encoded as.
    assert!(eip712.type_hash<Ranked>().is_ok())
    expect_error(
        eip712.hash_struct(Ranked { rank: Many::Large }),
        ErrorKind::IntegerOutOfRange,
    )
    assert!(eip712.hash_struct(Ranked { rank: Many::Zero }).is_ok())
    // One instantiation of a generic type is one struct.
    assert!(eip712.type_hash<Holder<u8>>().is_ok())
}

fn booking_value() -> Booking {
    Booking { guest: Recipient { active: true, label: text("hi") }, companion: Option::None }
}

#[test]
fn describes_codec_fields_as_the_codec_does() {
    let eip712 = Eip712::new()
    // A codec's description stands for the field's type: both codecs here are described as text.
    let expected: [u8; 34] = "Receipt(string amount,string hash)"
    assert!(
        must(eip712.encode_type<Receipt, 34>()).equals(text<34, 34>(expected)),
    )
    assert!(
        eip712.hash_struct(Receipt { amount: 255, hash: [1, 2, 3, 4] }).is_ok(),
    )
    // `RecipientPair` keeps the default `describe`, which fails with `Unsupported`.
    expect_error(eip712.type_hash<Booking>(), ErrorKind::Unsupported)
    expect_error(
        eip712.hash_struct(booking_value()),
        ErrorKind::Unsupported,
    )
}

#[test]
fn respects_capacity_and_depth() {
    expect_error(
        Eip712::new().with_capacity(64).hash_struct(mail()),
        ErrorKind::CapacityExceeded,
    )
    expect_error(
        Eip712::with_limits(Limits { max_depth: 1, max_items: 256 }).hash_struct(mail()),
        ErrorKind::DepthLimit,
    )
    expect_error(
        Eip712::new().typed_data_json<Mail, 100>(mail_domain(), mail()),
        ErrorKind::CapacityExceeded,
    )
}

// A `List<T, N>` is a dynamic array, `T[]`, whatever its capacity.

#[test]
fn hashes_lists_as_dynamic_arrays() {
    let squad = Squad {
        name: text("Team"),
        members: must(List<Person, 4>::from_array([cow(), bob()])),
        scores: must(List<u8, 4>::from_array([1, 2, 255])),
    }
    check_eip712(
        squad,
        full_domain(),
        SQUAD_ENCODE_TYPE,
        SQUAD_TYPE_HASH,
        SQUAD_HASH,
        SQUAD_DIGEST,
        SQUAD_JSON,
    )
}

#[test]
fn hashes_empty_and_full_lists() {
    let nobody = Squad {
        name: text("Nobody"),
        members: List<Person, 4>::new(),
        scores: List<u8, 4>::new(),
    }
    check_eip712(
        nobody,
        mail_domain(),
        SQUAD_EMPTY_ENCODE_TYPE,
        SQUAD_EMPTY_TYPE_HASH,
        SQUAD_EMPTY_HASH,
        SQUAD_EMPTY_DIGEST,
        SQUAD_EMPTY_JSON,
    )
    let four = Squad {
        name: text("Four"),
        members: must(List<Person, 4>::from_array([cow(), bob(), cow(), bob()])),
        scores: must(List<u8, 4>::from_array([0, 1, 2, 3])),
    }
    check_eip712(
        four,
        partial_domain(),
        SQUAD_FULL_ENCODE_TYPE,
        SQUAD_FULL_TYPE_HASH,
        SQUAD_FULL_HASH,
        SQUAD_FULL_DIGEST,
        SQUAD_FULL_JSON,
    )
}

#[test]
fn hashes_lists_inside_arrays_and_arrays_inside_lists() {
    let tiers = Tiers {
        rows: must(List<[u8; 2], 3>::from_array([[1, 2], [3, 4]])),
        columns: [must(List<u8, 2>::from_array([5])), must(List<u8, 2>::from_array([6, 7]))],
        nested: must(
            List<List<u8, 2>, 3>::from_array(
                [
                    must(List<u8, 2>::from_array([8])),
                    List<u8, 2>::new(),
                    must(List<u8, 2>::from_array([9, 10])),
                ],
            ),
        ),
    }
    check_eip712(
        tiers,
        partial_domain(),
        TIERS_ENCODE_TYPE,
        TIERS_TYPE_HASH,
        TIERS_HASH,
        TIERS_DIGEST,
        TIERS_JSON,
    )
    let none = Tiers {
        rows: List<[u8; 2], 3>::new(),
        columns: [List<u8, 2>::new(), List<u8, 2>::new()],
        nested: List<List<u8, 2>, 3>::new(),
    }
    check_eip712(
        none,
        Domain::new(),
        TIERS_EMPTY_ENCODE_TYPE,
        TIERS_EMPTY_TYPE_HASH,
        TIERS_EMPTY_HASH,
        TIERS_EMPTY_DIGEST,
        TIERS_EMPTY_JSON,
    )
}

#[test]
fn rejects_what_a_list_cannot_hold() {
    let eip712 = Eip712::new()
    // EIP-712 has no optional types, so a list of them has no type, and the error names the field.
    expect_field(
        eip712.type_hash<Sparse>(),
        ErrorKind::Unsupported,
        "slots",
    )
    let sparse = Sparse { slots: must(List<Option<u8>, 2>::from_array([Option::Some(1)])) }
    expect_field(
        eip712.hash_struct(sparse),
        ErrorKind::Unsupported,
        "slots",
    )
    // `Limits.max_items` counts a list's elements, as it counts the fields of a struct.
    let narrow = Eip712::with_limits(Limits { max_depth: 32, max_items: 3 })
    let crowded = Squad {
        name: text("Team"),
        members: must(List<Person, 4>::from_array([cow(), bob(), cow()])),
        scores: must(List<u8, 4>::from_array([1, 2, 3, 4])),
    }
    expect_error(narrow.hash_struct(crowded), ErrorKind::CollectionLimit)
    let fitting = Squad {
        name: text("Team"),
        members: crowded.members,
        scores: must(List<u8, 4>::from_array([1, 2, 3])),
    }
    assert!(narrow.hash_struct(fitting).is_ok())
    // The stack holds a list's words until it is hashed.
    let squad = Squad {
        name: text("Team"),
        members: must(List<Person, 4>::from_array([cow(), bob()])),
        scores: must(List<u8, 4>::from_array([1, 2, 255])),
    }
    expect_error(
        Eip712::new().with_capacity(160).hash_struct(squad),
        ErrorKind::CapacityExceeded,
    )
}
