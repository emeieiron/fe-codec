use core::marker::Copy
use fe_codec_io::{BoundedBuffer, ByteWriter}
use ingot::error::{CodecError, CodecResult, ErrorKind}

/// A validated UTF-8 value whose length counts bytes, including NUL bytes.
pub struct Text<const N: usize> { bytes: BoundedBuffer<N> }
impl<const N: usize> Copy for Text<N> {}

impl<const N: usize> Text<N> {
    pub fn from_array<const M: usize>(_ bytes: [u8; M]) -> CodecResult<Self> {
        match BoundedBuffer<N>::from_prefix(bytes) {
            Option::Some(buffer) => Self::from_bytes(buffer),
            Option::None => Result::Err(
                CodecError::at(kind: ErrorKind::CapacityExceeded, offset: N),
            ),
        }
    }

    pub fn from_bytes(_ bytes: own BoundedBuffer<N>) -> CodecResult<Self> {
        var utf8 = Utf8::new()
        var offset: usize = 0
        while offset < bytes.len() {
            utf8.push(bytes.byte_at(offset).unwrap(), offset)?
            offset += 1
        }
        utf8.finish(offset)?
        Result::Ok(Self { bytes })
    }

    pub fn len(self) -> usize {
        self.bytes.len()
    }

    pub fn byte_at(self, _ index: usize) -> Option<u8> {
        self.bytes.byte_at(index)
    }

    pub fn equals<const M: usize>(self, _ other: Text<M>) -> bool {
        self.bytes.equals(other.bytes)
    }
}

/// Builds text while retaining source offsets for validation errors.
pub struct TextWriter<const N: usize> { output: ByteWriter<N>, utf8: Utf8 }

impl<const N: usize> TextWriter<N> {
    pub fn new() -> Self {
        Self { output: ByteWriter<N>::new(), utf8: Utf8::new() }
    }

    pub fn write(mut self, _ byte: u8, _ offset: usize) -> CodecResult<()> {
        if self.output.offset() == N {
            return Result::Err(CodecError::at(kind: ErrorKind::CapacityExceeded, offset))
        }
        self.utf8.push(byte, offset)?
        match self.output.write(byte) {
            Result::Ok(()) => Result::Ok(()),
            Result::Err(_) => Result::Err(
                CodecError::at(kind: ErrorKind::CapacityExceeded, offset),
            ),
        }
    }

    /// Validate a boundary such as an escape or the end of a wire string.
    pub fn boundary(self, _ offset: usize) -> CodecResult<()> {
        self.utf8.finish(offset)
    }

    pub fn finish(own self, _ offset: usize) -> CodecResult<Text<N>> {
        self.boundary(offset)?
        Result::Ok(Text { bytes: self.output.finish() })
    }
}

/// UTF-8 validation state: bytes still expected in the current sequence, and the range the
/// next byte must fall in. `step` is a pure function so `femp prove` can check it against
/// RFC 3629 (see `verification.fe`).
pub(ingot) struct Utf8 { pub(ingot) remaining: u8, pub(ingot) lower: u8, pub(ingot) upper: u8 }
impl Copy for Utf8 {}

impl Utf8 {
    pub(ingot) fn new() -> Self {
        Self { remaining: 0, lower: 0x80, upper: 0xbf }
    }

    /// The state after `byte`, or `None` when `byte` cannot continue well-formed UTF-8.
    pub(ingot) fn step(self, _ byte: u8) -> Option<Self> {
        if self.remaining != 0 {
            if byte < self.lower || byte > self.upper {
                return Option::None
            }
            return Option::Some(Self { remaining: self.remaining - 1, lower: 0x80, upper: 0xbf })
        }
        if byte < 0x80 {
            return Option::Some(self)
        }
        if byte >= 0xc2 && byte <= 0xdf {
            return Option::Some(Self { remaining: 1, lower: 0x80, upper: 0xbf })
        }
        if byte >= 0xe0 && byte <= 0xef {
            let lower: u8 = if byte == 0xe0 { 0xa0 } else { 0x80 }
            let upper: u8 = if byte == 0xed { 0x9f } else { 0xbf }
            return Option::Some(Self { remaining: 2, lower, upper })
        }
        if byte >= 0xf0 && byte <= 0xf4 {
            let lower: u8 = if byte == 0xf0 { 0x90 } else { 0x80 }
            let upper: u8 = if byte == 0xf4 { 0x8f } else { 0xbf }
            return Option::Some(Self { remaining: 3, lower, upper })
        }
        Option::None
    }

    fn push(mut self, _ byte: u8, _ offset: usize) -> CodecResult<()> {
        match self.step(byte) {
            Option::Some(next) => {
                self.remaining = next.remaining
                self.lower = next.lower
                self.upper = next.upper
                Result::Ok(())
            },
            Option::None => Result::Err(CodecError::at(kind: ErrorKind::InvalidUtf8, offset)),
        }
    }

    fn finish(self, _ offset: usize) -> CodecResult<()> {
        if self.remaining != 0 {
            return Result::Err(CodecError::at(kind: ErrorKind::InvalidUtf8, offset))
        }
        Result::Ok(())
    }
}
