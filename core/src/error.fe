use core::abi::{AbiFrame, AbiSize, Encode}
use core::marker::Copy
use core::ops::Eq
use fe_codec_io::{IoError, IoErrorKind}
use std::abi::Sol
use ingot::schema::SchemaName

pub enum ErrorKind {
    UnexpectedEnd,
    CapacityExceeded,
    InvalidSyntax,
    InvalidUtf8,
    TypeMismatch,
    IntegerOutOfRange,
    UnknownField,
    DuplicateField,
    MissingField,
    UnknownVariant,
    InvalidLength,
    InvalidState,
    TrailingData,
    DepthLimit,
    CollectionLimit,
    Unsupported,
    NonCanonical,
}

impl Copy for ErrorKind {}

impl ErrorKind {
    /// Stable nonzero code for platform boundaries.
    pub fn code(self) -> u32 {
        match self {
            Self::UnexpectedEnd => 1,
            Self::CapacityExceeded => 2,
            Self::InvalidSyntax => 3,
            Self::InvalidUtf8 => 4,
            Self::TypeMismatch => 5,
            Self::IntegerOutOfRange => 6,
            Self::UnknownField => 7,
            Self::DuplicateField => 8,
            Self::MissingField => 9,
            Self::UnknownVariant => 10,
            Self::InvalidLength => 11,
            Self::InvalidState => 12,
            Self::TrailingData => 13,
            Self::DepthLimit => 14,
            Self::CollectionLimit => 15,
            Self::Unsupported => 16,
            Self::NonCanonical => 17,
        }
    }
}

impl Eq for ErrorKind {
    fn eq(self, _ other: Self) -> bool {
        self.code() == other.code()
    }
}

/// A failure with its kind and the zero-based byte offset where it was found.
///
/// The offset can equal the input length when data is missing. For output capacity errors it
/// is the first byte that did not fit. `field()` names the innermost record field whose value
/// failed, or the field that was missing or duplicated.
pub struct CodecError { pub kind: ErrorKind, pub offset: usize, name: u256 }
impl Copy for CodecError {}

pub type CodecResult<T> = Result<CodecError, T>

impl CodecError {
    pub fn at(kind: ErrorKind, offset: usize) -> Self {
        Self { kind, offset, name: 0 }
    }

    /// The error attributed to field `name`, unless an inner field already claimed it.
    pub fn in_field(self, _ name: SchemaName) -> Self {
        if self.name != 0 {
            return self
        }
        Self { kind: self.kind, offset: self.offset, name: name.word() }
    }

    /// The field the error belongs to, if any.
    pub fn field(self) -> Option<SchemaName> {
        if self.name == 0 {
            return Option::None
        }
        Option::Some(SchemaName::from_word(self.name))
    }

    pub fn from_io(_ error: own IoError) -> Self {
        let kind = match error.kind {
            IoErrorKind::UnexpectedEnd => ErrorKind::UnexpectedEnd,
            IoErrorKind::CapacityExceeded => ErrorKind::CapacityExceeded,
        }
        Self::at(kind, offset: error.offset)
    }
}

/// On the EVM, a panic carries its value as revert data, so `unwrap` on a `CodecResult`
/// reverts with two ABI words: the kind's `code()` and the byte offset. The field name is not
/// included.
impl AbiSize for CodecError {
    const HEAD_SIZE: u256 = 64
    const IS_DYNAMIC: bool = false
}

impl Encode<Sol> for CodecError {
    fn encode(self, _ out: AbiFrame) {
        out.store_word(at: 0, value: self.kind.code() as u256)
        out.store_word(at: 32, value: self.offset as u256)
    }
}

/// Bounds a decoder or encoder enforces besides its buffer capacity.
pub struct Limits { pub max_depth: usize, pub max_items: usize }
impl Copy for Limits {}

impl Limits {
    /// 32 nested containers and 256 entries per container.
    pub const fn standard() -> Self {
        Self { max_depth: 32, max_items: 256 }
    }
}
