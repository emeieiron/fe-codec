use ingot::{
    BoundedBuffer,
    CodecError,
    CodecResult,
    Decoder,
    Describe,
    Describer,
    Deserialize,
    Encoder,
    ErrorKind,
    FieldCodec,
    Frame,
    List,
    Schema,
    Serialize,
    Text,
    TextWriter,
    Utf8,
    checked_signed,
    checked_unsigned,
    checked_wide_signed,
    checked_wide_unsigned,
    describe_optional_with,
    schema_name,
}

#[test]
fn valid_text_keeps_nul_and_multibyte_sequences() {
    let bytes = BoundedBuffer<6>::from_array([0, 0xc2, 0xa2, 0xe2, 0x82, 0xac])
    match Text<6>::from_bytes(bytes) {
        Result::Ok(text) => {
            assert!(text.len() == 6)
            assert!(text.byte_at(0) == Option::Some(0))
            assert!(text.byte_at(5) == Option::Some(0xac))
        },
        Result::Err(_) => assert!(false),
    }
}

#[test]
fn text_rejects_overlong_surrogate_and_truncated_utf8() {
    invalid(
        Text<2>::from_bytes(BoundedBuffer<2>::from_array([0xc0, 0x80])),
        0,
    )
    invalid(
        Text<3>::from_bytes(BoundedBuffer<3>::from_array([0xed, 0xa0, 0x80])),
        1,
    )
    invalid(
        Text<4>::from_bytes(BoundedBuffer<4>::from_array([0xf4, 0x90, 0x80, 0x80])),
        1,
    )
    invalid(
        Text<1>::from_bytes(BoundedBuffer<1>::from_array([0xe2])),
        1,
    )
}

#[test]
fn text_writer_uses_source_offsets() {
    var writer = TextWriter<2>::new()
    assert!(writer.write(0xc2, 10).is_ok())
    invalid(writer.write(b'a', 15), 15)
    assert!(writer.write(0xa2, 16).is_ok())
    match writer.write(b'x', 19) {
        Result::Err(error) => assert!(
            error.kind == ErrorKind::CapacityExceeded && error.offset == 19,
        ),
        Result::Ok(_) => assert!(false),
    }
    match writer.finish(20) {
        Result::Ok(text) => assert!(text.len() == 2),
        Result::Err(_) => assert!(false),
    }
}

fn invalid<T>(_ result: own CodecResult<T>, _ offset: usize) {
    match result {
        Result::Err(error) => assert!(
            error.kind == ErrorKind::InvalidUtf8 && error.offset == offset,
        ),
        Result::Ok(_) => assert!(false),
    }
}

fn kind<T>(_ result: own CodecResult<T>) -> u32 {
    match result {
        Result::Ok(_) => 0,
        Result::Err(error) => error.kind.code(),
    }
}

#[test]
fn integer_checks_accept_exactly_their_ranges() {
    assert!(checked_unsigned(255, 8, 0).is_ok() && kind(checked_unsigned(256, 8, 0)) == 6)
    assert!(checked_signed(-128, 8, 0).is_ok() && kind(checked_signed(128, 8, 0)) == 6)
    assert!(kind(checked_unsigned(1, 7, 0)) == 16 && kind(checked_signed(1, 128, 0)) == 16)
    let u128_max: u256 = 0xffffffffffffffffffffffffffffffff
    assert!(checked_wide_unsigned(u128_max, 128, 0).is_ok())
    assert!(kind(checked_wide_unsigned(u128_max + 1, 128, 0)) == 6)
    let i128_min: i256 = -0x80000000000000000000000000000000
    assert!(checked_wide_signed(i128_min, 128, 0).is_ok())
    assert!(kind(checked_wide_signed(i128_min - 1, 128, 0)) == 6)
    assert!(kind(checked_wide_signed(-i128_min, 128, 0)) == 6)
    assert!(kind(checked_wide_unsigned(1, 64, 0)) == 16)
}

#[test]
fn frames_count_entries_and_require_ascending_keys() {
    var frame = Frame::new(2)
    assert!(kind(frame.key(0, 0)) == 7)
    assert!(frame.key(3, 0).is_ok() && frame.taken() == 1)
    assert!(kind(frame.key(3, 4)) == 8)
    assert!(kind(frame.key(2, 4)) == 17)
    assert!(kind(frame.complete(5)) == 11)
    assert!(frame.key(9, 6).is_ok() && frame.remaining() == 0)
    assert!(kind(frame.take(7)) == 11)
    assert!(frame.complete(8).is_ok())
}

#[test]
fn errors_keep_the_innermost_field() {
    let inner = CodecError::at(kind: ErrorKind::InvalidUtf8, offset: 3).in_field(schema_name<5>("label"))
    let outer = inner.in_field(schema_name<9>("recipient"))
    let label: [u8; 5] = "label"
    assert!(outer.field().unwrap().as_bytes().equals(BoundedBuffer<5>::from_array(label)))
    assert!(outer.offset == 3 && outer.kind == ErrorKind::InvalidUtf8)
    assert!(CodecError::at(kind: ErrorKind::UnknownField, offset: 0).field().is_none())
}

/// Records the calls a description makes: 1 for `bool`, the width of an integer, 100 + the arity
/// for `begin_tuple`, 200 + the arity for `end_tuple`, 300 for `begin_option`, 400 for
/// `end_option`, 500 + the capacity for `text`, 600 + the capacity for `begin_list` and
/// 700 + the capacity for `end_list`. Other calls are not made.
struct Trace { events: [usize; 16], len: usize }

impl Trace {
    fn new() -> Self {
        Self { events: [0; 16], len: 0 }
    }

    fn push(mut self, _ event: usize) -> CodecResult<()> {
        self.events[self.len] = event
        self.len += 1
        Result::Ok(())
    }
}

impl Describer for Trace {
    fn bool(mut self) -> CodecResult<()> {
        self.push(1)
    }

    fn unsigned(mut self, _ bits: u16) -> CodecResult<()> {
        self.push(bits as usize)
    }

    fn signed(mut self, _ bits: u16) -> CodecResult<()> {
        self.push(bits as usize)
    }

    fn text(mut self, _ capacity: usize) -> CodecResult<()> {
        self.push(500 + capacity)
    }

    fn bytes(mut self, _ capacity: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn fixed_bytes(mut self, _ length: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn address(mut self) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn begin_option(mut self) -> CodecResult<()> {
        self.push(300)
    }

    fn end_option(mut self) -> CodecResult<()> {
        self.push(400)
    }

    fn begin_sequence(mut self, _ length: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn end_sequence(mut self, _ length: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn begin_list(mut self, _ capacity: usize) -> CodecResult<()> {
        self.push(600 + capacity)
    }

    fn end_list(mut self, _ capacity: usize) -> CodecResult<()> {
        self.push(700 + capacity)
    }

    fn begin_tuple(mut self, _ length: usize) -> CodecResult<()> {
        self.push(100 + length)
    }

    fn end_tuple(mut self, _ length: usize) -> CodecResult<()> {
        self.push(200 + length)
    }

    fn enumeration<V: Schema>(mut self) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn begin_record<R: Schema>(mut self) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn field<R: Schema>(mut self, _ position: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }

    fn end_record<R: Schema>(mut self) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }
}

/// A describer that leaves the tuple methods at their defaults.
struct NoTuples {}

impl Describer for NoTuples {
    fn bool(mut self) -> CodecResult<()> {
        Result::Ok(())
    }

    fn unsigned(mut self, _ bits: u16) -> CodecResult<()> {
        Result::Ok(())
    }

    fn signed(mut self, _ bits: u16) -> CodecResult<()> {
        Result::Ok(())
    }

    fn text(mut self, _ capacity: usize) -> CodecResult<()> {
        Result::Ok(())
    }

    fn bytes(mut self, _ capacity: usize) -> CodecResult<()> {
        Result::Ok(())
    }

    fn fixed_bytes(mut self, _ length: usize) -> CodecResult<()> {
        Result::Ok(())
    }

    fn address(mut self) -> CodecResult<()> {
        Result::Ok(())
    }

    fn begin_option(mut self) -> CodecResult<()> {
        Result::Ok(())
    }

    fn end_option(mut self) -> CodecResult<()> {
        Result::Ok(())
    }

    fn begin_sequence(mut self, _ length: usize) -> CodecResult<()> {
        Result::Ok(())
    }

    fn end_sequence(mut self, _ length: usize) -> CodecResult<()> {
        Result::Ok(())
    }

    fn enumeration<V: Schema>(mut self) -> CodecResult<()> {
        Result::Ok(())
    }

    fn begin_record<R: Schema>(mut self) -> CodecResult<()> {
        Result::Ok(())
    }

    fn field<R: Schema>(mut self, _ position: usize) -> CodecResult<()> {
        Result::Ok(())
    }

    fn end_record<R: Schema>(mut self) -> CodecResult<()> {
        Result::Ok(())
    }
}

#[test]
fn tuples_describe_their_elements_in_order() {
    var one = Trace::new()
    assert!(<(u8,) as Describe>::describe(mut one).is_ok())
    assert!(one.len == 3 && one.events[0] == 101 && one.events[1] == 8 && one.events[2] == 201)

    var nested = Trace::new()
    assert!(<(u16, (bool, i32)) as Describe>::describe(mut nested).is_ok())
    let expected: [usize; 7] = [102, 16, 102, 1, 32, 202, 202]
    var index: usize = 0
    while index < 7 {
        assert!(nested.events[index] == expected[index])
        index += 1
    }
    assert!(nested.len == 7)

    var eight = Trace::new()
    assert!(<(u8, u16, u32, u64, i8, i16, i32, i64) as Describe>::describe(mut eight).is_ok())
    let order: [usize; 10] = [108, 8, 16, 32, 64, 8, 16, 32, 64, 208]
    index = 0
    while index < 10 {
        assert!(eight.events[index] == order[index])
        index += 1
    }
    assert!(eight.len == 10)
}

#[test]
fn describers_reject_tuples_unless_they_opt_in() {
    var plain = NoTuples {}
    assert!(kind(plain.begin_tuple(2)) == 16)
    assert!(kind(plain.end_tuple(2)) == 16)
    assert!(kind(<(u8, bool) as Describe>::describe(mut plain)) == 16)
    assert!(kind(<[(u8, u8); 2] as Describe>::describe(mut plain)) == 16)
}

/// A codec that writes a `u64` as eight bytes of text, and describes itself as that text.
struct Described {}

impl FieldCodec<u64> for Described {
    fn serialize<E: Encoder>(_ value: u64, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_unsigned(value, 64)
    }

    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<u64> {
        decoder.read_unsigned(64)
    }

    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.text(8)
    }
}

/// A codec that leaves `describe` at its default.
struct Silent {}

impl FieldCodec<u64> for Silent {
    fn serialize<E: Encoder>(_ value: u64, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_unsigned(value, 64)
    }

    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<u64> {
        decoder.read_unsigned(64)
    }
}

#[test]
fn field_codecs_describe_themselves_inside_an_option() {
    var plain = Trace::new()
    assert!(<Described as FieldCodec<u64>>::describe(mut plain).is_ok())
    assert!(plain.len == 1 && plain.events[0] == 508)

    var optional = Trace::new()
    assert!(describe_optional_with<Described, u64, Trace>(mut optional).is_ok())
    assert!(optional.len == 3 && optional.events[0] == 300 && optional.events[1] == 508 && optional.events[2] == 400)
}

#[test]
fn field_codecs_do_not_describe_themselves_unless_they_opt_in() {
    var plain = Trace::new()
    assert!(kind(<Silent as FieldCodec<u64>>::describe(mut plain)) == 16)
    assert!(plain.len == 0)

    // The option is opened before the codec fails, and is not closed.
    var optional = Trace::new()
    assert!(kind(describe_optional_with<Silent, u64, Trace>(mut optional)) == 16)
    assert!(optional.len == 1 && optional.events[0] == 300)
}

/// A record schema that does not opt in to skipping.
struct Plain {}

impl Schema for Plain {
    fn name() -> ingot::SchemaName {
        schema_name<5>("Plain")
    }
}

/// One that does.
struct Tolerant {}

impl Schema for Tolerant {
    fn name() -> ingot::SchemaName {
        schema_name<8>("Tolerant")
    }

    fn skips_unknown_fields() -> bool {
        true
    }
}

#[test]
fn schemas_reject_unknown_fields_unless_they_opt_in() {
    assert!(!Plain::skips_unknown_fields())
    assert!(Tolerant::skips_unknown_fields())
}

/// Bytes that `Utf8` accepts, ending at a character boundary.
fn utf8_valid<const N: usize>(_ bytes: [u8; N]) -> bool {
    var utf8 = Utf8::new()
    var index: usize = 0
    while index < N {
        if utf8.push(bytes[index], index).is_err() {
            return false
        }
        index += 1
    }
    utf8.finish(N).is_ok()
}

#[test]
fn utf8_validates_text_that_is_not_stored() {
    assert!(utf8_valid([0x61, 0xc3, 0xa9, 0xe2, 0x82, 0xac, 0xf0, 0x9f, 0x98, 0x80, 0x00]))
    assert!(!utf8_valid([0xc3, 0x28]))
    assert!(!utf8_valid([0xc0, 0x80]))
    assert!(!utf8_valid([0xed, 0xa0, 0x80]))
    assert!(!utf8_valid([0xf4, 0x90, 0x80, 0x80]))
    // Ending inside a sequence fails at `finish`, with the offset it is given.
    assert!(!utf8_valid([0x61, 0xe2, 0x82]))
    var utf8 = Utf8::new()
    assert!(utf8.push(0xe2, 0).is_ok())
    invalid(utf8.finish(7), 7)
    invalid(utf8.push(0x28, 5), 5)
}

fn fails_with<T>(_ result: own CodecResult<T>, _ expected: ErrorKind, _ offset: usize) {
    match result {
        Result::Err(error) => assert!(error.kind == expected && error.offset == offset),
        Result::Ok(_) => assert!(false),
    }
}

#[test]
fn lists_hold_up_to_their_capacity() {
    var list = List<u16, 3>::new()
    assert!(list.is_empty() && list.len() == 0 && list.capacity() == 3)
    assert!(list.get(0).is_none())
    assert!(list.push(7).is_ok() && list.push(8).is_ok())
    assert!(!list.is_empty() && list.len() == 2)
    assert!(list.get(0) == Option::Some(7) && list.get(1) == Option::Some(8))
    assert!(list.get(2).is_none())
    assert!(list.push(9).is_ok() && list.len() == 3)
    // A full list rejects another element at offset N and keeps its contents.
    fails_with(list.push(10), ErrorKind::CapacityExceeded, 3)
    assert!(list.len() == 3 && list.get(2) == Option::Some(9) && list.get(3).is_none())
}

#[test]
fn lists_are_built_from_arrays_that_fit() {
    let partial = List<u8, 4>::from_array([1, 2]).unwrap()
    assert!(partial.len() == 2 && partial.get(1) == Option::Some(2) && partial.get(2).is_none())
    let full = List<u8, 2>::from_array([1, 2]).unwrap()
    assert!(full.len() == 2)
    let empty = List<u8, 2>::from_array([0; 0]).unwrap()
    assert!(empty.is_empty())
    fails_with(List<u8, 2>::from_array([1, 2, 3]), ErrorKind::CapacityExceeded, 2)
    // A list with no capacity holds nothing.
    assert!(List<u8, 0>::new().is_empty() && List<u8, 0>::from_array([0; 0]).is_ok())
    fails_with(List<u8, 0>::new().push(1), ErrorKind::CapacityExceeded, 0)
}

#[test]
fn lists_compare_by_their_elements() {
    let a = List<u32, 4>::from_array([1, 2, 3]).unwrap()
    let b = List<u32, 4>::from_array([1, 2, 3]).unwrap()
    assert!(a == b)
    assert!(a != List<u32, 4>::from_array([1, 2]).unwrap())
    assert!(a != List<u32, 4>::from_array([1, 2, 4]).unwrap())
    assert!(List<u32, 4>::new() == List<u32, 4>::new())
    // A list built by pushes equals one built from an array.
    var pushed = List<u32, 4>::new()
    assert!(pushed.push(1).is_ok() && pushed.push(2).is_ok() && pushed.push(3).is_ok())
    assert!(pushed == a)
}

#[test]
fn lists_are_copied_by_value() {
    var original = List<u8, 3>::from_array([1]).unwrap()
    var copy = original
    assert!(copy.push(2).is_ok())
    assert!(original.len() == 1 && copy.len() == 2)
}

#[test]
fn lists_describe_their_element_type_between_list_calls() {
    var flat = Trace::new()
    assert!(<List<u8, 5> as Describe>::describe(mut flat).is_ok())
    assert!(flat.len == 3 && flat.events[0] == 605 && flat.events[1] == 8 && flat.events[2] == 705)

    var nested = Trace::new()
    assert!(<List<(bool, u16), 2> as Describe>::describe(mut nested).is_ok())
    let expected: [usize; 6] = [602, 102, 1, 16, 202, 702]
    var index: usize = 0
    while index < 6 {
        assert!(nested.events[index] == expected[index])
        index += 1
    }
    assert!(nested.len == 6)
}

#[test]
fn describers_reject_lists_unless_they_opt_in() {
    var plain = NoTuples {}
    assert!(kind(plain.begin_list(2)) == 16)
    assert!(kind(plain.end_list(2)) == 16)
    assert!(kind(<List<u8, 2> as Describe>::describe(mut plain)) == 16)
    assert!(kind(<[List<u8, 2>; 2] as Describe>::describe(mut plain)) == 16)
}

/// An encoder that leaves `begin_list` at its default and records the length `begin_sequence`
/// is given.
struct Counting { sequence_length: usize }

impl Encoder for Counting {
    const OMIT_NONE: bool = false
    type Record = Frame
    type Sequence = Frame

    fn offset(self) -> usize {
        0
    }

    fn write_bool(mut self, _ value: bool) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_unsigned(mut self, _ value: u64, _ bits: u16) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_signed(mut self, _ value: i64, _ bits: u16) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_wide_unsigned(mut self, _ value: u256, _ bits: u16) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_wide_signed(mut self, _ value: i256, _ bits: u16) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_text<const N: usize>(mut self, _ value: Text<N>) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_bytes<const N: usize>(mut self, _ value: BoundedBuffer<N>) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_fixed_bytes<const N: usize>(mut self, _ value: core::bytes::PackedBytes<N>) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_address(mut self, _ value: std::evm::Address) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_none(mut self) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_some(mut self) -> CodecResult<()> {
        Result::Ok(())
    }

    fn write_variant<V: Schema>(mut self, _ index: usize) -> CodecResult<()> {
        Result::Ok(())
    }

    fn begin_record<R: Schema>(mut self, _ present: usize) -> CodecResult<Frame> {
        Result::Ok(Frame::new(present))
    }

    fn field<R: Schema>(mut self, _ record: mut Frame, _ position: usize) -> CodecResult<()> {
        Result::Ok(())
    }

    fn end_record(mut self, _ record: own Frame) -> CodecResult<()> {
        Result::Ok(())
    }

    fn begin_sequence(mut self, _ length: usize) -> CodecResult<Frame> {
        self.sequence_length = length
        Result::Ok(Frame::new(length))
    }

    fn element(mut self, _ sequence: mut Frame) -> CodecResult<()> {
        sequence.take(0)
    }

    fn end_sequence(mut self, _ sequence: own Frame) -> CodecResult<()> {
        sequence.complete(0)
    }
}

#[test]
fn encoders_write_lists_as_sequences_unless_they_say_otherwise() {
    var encoder = Counting { sequence_length: 99 }
    let list = List<u8, 5>::from_array([4, 5, 6]).unwrap()
    assert!(list.serialize(mut encoder).is_ok())
    assert!(encoder.sequence_length == 3)
    assert!(List<u8, 5>::new().serialize(mut encoder).is_ok())
    assert!(encoder.sequence_length == 0)
}

/// A decoder that leaves the list methods at their defaults.
struct NoLists { at: usize }

impl Decoder for NoLists {
    type Record = Frame
    type Sequence = Frame

    fn offset(self) -> usize {
        self.at
    }

    fn read_bool(mut self) -> CodecResult<bool> {
        Result::Ok(false)
    }

    fn read_unsigned(mut self, _ bits: u16) -> CodecResult<u64> {
        Result::Ok(0)
    }

    fn read_signed(mut self, _ bits: u16) -> CodecResult<i64> {
        Result::Ok(0)
    }

    fn read_wide_unsigned(mut self, _ bits: u16) -> CodecResult<u256> {
        Result::Ok(0)
    }

    fn read_wide_signed(mut self, _ bits: u16) -> CodecResult<i256> {
        Result::Ok(0)
    }

    fn read_text<const N: usize>(mut self) -> CodecResult<Text<N>> {
        Text<N>::from_array([0; 0])
    }

    fn read_bytes<const N: usize>(mut self) -> CodecResult<BoundedBuffer<N>> {
        Result::Ok(BoundedBuffer<N>::empty())
    }

    fn read_fixed_bytes<const N: usize>(mut self) -> CodecResult<core::bytes::PackedBytes<N>> {
        Result::Ok(core::bytes::PackedBytes<N>::from_array([0; N]))
    }

    fn read_address(mut self) -> CodecResult<std::evm::Address> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: self.at))
    }

    fn read_some(mut self) -> CodecResult<bool> {
        Result::Ok(false)
    }

    fn read_variant<V: Schema>(mut self) -> CodecResult<usize> {
        Result::Ok(0)
    }

    fn begin_record<R: Schema>(mut self) -> CodecResult<Frame> {
        Result::Ok(Frame::new(0))
    }

    fn next_field<R: Schema>(mut self, _ record: mut Frame) -> CodecResult<Option<ingot::FieldKey>> {
        Result::Ok(Option::None)
    }

    fn end_record(mut self, _ record: own Frame) -> CodecResult<()> {
        Result::Ok(())
    }

    fn begin_sequence(mut self, _ length: usize) -> CodecResult<Frame> {
        Result::Ok(Frame::new(length))
    }

    fn element(mut self, _ sequence: mut Frame) -> CodecResult<()> {
        Result::Ok(())
    }

    fn end_sequence(mut self, _ sequence: own Frame) -> CodecResult<()> {
        Result::Ok(())
    }
}

#[test]
fn decoders_reject_lists_unless_they_opt_in() {
    var decoder = NoLists { at: 6 }
    fails_with(decoder.begin_list(4), ErrorKind::Unsupported, 6)
    var sequence = Frame::new(0)
    fails_with(decoder.next_element(mut sequence), ErrorKind::Unsupported, 6)
    fails_with(List<u8, 4>::deserialize(mut decoder), ErrorKind::Unsupported, 6)
}
