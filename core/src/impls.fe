        encoder.write_unsigned(self as u64, 32)
    }
}

impl Deserialize for u32 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        narrow(decoder.read_unsigned(32), decoder.offset())
    }
}

impl Serialize for u64 {
