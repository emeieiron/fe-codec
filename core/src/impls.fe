use core::bytes::PackedBytes
use core::marker::Copy
use core::num::IntDowncast
use fe_codec_io::BoundedBuffer
use ingot::error::{CodecError, CodecResult, ErrorKind}
use ingot::serializer::{Decoder, Deserialize, Encoder, Serialize}
use ingot::text::Text
use std::evm::Address

// Integers narrower than 64 bits travel as `u64`/`i64`, wider ones as `u256`/`i256`. Every
// decoded value is range-checked again here, so a format that skips its own check cannot
// produce a wrapped value. `usize` and `isize` have no impls: their width differs per target.

impl Serialize for bool {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_bool(self)
    }
}

impl Deserialize for bool {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        decoder.read_bool()
    }
}

impl Serialize for u8 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_unsigned(self as u64, 8)
    }
}

impl Deserialize for u8 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        narrow(decoder.read_unsigned(8), decoder.offset())
    }
}

impl Serialize for u16 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_unsigned(self as u64, 16)
    }
}

impl Deserialize for u16 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        narrow(decoder.read_unsigned(16), decoder.offset())
    }
}

impl Serialize for u32 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_unsigned(self as u64, 32)
    }
}

impl Deserialize for u32 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        narrow(decoder.read_unsigned(32), decoder.offset())
    }
}

impl Serialize for u64 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_unsigned(self, 64)
    }
}

impl Deserialize for u64 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        decoder.read_unsigned(64)
    }
}

impl Serialize for i8 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_signed(self as i64, 8)
    }
}

impl Deserialize for i8 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        narrow(decoder.read_signed(8), decoder.offset())
    }
}

impl Serialize for i16 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_signed(self as i64, 16)
    }
}

impl Deserialize for i16 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        narrow(decoder.read_signed(16), decoder.offset())
    }
}

impl Serialize for i32 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_signed(self as i64, 32)
    }
}

impl Deserialize for i32 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        narrow(decoder.read_signed(32), decoder.offset())
    }
}

impl Serialize for i64 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_signed(self, 64)
    }
}

impl Deserialize for i64 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        decoder.read_signed(64)
    }
}

impl Serialize for u128 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_wide_unsigned(self as u256, 128)
    }
}

impl Deserialize for u128 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        narrow(decoder.read_wide_unsigned(128), decoder.offset())
    }
}

impl Serialize for u256 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_wide_unsigned(self, 256)
    }
}

impl Deserialize for u256 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        decoder.read_wide_unsigned(256)
    }
}

impl Serialize for i128 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_wide_signed(self as i256, 128)
    }
}

impl Deserialize for i128 {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        narrow(decoder.read_wide_signed(128), decoder.offset())
    }
}

impl Serialize for i256 {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_wide_signed(self, 256)
    }
