}

impl<T0: Deserialize, T1: Deserialize, T2: Deserialize> Deserialize for (T0, T1, T2) {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        var sequence = decoder.begin_sequence(3)?
        decoder.element(mut sequence)?
        let e0 = T0::deserialize(mut decoder)?
        decoder.element(mut sequence)?
        let e1 = T1::deserialize(mut decoder)?
        decoder.element(mut sequence)?
        let e2 = T2::deserialize(mut decoder)?
