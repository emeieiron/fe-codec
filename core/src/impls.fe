fn narrow<S: IntDowncast<T>, T>(_ value: own CodecResult<S>, _ offset: usize) -> CodecResult<T> {
    match value?.downcast() {
        Option::Some(narrowed) => Result::Ok(narrowed),
        Option::None => Result::Err(CodecError::at(kind: ErrorKind::IntegerOutOfRange, offset)),
    }
}

impl<const N: usize> Serialize for Text<N> {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_text(self)
    }
}

impl<const N: usize> Deserialize for Text<N> {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        decoder.read_text<N>()
    }
}

/// A byte string of at most `N` bytes.
impl<const N: usize> Serialize for BoundedBuffer<N> {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_bytes(self)
    }
}

impl<const N: usize> Deserialize for BoundedBuffer<N> {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        decoder.read_bytes<N>()
    }
}

/// A byte string of exactly `N` bytes.
impl<const N: usize> Serialize for PackedBytes<N> {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_fixed_bytes(self)
    }
}

impl<const N: usize> Deserialize for PackedBytes<N> {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        decoder.read_fixed_bytes<N>()
    }
}

/// An EVM address.
impl Serialize for Address {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        encoder.write_address(self)
    }
}

impl Deserialize for Address {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        decoder.read_address()
    }
}

/// `None` and `Some` as the format represents optional values. `Option<Option<T>>` does not
/// round-trip in formats that write `None` as null, so the generator rejects it.
impl<T: Serialize> Serialize for Option<T> {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        match self {
            Option::Some(ref value) => {
                encoder.write_some()?
                value.serialize(mut encoder)
            },
            Option::None => encoder.write_none(),
        }
    }
}

impl<T: Deserialize> Deserialize for Option<T> {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        if decoder.read_some()? {
            return Result::Ok(Option::Some(T::deserialize(mut decoder)?))
        }
        Result::Ok(Option::None)
    }
}

/// A fixed-length sequence.
impl<T: Serialize, const N: usize> Serialize for [T; N] {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        var sequence = encoder.begin_sequence(N)?
        for ref element in self {
            encoder.element(mut sequence)?
            element.serialize(mut encoder)?
        }
        encoder.end_sequence(sequence)
    }
}

/// Decoding builds the array from its first element, so elements must be `Copy`, and an
/// empty array cannot be produced generically: `[T; 0]` decodes the empty sequence and then
/// fails with `Unsupported`. Generated serializers decode literal-length arrays, including
/// empty ones and arrays of non-`Copy` records, without this impl.
impl<T: Deserialize + Copy, const N: usize> Deserialize for [T; N] {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        let start = decoder.offset()
        var sequence = decoder.begin_sequence(N)?
        if N == 0 {
            decoder.end_sequence(sequence)?
            return Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: start))
        }
        decoder.element(mut sequence)?
        let first = T::deserialize(mut decoder)?
        var array: [T; N] = [first; N]
        var index: usize = 1
        while index < N {
            decoder.element(mut sequence)?
            array[index] = T::deserialize(mut decoder)?
            index += 1
        }
        decoder.end_sequence(sequence)?
        Result::Ok(array)
    }
}

/// Tuples of 1 to 8 elements are fixed-length sequences of their elements in order, so they
/// need no encoder or decoder methods of their own. Decoding builds each element in turn, so
/// elements need not be `Copy`. The unit type `()` has no impl: it has no wire form.
impl<T0: Serialize> Serialize for (T0,) {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        let (ref e0,) = self
        var sequence = encoder.begin_sequence(1)?
        encoder.element(mut sequence)?
        e0.serialize(mut encoder)?
        encoder.end_sequence(sequence)
    }
}

impl<T0: Deserialize> Deserialize for (T0,) {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        var sequence = decoder.begin_sequence(1)?
        decoder.element(mut sequence)?
        let e0 = T0::deserialize(mut decoder)?
        decoder.end_sequence(sequence)?
        Result::Ok((e0,))
    }
}

impl<T0: Serialize, T1: Serialize> Serialize for (T0, T1) {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        let (ref e0, ref e1) = self
        var sequence = encoder.begin_sequence(2)?
        encoder.element(mut sequence)?
        e0.serialize(mut encoder)?
        encoder.element(mut sequence)?
        e1.serialize(mut encoder)?
        encoder.end_sequence(sequence)
    }
}

impl<T0: Deserialize, T1: Deserialize> Deserialize for (T0, T1) {
    fn deserialize<D: Decoder>(_ decoder: mut D) -> CodecResult<Self> {
        var sequence = decoder.begin_sequence(2)?
        decoder.element(mut sequence)?
        let e0 = T0::deserialize(mut decoder)?
        decoder.element(mut sequence)?
        let e1 = T1::deserialize(mut decoder)?
        decoder.end_sequence(sequence)?
        Result::Ok((e0, e1))
    }
}

impl<T0: Serialize, T1: Serialize, T2: Serialize> Serialize for (T0, T1, T2) {
    fn serialize<E: Encoder>(self, _ encoder: mut E) -> CodecResult<()> {
        let (ref e0, ref e1, ref e2) = self
        var sequence = encoder.begin_sequence(3)?
        encoder.element(mut sequence)?
        e0.serialize(mut encoder)?
        encoder.element(mut sequence)?
        e1.serialize(mut encoder)?
