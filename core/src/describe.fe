use core::bytes::PackedBytes
use fe_codec_io::BoundedBuffer
use ingot::error::{CodecError, CodecResult, ErrorKind}
use ingot::list::List
use ingot::map::{Map, MapKey}
use ingot::schema::Schema
use ingot::text::Text
use std::evm::Address

/// A type's shape, described without a value.
///
/// Formats that hash or print types use it, as EIP-712 does for `encodeType`. A description
/// covers every type a value could contain, including the element type of an empty array.
/// `fe_codec_gen` implements it for `#[serializable]` types. A handwritten serializer needs it
/// only for formats that ask for it.
pub trait Describe {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()>
}

/// The type vocabulary a description is written in, mirroring the `Encoder` data model.
///
/// An option, sequence or list opens, describes its one inner type, and closes. A map opens,
/// describes its key type and then its value type, and closes. A tuple opens,
/// describes each element type in order, and closes. A record opens,
/// then for each field in position order calls `field` and describes the field's type,
/// then closes.
pub trait Describer {
    fn bool(mut self) -> CodecResult<()>
    fn unsigned(mut self, _ bits: u16) -> CodecResult<()>
    fn signed(mut self, _ bits: u16) -> CodecResult<()>
    fn text(mut self, _ capacity: usize) -> CodecResult<()>
    fn bytes(mut self, _ capacity: usize) -> CodecResult<()>
    fn fixed_bytes(mut self, _ length: usize) -> CodecResult<()>
    fn address(mut self) -> CodecResult<()>
    fn begin_option(mut self) -> CodecResult<()>
    fn end_option(mut self) -> CodecResult<()>
    fn begin_sequence(mut self, _ length: usize) -> CodecResult<()>
    fn end_sequence(mut self, _ length: usize) -> CodecResult<()>
    /// A list opens with its capacity, describes its element type, and closes with the same
    /// capacity. A format with no variable-length collections keeps this default.
    fn begin_list(mut self, _ capacity: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }
    fn end_list(mut self, _ capacity: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }
    /// A map opens with its capacity, describes its key type and then its value type, and
    /// closes with the same capacity. A format with no map type keeps this default.
    fn begin_map(mut self, _ capacity: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }
    fn end_map(mut self, _ capacity: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }
    /// A tuple opens with its arity, describes each element type in order, and closes with the
    /// same arity. A format with no tuple type keeps this default.
    fn begin_tuple(mut self, _ length: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }
    fn end_tuple(mut self, _ length: usize) -> CodecResult<()> {
        Result::Err(CodecError::at(kind: ErrorKind::Unsupported, offset: 0))
    }
    fn enumeration<V: Schema>(mut self) -> CodecResult<()>
    fn begin_record<R: Schema>(mut self) -> CodecResult<()>
    fn field<R: Schema>(mut self, _ position: usize) -> CodecResult<()>
    fn end_record<R: Schema>(mut self) -> CodecResult<()>
}

impl Describe for bool {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.bool()
    }
}

impl Describe for u8 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.unsigned(8)
    }
}

impl Describe for u16 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.unsigned(16)
    }
}

impl Describe for u32 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.unsigned(32)
    }
}

impl Describe for u64 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.unsigned(64)
    }
}

impl Describe for u128 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.unsigned(128)
    }
}

impl Describe for u256 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.unsigned(256)
    }
}

impl Describe for i8 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.signed(8)
    }
}

impl Describe for i16 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.signed(16)
    }
}

impl Describe for i32 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.signed(32)
    }
}

impl Describe for i64 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.signed(64)
    }
}

impl Describe for i128 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.signed(128)
    }
}

impl Describe for i256 {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.signed(256)
    }
}

impl<const N: usize> Describe for Text<N> {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.text(N)
    }
}

impl<const N: usize> Describe for BoundedBuffer<N> {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.bytes(N)
    }
}

impl<const N: usize> Describe for PackedBytes<N> {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.fixed_bytes(N)
    }
}

impl Describe for Address {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.address()
    }
}

impl<T: Describe> Describe for Option<T> {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_option()?
        T::describe(mut describer)?
        describer.end_option()
    }
}

impl<T: Describe, const N: usize> Describe for [T; N] {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_sequence(N)?
        T::describe(mut describer)?
        describer.end_sequence(N)
    }
}

impl<T: Describe, const N: usize> Describe for List<T, N> {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_list(N)?
        T::describe(mut describer)?
        describer.end_list(N)
    }
}

impl<K: MapKey, T: Describe, const N: usize> Describe for Map<K, T, N> {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_map(N)?
        K::describe(mut describer)?
        T::describe(mut describer)?
        describer.end_map(N)
    }
}

impl<T0: Describe> Describe for (T0,) {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_tuple(1)?
        T0::describe(mut describer)?
        describer.end_tuple(1)
    }
}

impl<T0: Describe, T1: Describe> Describe for (T0, T1) {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_tuple(2)?
        T0::describe(mut describer)?
        T1::describe(mut describer)?
        describer.end_tuple(2)
    }
}

impl<T0: Describe, T1: Describe, T2: Describe> Describe for (T0, T1, T2) {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_tuple(3)?
        T0::describe(mut describer)?
        T1::describe(mut describer)?
        T2::describe(mut describer)?
        describer.end_tuple(3)
    }
}

impl<T0: Describe, T1: Describe, T2: Describe, T3: Describe> Describe for (T0, T1, T2, T3) {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_tuple(4)?
        T0::describe(mut describer)?
        T1::describe(mut describer)?
        T2::describe(mut describer)?
        T3::describe(mut describer)?
        describer.end_tuple(4)
    }
}

impl<
    T0: Describe,
    T1: Describe,
    T2: Describe,
    T3: Describe,
    T4: Describe,
> Describe for (T0, T1, T2, T3, T4) {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_tuple(5)?
        T0::describe(mut describer)?
        T1::describe(mut describer)?
        T2::describe(mut describer)?
        T3::describe(mut describer)?
        T4::describe(mut describer)?
        describer.end_tuple(5)
    }
}

impl<
    T0: Describe,
    T1: Describe,
    T2: Describe,
    T3: Describe,
    T4: Describe,
    T5: Describe,
> Describe for (T0, T1, T2, T3, T4, T5) {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_tuple(6)?
        T0::describe(mut describer)?
        T1::describe(mut describer)?
        T2::describe(mut describer)?
        T3::describe(mut describer)?
        T4::describe(mut describer)?
        T5::describe(mut describer)?
        describer.end_tuple(6)
    }
}

impl<
    T0: Describe,
    T1: Describe,
    T2: Describe,
    T3: Describe,
    T4: Describe,
    T5: Describe,
    T6: Describe,
> Describe for (T0, T1, T2, T3, T4, T5, T6) {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_tuple(7)?
        T0::describe(mut describer)?
        T1::describe(mut describer)?
        T2::describe(mut describer)?
        T3::describe(mut describer)?
        T4::describe(mut describer)?
        T5::describe(mut describer)?
        T6::describe(mut describer)?
        describer.end_tuple(7)
    }
}

impl<
    T0: Describe,
    T1: Describe,
    T2: Describe,
    T3: Describe,
    T4: Describe,
    T5: Describe,
    T6: Describe,
    T7: Describe,
> Describe for (T0, T1, T2, T3, T4, T5, T6, T7) {
    fn describe<V: Describer>(_ describer: mut V) -> CodecResult<()> {
        describer.begin_tuple(8)?
        T0::describe(mut describer)?
        T1::describe(mut describer)?
        T2::describe(mut describer)?
        T3::describe(mut describer)?
        T4::describe(mut describer)?
        T5::describe(mut describer)?
        T6::describe(mut describer)?
        T7::describe(mut describer)?
        describer.end_tuple(8)
    }
}
