//! Byte-string helpers over `MemBuffer`, which holds every name and message here.
use core::{MemBuffer, MemSpan}

/// A copy of `text`.
pub fn copy(_ text: ref MemBuffer) -> MemBuffer {
    MemBuffer::from_span(text.span())
}

/// Whether the two buffers hold the same bytes.
pub fn same(_ a: ref MemBuffer, _ b: ref MemBuffer) -> bool {
    a.span() == b.span()
}

pub fn contains<const N: usize>(_ text: ref MemBuffer, _ needle: [u8; N]) -> bool {
    if N > text.len() {
        return false
    }
    var start: usize = 0
    while start + N <= text.len() {
        var i: usize = 0
        while i < N && text[start + i] == needle[i] {
            i += 1
        }
        if i == N {
            return true
        }
        start += 1
    }
    false
}

pub fn starts_with<const N: usize>(_ text: ref MemBuffer, _ prefix: [u8; N]) -> bool {
    if N > text.len() {
        return false
    }
    var i: usize = 0
    while i < N {
        if text[i] != prefix[i] {
            return false
        }
        i += 1
    }
    true
}

pub fn ends_with<const N: usize>(_ text: ref MemBuffer, _ suffix: [u8; N]) -> bool {
    if N > text.len() {
        return false
    }
    let offset = text.len() - N
    var i: usize = 0
    while i < N {
        if text[offset + i] != suffix[i] {
            return false
        }
        i += 1
    }
    true
}

/// The bytes of `text` from `from` up to `to`.
pub fn part(_ text: ref MemBuffer, _ from: usize, _ to: usize) -> MemBuffer {
    MemBuffer::from_span(text.slice(offset: from, len: to - from))
}

/// Appends the bytes of `text` to `out`.
pub fn put(_ out: mut MemBuffer, _ text: ref MemBuffer) {
    var i: usize = 0
    while i < text.len() {
        out.push(text[i])
        i += 1
    }
}

/// Whether `bytes` are well-formed UTF-8, as Rust's `str::from_utf8` decides.
pub fn is_utf8(_ bytes: ref MemBuffer) -> bool {
    let len = bytes.len()
    var i: usize = 0
    while i < len {
        let b = bytes[i]
        if b < 0x80 {
            i += 1
        } else if b >= 0xC2 && b <= 0xDF {
            if i + 1 >= len || !is_cont(bytes[i + 1]) {
                return false
            }
            i += 2
        } else if b >= 0xE0 && b <= 0xEF {
            if i + 2 >= len {
                return false
            }
            let b1 = bytes[i + 1]
            var low: u8 = 0x80
            var high: u8 = 0xBF
            if b == 0xE0 {
                low = 0xA0
            } else if b == 0xED {
                high = 0x9F
            }
            if b1 < low || b1 > high || !is_cont(bytes[i + 2]) {
                return false
            }
            i += 3
        } else if b >= 0xF0 && b <= 0xF4 {
            if i + 3 >= len {
                return false
            }
            let b1 = bytes[i + 1]
            var low: u8 = 0x80
            var high: u8 = 0xBF
            if b == 0xF0 {
                low = 0x90
            } else if b == 0xF4 {
                high = 0x8F
            }
            if b1 < low || b1 > high || !is_cont(bytes[i + 2]) || !is_cont(bytes[i + 3]) {
                return false
            }
            i += 4
        } else {
            return false
        }
    }
    true
}

fn is_cont(_ b: u8) -> bool {
    b >= 0x80 && b <= 0xBF
}

/// Whether `text` holds exactly the bytes of `word`.
pub fn is_text<const N: usize>(_ text: ref MemBuffer, _ word: [u8; N]) -> bool {
    text.len() == N && starts_with(text, word)
}
