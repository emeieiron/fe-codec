use ingot::{ArgKind, File, ItemKind, TypeKind, VariantKind, lex, parse}
use core::{MemBuffer, Option, Result}

fn buffer<const N: usize>(_ text: [u8; N]) -> MemBuffer {
    var out = MemBuffer::new(0)
    var i: usize = 0
    while i < N {
        out.push(text[i])
        i += 1
    }
    out
}

fn parsed<const N: usize>(_ text: [u8; N]) -> File {
    match parse(lex(buffer(text))) {
        Result::Ok(file) => file,
        Result::Err(_) => core::panic(),
    }
}

/// The offset of the first syntax error, or `usize::MAX`-like 999999 when there is none.
fn error_offset<const N: usize>(_ text: [u8; N]) -> usize {
    match parse(lex(buffer(text))) {
        Result::Ok(_) => 999999,
        Result::Err(error) => error.offset,
    }
}

fn same<const N: usize>(_ got: MemBuffer, _ want: [u8; N]) -> bool {
    if got.len() != N {
        return false
    }
    var i: usize = 0
    while i < N {
        if got[i] != want[i] {
            return false
        }
        i += 1
    }
    true
}

#[test]
fn item_starts_at_first_attribute_or_doc() {
    let file = parsed("/// doc\n// plain\n\n#[serializable]\n// plain\npub enum E {}")
    assert!(file.items.len() == 1)
    assert!(file.items[0].start == 0)
    let file = parsed("// plain\n\n  #[a]\npub struct S { pub x: u8 }")
    assert!(file.items[0].start == 12)
    let file = parsed("// plain\n\nunsafe impl A for B {}")
    assert!(file.items[0].start == 10)
}

#[test]
fn parses_struct_fields_and_attributes() {
    let file = parsed("#[serializable]\npub struct S<T: A + B, const N: usize = 4> {\n    /// d\n    #[codec_id = 0x10]\n    pub a: [u8; 3],\n    b: Option<Text<8>>,\n}")
    assert!(file.items.len() == 1)
    let model = file.structs[file.items[0].detail]
    assert!(model.mods.is_pub)
    assert!(model.has_generics)
    assert!(model.gparams.len == 2)
    assert!(model.fields.len == 2)
    assert!(model.attrs.len == 1)
    assert!(file.attrs[model.attrs.start].start == 0)
    let a = file.fields[model.fields.start]
    assert!(a.start == 65)
    assert!(a.attrs.len == 1)
    let attr = file.attrs[a.attrs.start]
    match attr.value {
        Option::Some(span) => assert!(file.literal_u64(span) == Option::Some(16)),
        Option::None => assert!(false),
    }
    let ty = file.types[a.ty]
    match ty.kind {
        TypeKind::Array => {},
        _ => assert!(false),
    }
    let b = file.fields[model.fields.start + 1]
    assert!(same(file.type_text(b.ty), "Option<Text<8>>"))
    match file.path_name(b.ty) {
        Option::Some(name) => assert!(same(name, "Option")),
        Option::None => assert!(false),
    }
    let node = file.types[b.ty]
    let last = file.segments[node.segments.start + node.segments.len - 1]
    match last.args {
        Option::Some(args) => {
            assert!(args.len == 1)
            match file.args[args.start].kind {
                ArgKind::Type => {},
                _ => assert!(false),
            }
        },
        Option::None => assert!(false),
    }
}

#[test]
fn classifies_generic_arguments() {
    let file = parsed("struct S { a: F<8, f(2), ref, K = u8, u8> }")
    let model = file.structs[file.items[0].detail]
    let a = file.fields[model.fields.start]
    let node = file.types[a.ty]
    let args = file.segments[node.segments.start].args.unwrap()
    assert!(args.len == 5)
    match file.args[args.start].kind {
        ArgKind::Const => {},
        _ => assert!(false),
    }
    match file.args[args.start + 1].kind {
        ArgKind::Const => {},
        _ => assert!(false),
    }
    match file.args[args.start + 2].kind {
        ArgKind::Other => {},
        _ => assert!(false),
    }
    match file.args[args.start + 3].kind {
        ArgKind::Other => {},
        _ => assert!(false),
    }
    match file.args[args.start + 4].kind {
        ArgKind::Type => {},
        _ => assert!(false),
    }
}

/// The number of elements of tuple type `ty`, or 999 when it is not a tuple.
fn tuple_len(_ file: File, _ ty: usize) -> usize {
    let node = file.types[ty]
    match node.kind {
        TypeKind::Tuple => node.elems.len,
        _ => 999,
    }
}

/// The type node of element `index` of tuple type `ty`.
fn tuple_elem(_ file: File, _ ty: usize, _ index: usize) -> usize {
    file.elems[file.types[ty].elems.start + index]
}

#[test]
fn records_tuple_element_types() {
    let file = parsed("struct S { a: (), b: (u8), c: (u8,), d: (u8, [u16; 2]), e: ((u8, u16), Option<(u8,)>), f: Option<(u8, u8)>, g: [(u8, u8); 3] }")
    let model = file.structs[file.items[0].detail]
    assert!(model.fields.len == 7)
    let a = file.fields[model.fields.start].ty
    let b = file.fields[model.fields.start + 1].ty
    let c = file.fields[model.fields.start + 2].ty
    let d = file.fields[model.fields.start + 3].ty
    let e = file.fields[model.fields.start + 4].ty
    let f = file.fields[model.fields.start + 5].ty
    let g = file.fields[model.fields.start + 6].ty
    // `()` has no elements. fe check reads `(T)` as the one-tuple `(T,)`, and so does the parser.
    assert!(tuple_len(file, a) == 0)
    assert!(tuple_len(file, b) == 1 && tuple_len(file, c) == 1)
    assert!(same(file.type_text(tuple_elem(file, b, 0)), "u8"))
    assert!(same(file.type_text(tuple_elem(file, c, 0)), "u8"))
    assert!(same(file.type_text(c), "(u8,)"))
    assert!(tuple_len(file, d) == 2)
    assert!(same(file.type_text(tuple_elem(file, d, 0)), "u8"))
    assert!(same(file.type_text(tuple_elem(file, d, 1)), "[u16; 2]"))
    match file.types[tuple_elem(file, d, 1)].kind {
        TypeKind::Array => {},
        _ => assert!(false),
    }
    // Nested tuples keep their own elements, in order.
    assert!(tuple_len(file, e) == 2)
    let inner = tuple_elem(file, e, 0)
    assert!(tuple_len(file, inner) == 2)
    assert!(same(file.type_text(tuple_elem(file, inner, 0)), "u8"))
    assert!(same(file.type_text(tuple_elem(file, inner, 1)), "u16"))
    let option = tuple_elem(file, e, 1)
    assert!(same(file.type_text(option), "Option<(u8,)>"))
    let argument = file.args[file.segments[file.types[option].segments.start].args.unwrap().start]
    let one = argument.ty.unwrap()
    assert!(tuple_len(file, one) == 1)
    assert!(same(file.type_text(tuple_elem(file, one, 0)), "u8"))
    // Tuples as generic arguments and array elements.
    let argument = file.args[file.segments[file.types[f].segments.start].args.unwrap().start]
    assert!(tuple_len(file, argument.ty.unwrap()) == 2)
    let element = file.types[g].elem.unwrap()
    assert!(tuple_len(file, element) == 2)
    // Other types have no elements.
    assert!(file.types[file.fields[model.fields.start].ty].elems.len == 0)
    assert!(tuple_len(file, element) == 2 && file.types[g].elems.len == 0)
}

#[test]
fn records_tuple_variant_elements_and_record_variant_fields() {
    let file = parsed("enum E {\n    A,\n    B(),\n    C(u8),\n    D(u8, [u16; 2], (bool, Option<u8>),),\n    F { x: u8, y: (u8, u8) },\n    G(Text<8>),\n}")
    let model = file.enums[file.items[0].detail]
    assert!(model.variants.len == 6)
    let start = model.variants.start
    // Only a tuple variant has elements, and only a record variant has fields.
    assert!(file.variants[start].elems.len == 0 && file.variants[start].fields.len == 0)
    assert!(file.variants[start + 1].elems.len == 0)
    match file.variants[start + 1].kind {
        VariantKind::Tuple => {},
        _ => assert!(false),
    }
    assert!(file.variants[start + 2].elems.len == 1)
    assert!(same(file.type_text(file.elems[file.variants[start + 2].elems.start]), "u8"))
    let triple = file.variants[start + 3].elems
    assert!(triple.len == 3 && file.variants[start + 3].fields.len == 0)
    assert!(same(file.type_text(file.elems[triple.start]), "u8"))
    assert!(same(file.type_text(file.elems[triple.start + 1]), "[u16; 2]"))
    // A tuple element keeps its own elements, which come after the variant's own.
    let nested = file.elems[triple.start + 2]
    assert!(tuple_len(file, nested) == 2)
    assert!(same(file.type_text(tuple_elem(file, nested, 1)), "Option<u8>"))
    // A record variant's fields are fields, with types and no elements.
    let record = file.variants[start + 4]
    assert!(record.elems.len == 0 && record.fields.len == 2)
    assert!(same(file.token_text(file.fields[record.fields.start + 1].name.unwrap()), "y"))
    assert!(tuple_len(file, file.fields[record.fields.start + 1].ty) == 2)
    // Elements are per variant, in declaration order.
    assert!(same(file.type_text(file.elems[file.variants[start + 5].elems.start]), "Text<8>"))
}

#[test]
fn rejects_malformed_tuple_variants() {
    assert!(error_offset("enum E { A(u8 u8) }") != 999999)
    assert!(error_offset("enum E { A(u8,, u8) }") != 999999)
    assert!(error_offset("enum E { A(u8, u8 }") != 999999)
    assert!(error_offset("enum E { A(u8,) }") == 999999)
}

#[test]
fn rejects_malformed_tuple_types() {
    assert!(error_offset("struct S { a: (u8 u8) }") != 999999)
    assert!(error_offset("struct S { a: (u8,, u8) }") != 999999)
    assert!(error_offset("struct S { a: (u8, ) }") == 999999)
    assert!(error_offset("struct S { a: (u8, u8 }") != 999999)
}

#[test]
fn skips_other_items_and_reads_impl_headers() {
    let file = parsed("fn f<const N: usize>(x: [u8; N]) -> u8 where N > 0 {\n    if x { 1 } else { 2 }\n}\nconst X: u8 =\n    1 + 2\nimpl<T> Eq for Foo<T> where T: Eq {}\nimpl Foo {}\nstruct S { a: u8 }")
    assert!(file.items.len() == 5)
    match file.items[0].kind {
        ItemKind::Other => {},
        _ => assert!(false),
    }
    match file.items[2].kind {
        ItemKind::ImplTrait => {},
        _ => assert!(false),
    }
    let implementation = file.impls[file.items[2].detail]
    assert!(same(file.compact(implementation.trait_ref), "Eq"))
    match file.path_name(implementation.ty) {
        Option::Some(name) => assert!(same(name, "Foo")),
        Option::None => assert!(false),
    }
    match file.items[3].kind {
        ItemKind::Other => {},
        _ => assert!(false),
    }
    match file.items[4].kind {
        ItemKind::Struct => {},
        _ => assert!(false),
    }
}

#[test]
fn parses_enums_and_use_trees() {
    let file = parsed("use a::{b, c as d, *}\nenum E {\n    A,\n    /// doc\n    B(u8),\n    C { x: u8 },\n}")
    assert!(file.items.len() == 2)
    let tree = file.use_items[file.items[0].detail].tree
    assert!(same(file.compact(tree), "a::{b, c as d, *}"))
    let model = file.enums[file.items[1].detail]
    assert!(model.variants.len == 3)
    assert!(file.variants[model.variants.start + 1].start == 42)
}

#[test]
fn reports_syntax_errors_where_fe_check_does() {
    // A block comment is not a token.
    assert!(error_offset("/* c */\nstruct S {}") == 0)
    // An attribute followed by its field on the same line: right after the attribute.
    assert!(error_offset("struct S {\n    #[a] pub x: u8,\n}") == 19)
    // A plain comment between a field's attribute and the field.
    assert!(error_offset("struct S {\n    #[a]\n    // c\n    pub x: u8,\n}") == 20)
    // Fields need commas.
    assert!(error_offset("struct S {\n    pub a: u8\n    pub b: u8,\n}") == 24)
    // The type is missing: right after the colon.
    assert!(error_offset("struct S {\n    pub id: ,\n}") == 22)
    // The name is missing: right after `struct`.
    assert!(error_offset("pub struct {\n}") == 10)
    // A stray token between items starts there.
    assert!(error_offset("struct S {}\n@") == 12)
    // The end of input, unclosed.
    assert!(error_offset("struct S {\n    pub id: u8") == 25)
}

/// `fe check` does not recover from errors, so each error sits at fe-parser's `current_pos`:
/// the end of the last token consumed, before any blanks that follow it. Every offset here
/// was confirmed with `fe check`.
#[test]
fn reports_the_end_of_the_previous_token() {
    // Input ends right after a body's `{`, or after a comma: used to crash the parser.
    assert!(error_offset("struct S {") == 10)
    assert!(error_offset("enum E {\n") == 9)
    assert!(error_offset("struct S {\n    pub a: u8,") == 25)
    // The offending token follows blanks: the error is where the blanks start.
    assert!(error_offset("struct S { a u8 }") == 12)
    assert!(error_offset("pub  A") == 3)
    assert!(error_offset("struct S<T T>{}") == 10)
    // Attribute values and arguments end where an expression would.
    assert!(error_offset("#[a = 1 b]\nstruct S {}") == 7)
    assert!(error_offset("#[a(b c)]\nstruct S {}") == 5)
    assert!(error_offset("struct S { a: [u8; 2 3] }") == 20)
    // A `<` that does not start `<T as Trait>` is an ordinary path segment.
    assert!(error_offset("struct S { a: <T }") == 15)
    assert!(error_offset("struct S { a: Option<<T }") == 22)
    // Generic arguments that do not parse are left for the caller to report; an attribute
    // path has no such caller.
    assert!(error_offset("#[a<b]\nstruct S {}") == 3)
    assert!(error_offset("struct S { a: core::<u8> }") == 18)
    // A turbofish is only one when the `<` touches the `::`.
    assert!(error_offset("struct S { a: core:: <u8> }") == 22)
    // A character is one column but several bytes; the offset stays a byte offset.
    assert!(error_offset("struct S { a: é }") == 13)
}

/// Newlines are trivia at the start of a path segment and inside a bound list.
#[test]
fn accepts_newlines_where_fe_parser_does() {
    assert!(error_offset("struct S { a:\n    u8 }") == 999999)
    assert!(error_offset("struct S<T: A\n + B> {}") == 999999)
    // After a field's colon, after `[` of an array type, after a bound's colon, after a const
    // parameter's colon, and after `#[`.
    assert!(error_offset("pub struct A { pub x:\nu8 }") == 999999)
    assert!(error_offset("pub struct A { pub x: [\nu8; 2] }") == 999999)
    assert!(error_offset("pub struct A<T:\nCopy> { pub x: T }") == 999999)
    assert!(error_offset("pub struct A<const N:\nusize> { pub x: [u8; N] }") == 999999)
    assert!(error_offset("#[\nserializable]\npub struct A { pub x: u8 }") == 999999)
    // Not trivia: before a field's colon, after `;` in an array type, after `use a::`.
    assert!(error_offset("pub struct A { pub x\n: u8 }") == 20)
    assert!(error_offset("pub struct A { pub x: [u8;\n2] }") == 26)
    assert!(error_offset("use a::\nb\n") == 8)
}
