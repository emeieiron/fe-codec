//! Renders `Schema`, `Serialize` and `Deserialize` impls as ordinary Fe source.
//!
//! The output has the shape a handwritten impl would have, uses only the public
//! `fe_codec_core` API, and depends on nothing but its inputs, so the same sources always
//! produce the same bytes.
use core::{MemBuffer, MemVec}
use fe_syntax::File
use ingot::schema::{Field, Generic, Model, Output, Payload, Program, Variant, codec_path, marker_name}

pub fn header() -> MemBuffer {
    format!("// Generated by fe_codec_gen. Do not edit.\n")
}

/// The generated module's imports: everything its sources declare and import, so field types
/// resolve as they do there.
pub fn imports(_ out: mut MemBuffer, _ output: ref Output) {
    var i: usize = 0
    while i < output.modules.len() {
        write!(mut out, "use ingot::", output.modules[i], "::*\n")
        i += 1
    }
    i = 0
    while i < output.use_items.len() {
        write!(mut out, output.use_items[i], "\n")
        i += 1
    }
}

pub fn render(_ program: ref Program, _ output: ref Output) -> MemBuffer {
    var out = header()
    imports(mut out, output)
    write!(mut out, "use fe_codec_core::{Serialize as _, Deserialize as _}\n")
    var helpers: usize = 0
    var m: usize = 0
    while m < output.models.len() {
        let model = output.models[m]
        if model.is_record {
            render_record(mut out, program, output, model, mut helpers)
        } else {
            render_enum(mut out, program, output, model, mut helpers)
        }
        m += 1
    }
    out
}

// Which bounds `parameters` adds to each type parameter.
const BOUNDS_NONE: u8 = 0
const BOUNDS_SERIALIZE: u8 = 1
const BOUNDS_DESERIALIZE: u8 = 2
const BOUNDS_DESCRIBE: u8 = 3

/// `<T: bound + ..., const N: usize>` with the bounds `mode` names added to each type
/// parameter's. With `decoder`, `CodecDecoder: fe_codec_core::Decoder` is added last.
fn parameters(
    _ out: mut MemBuffer,
    _ file: ref File,
    _ output: ref Output,
    _ model: Model,
    _ mode: u8,
    _ decoder: bool,
) {
    if model.generics.len == 0 && !decoder {
        return
    }
    out.push(b'<')
    var i: usize = 0
    while i < model.generics.len {
        let generic = output.generics[model.generics.start + i]
        if i > 0 {
            write!(mut out, ", ")
        }
        if generic.is_const {
            write!(mut out, "const ", file.token_text(generic.name), ": ")
            match generic.ty {
                Option::Some(ty) => write!(mut out, file.type_text(ty)),
                Option::None => {},
            }
        } else {
            write!(mut out, file.token_text(generic.name))
            var count: usize = 0
            if mode == BOUNDS_SERIALIZE {
                write!(mut out, ": fe_codec_core::Serialize")
                count += 1
            } else if mode == BOUNDS_DESERIALIZE {
                write!(mut out, ": fe_codec_core::Deserialize")
                count += 1
                if generic.copy {
                    write!(mut out, " + Copy")
                }
            } else if mode == BOUNDS_DESCRIBE {
                write!(mut out, ": fe_codec_core::Describe")
                count += 1
            }
            match generic.bounds {
                Option::Some(span) => {
                    if count == 0 {
                        write!(mut out, ": ")
                    } else {
                        write!(mut out, " + ")
                    }
                    write!(mut out, file.compact(span))
                },
                Option::None => {},
            }
        }
        i += 1
    }
    if decoder {
        if model.generics.len > 0 {
            write!(mut out, ", ")
        }
        write!(mut out, "CodecDecoder: fe_codec_core::Decoder")
    }
    out.push(b'>')
}

fn self_type(_ out: mut MemBuffer, _ file: ref File, _ output: ref Output, _ model: Model) {
    write!(mut out, file.token_text(model.name))
    if model.generics.len == 0 {
        return
    }
    out.push(b'<')
    var i: usize = 0
    while i < model.generics.len {
        if i > 0 {
            write!(mut out, ", ")
        }
        write!(mut out, file.token_text(output.generics[model.generics.start + i].name))
        i += 1
    }
    out.push(b'>')
}

fn name_literal(_ out: mut MemBuffer, _ name: ref MemBuffer) {
    write!(mut out, "fe_codec_core::schema_name<", name.len(), ">(\"", name, "\")")
}

/// `count` spaces.
fn pad(_ out: mut MemBuffer, _ count: usize) {
    var spaces: usize = 0
    while spaces < count {
        out.push(b' ')
        spaces += 1
    }
}

/// How the serializer reaches the value of a field: `self.name` in a struct, and the variable
/// `field_N` that the pattern of a record variant binds to it.
fn access(_ file: ref File, _ field: Field, _ position: usize, _ variant: bool) -> MemBuffer {
    if variant {
        format!("field_", position)
    } else {
        format!("self.", file.token_text(field.name))
    }
}

/// `fn field`, which lists the fields `first..first + count` of `output.fields` by position.
fn render_field_info(_ out: mut MemBuffer, _ file: ref File, _ output: ref Output, _ first: usize, _ count: usize) {
    write!(mut out, "    fn field(_ position: usize) -> Option<fe_codec_core::FieldInfo> {\n")
    if count == 0 {
        write!(mut out, "        Option::None\n")
    } else {
        write!(mut out, "        match position {\n")
        var position: usize = 0
        while position < count {
            let field = output.fields[first + position]
            write!(mut out, "            ", position, " => Option::Some(fe_codec_core::FieldInfo { name: ")
            name_literal(mut out, file.token_text(field.name))
            write!(mut out, ", id: ", field.id, ", optional: ", field.optional, " }),\n")
            position += 1
        }
        write!(mut out, "            _ => Option::None,\n        }\n")
    }
    write!(mut out, "    }\n")
}

/// The statements that open the record of the fields `first..first + count`, of the schema
/// `marker`, and write each present field, at `indent`: counting the present fields,
/// `begin_record`, then `field` and the value of each. The caller closes the record. For the
/// fields of the variant `wrapper` of the enum, the values are the variables `field_N`, and
/// the wrapper is opened before the record; for those of a struct, they are fields of `self`.
fn render_write_fields(
    _ out: mut MemBuffer,
    _ file: ref File,
    _ output: ref Output,
    _ first: usize,
    _ count: usize,
    _ marker: ref MemBuffer,
    _ indent: usize,
    _ wrapper: Option<usize>,
) {
    let variant = wrapper.is_some()
    var required: usize = 0
    var position: usize = 0
    while position < count {
        if !output.fields[first + position].optional {
            required += 1
        }
        position += 1
    }
    pad(mut out, indent)
    if required == count {
        write!(mut out, "let present: usize = ", required, "\n")
    } else {
        write!(mut out, "var present: usize = ", required, "\n")
        position = 0
        while position < count {
            let field = output.fields[first + position]
            if field.optional {
                pad(mut out, indent)
                write!(
                    mut out,
                    "if !CodecEncoder::OMIT_NONE || ",
                    access(file, field, position, variant),
                    ".is_some() {\n",
                )
                pad(mut out, indent + 4)
                write!(mut out, "present += 1\n")
                pad(mut out, indent)
                write!(mut out, "}\n")
            }
            position += 1
        }
    }
    match wrapper {
        Option::Some(index) => {
            pad(mut out, indent)
            write!(mut out, "let variant = encoder.begin_variant<Self>(", index, ")?\n")
        },
        Option::None => {},
    }
    pad(mut out, indent)
    write!(mut out, "var record = encoder.begin_record<", marker, ">(present)?\n")
    position = 0
    while position < count {
        let field = output.fields[first + position]
        if field.optional {
            pad(mut out, indent)
            write!(mut out, "if !CodecEncoder::OMIT_NONE || ", access(file, field, position, variant), ".is_some() {\n")
            pad(mut out, indent + 4)
            write!(mut out, "encoder.field<", marker, ">(mut record, ", position, ")?\n")
            render_write(mut out, file, field, access(file, field, position, variant), indent + 4)
            pad(mut out, indent)
            write!(mut out, "}\n")
        } else {
            pad(mut out, indent)
            write!(mut out, "encoder.field<", marker, ">(mut record, ", position, ")?\n")
            render_write(mut out, file, field, access(file, field, position, variant), indent)
        }
        position += 1
    }
}

/// The statements that read the record of the fields `first..first + count`, of the schema
/// `marker`, at `indent`: a slot for each field, `begin_record`, the fields as they arrive, and
/// `end_record`. Literal-length arrays that decode element by element are recorded in
/// `unrolled`, as pairs of a field's index and the number of its helper function.
fn render_read_fields(
    _ out: mut MemBuffer,
    _ file: ref File,
    _ output: ref Output,
    _ model: Model,
    _ first: usize,
    _ count: usize,
    _ marker: ref MemBuffer,
    _ indent: usize,
    _ helpers: mut usize,
    _ unrolled: mut MemVec<usize>,
) {
    var position: usize = 0
    while position < count {
        let field = output.fields[first + position]
        pad(mut out, indent)
        write!(
            mut out,
            "var field_",
            position,
            ": Option<",
            file.type_text(field.ty),
            "> = Option::None\n",
        )
        position += 1
    }
    pad(mut out, indent)
    write!(mut out, "var record = decoder.begin_record<", marker, ">()?\n")
    pad(mut out, indent)
    write!(mut out, "while let Option::Some(key) = decoder.next_field<", marker, ">(mut record)? {\n")
    pad(mut out, indent + 4)
    write!(mut out, "match key.position {\n")
    position = 0
    while position < count {
        let field = output.fields[first + position]
        pad(mut out, indent + 8)
        if field.codec.is_some() {
            let codec = codec_path(file, field.codec.unwrap()).unwrap()
            write!(mut out, position, " => key.")
            if field.optional {
                write!(mut out, "read_optional_with<")
            } else {
                write!(mut out, "read_with<")
            }
            write!(
                mut out,
                codec,
                ", ",
                file.type_text(field.codec_ty),
                ", CodecDecoder>(mut decoder, mut field_",
                position,
                ")?,\n",
            )
        } else if !field.unrolled {
            write!(mut out, position, " => key.read(mut decoder, mut field_", position, ")?,\n")
        } else {
            let helper = helpers
            helpers += 1
            write!(mut out, position, " => {\n")
            pad(mut out, indent + 12)
            write!(mut out, "if field_", position, ".is_some() {\n")
            pad(mut out, indent + 16)
            write!(
                mut out,
                "return Result::Err(fe_codec_core::CodecError::at(kind: fe_codec_core::ErrorKind::DuplicateField, offset: key.offset).in_field(key.name))\n",
            )
            pad(mut out, indent + 12)
            write!(mut out, "}\n")
            pad(mut out, indent + 12)
            write!(mut out, "field_", position, " = match decode_array_", helper, "<")
            var g: usize = 0
            while g < model.generics.len {
                write!(mut out, file.token_text(output.generics[model.generics.start + g].name), ", ")
                g += 1
            }
            write!(mut out, "CodecDecoder>(mut decoder) {\n")
            pad(mut out, indent + 16)
            write!(mut out, "Result::Ok(value) => Option::Some(value),\n")
            pad(mut out, indent + 16)
            write!(mut out, "Result::Err(error) => return Result::Err(error.in_field(key.name)),\n")
            pad(mut out, indent + 12)
            write!(mut out, "}\n")
            pad(mut out, indent + 8)
            write!(mut out, "},\n")
            unrolled.push(first + position)
            unrolled.push(helper)
        }
        position += 1
    }
    pad(mut out, indent + 8)
    write!(mut out, "_ => return Result::Err(key.unknown()),\n")
    pad(mut out, indent + 4)
    write!(mut out, "}\n")
    pad(mut out, indent)
    write!(mut out, "}\n")
    pad(mut out, indent)
    write!(mut out, "decoder.end_record(record)?\n")
}

/// The value the reader collected for field `position`: an optional field's, or the required
/// one of the schema `marker`, which fails when it is missing.
fn render_field_value(_ out: mut MemBuffer, _ field: Field, _ position: usize, _ marker: ref MemBuffer) {
    if field.optional {
        write!(mut out, "fe_codec_core::optional(field_", position, ")")
    } else {
        write!(
            mut out,
            "<",
            marker,
            " as fe_codec_core::Schema>::required(field_",
            position,
            ", ",
            position,
            ", decoder.offset())?",
        )
    }
}

/// The calls that describe the record of the fields `first..first + count`, of the schema
/// `marker`, at `indent`: `begin_record`, then `field` and the type of each. The caller closes it.
fn render_describe_fields(
    _ out: mut MemBuffer,
    _ file: ref File,
    _ output: ref Output,
    _ first: usize,
    _ count: usize,
    _ marker: ref MemBuffer,
    _ indent: usize,
) {
    pad(mut out, indent)
    write!(mut out, "describer.begin_record<", marker, ">()?\n")
    var position: usize = 0
    while position < count {
        let field = output.fields[first + position]
        pad(mut out, indent)
        write!(mut out, "describer.field<", marker, ">(", position, ")?\n")
        pad(mut out, indent)
        if field.codec.is_some() {
            let codec = codec_path(file, field.codec.unwrap()).unwrap()
            if field.optional {
                write!(
                    mut out,
                    "fe_codec_core::describe_optional_with<",
                    codec,
                    ", ",
                    file.type_text(field.codec_ty),
                    ", CodecDescriber>(mut describer)?\n",
                )
            } else {
                write!(
                    mut out,
                    "<",
                    codec,
                    " as fe_codec_core::FieldCodec<",
                    file.type_text(field.codec_ty),
                    ">>::describe(mut describer)?\n",
                )
            }
        } else {
            write!(mut out, "<", file.type_text(field.ty), " as fe_codec_core::Describe>::describe(mut describer)?\n")
        }
        position += 1
    }
}

fn render_record(
    _ out: mut MemBuffer,
    _ program: ref Program,
    _ output: ref Output,
    _ model: Model,
    _ helpers: mut usize,
) {
    let file = ref program.files[model.source]
    var ty = MemBuffer::new(0)
    self_type(mut ty, file, output, model)
    let first = model.members.start
    let count = model.members.len
    let marker = format!("Self")

    // Schema: fields by ascending ID.
    write!(mut out, "\nimpl")
    parameters(mut out, file, output, model, BOUNDS_NONE, false)
    write!(mut out, " fe_codec_core::Schema for ", ty, " {\n")
    render_name(mut out, file.token_text(model.name))
    render_field_info(mut out, file, output, first, count)
    if model.skip_unknown {
        write!(mut out, "    fn skips_unknown_fields() -> bool {\n        true\n    }\n")
    }
    write!(mut out, "}\n")

    // Serialize: visit present fields in position order.
    write!(mut out, "\nimpl")
    parameters(mut out, file, output, model, BOUNDS_SERIALIZE, false)
    write!(mut out, " fe_codec_core::Serialize for ", ty, " {\n")
    write!(
        mut out,
        "    fn serialize<CodecEncoder: fe_codec_core::Encoder>(self, _ encoder: mut CodecEncoder) -> fe_codec_core::CodecResult<()> {\n",
    )
    render_write_fields(mut out, file, output, first, count, marker, 8, Option::None)
    write!(mut out, "        encoder.end_record(record)\n    }\n}\n")

    // Deserialize: collect each field once, then require the non-optional ones.
    var unrolled = MemVec<usize>::new()
    write!(mut out, "\nimpl")
    parameters(mut out, file, output, model, BOUNDS_DESERIALIZE, false)
    write!(mut out, " fe_codec_core::Deserialize for ", ty, " {\n")
    write!(
        mut out,
        "    fn deserialize<CodecDecoder: fe_codec_core::Decoder>(_ decoder: mut CodecDecoder) -> fe_codec_core::CodecResult<Self> {\n",
    )
    render_read_fields(mut out, file, output, model, first, count, marker, 8, mut helpers, mut unrolled)
    write!(mut out, "        Result::Ok(Self {\n")
    var position: usize = 0
    while position < count {
        let field = output.fields[first + position]
        write!(mut out, "            ", file.token_text(field.name), ": ")
        render_field_value(mut out, field, position, marker)
        write!(mut out, ",\n")
        position += 1
    }
    write!(mut out, "        })\n    }\n}\n")

    var u: usize = 0
    while u < unrolled.len() {
        let field = output.fields[unrolled[u]]
        render_unrolled(mut out, file, output, model, unrolled[u + 1], field.unrolled_element, field.unrolled_length)
        u += 2
    }

    // Describe: the record and each field's type, in position order.
    write!(mut out, "\nimpl")
    parameters(mut out, file, output, model, BOUNDS_DESCRIBE, false)
    write!(mut out, " fe_codec_core::Describe for ", ty, " {\n")
    render_describe_header(mut out)
    render_describe_fields(mut out, file, output, first, count, marker, 8)
    write!(mut out, "        describer.end_record<Self>()\n    }\n}\n")
}

/// The statement that writes `field`'s value, found at `value`, after the `encoder.field` call
/// that announces it: the field's own `serialize`, or its codec's.
fn render_write(_ out: mut MemBuffer, _ file: ref File, _ field: Field, _ value: ref MemBuffer, _ indent: usize) {
    pad(mut out, indent)
    match field.codec {
        Option::Some(span) => {
            let codec = codec_path(file, span).unwrap()
            if field.optional {
                write!(
                    mut out,
                    "fe_codec_core::serialize_optional_with<",
                    codec,
                    ", ",
                    file.type_text(field.codec_ty),
                    ", CodecEncoder>(",
                    value,
                    ", mut encoder)?\n",
                )
            } else {
                write!(
                    mut out,
                    "<",
                    codec,
                    " as fe_codec_core::FieldCodec<",
                    file.type_text(field.codec_ty),
                    ">>::serialize(",
                    value,
                    ", mut encoder)?\n",
                )
            }
        },
        Option::None => {
            write!(mut out, value, ".serialize(mut encoder)?\n")
        },
    }
}

fn render_describe_header(_ out: mut MemBuffer) {
    write!(
        mut out,
        "    fn describe<CodecDescriber: fe_codec_core::Describer>(_ describer: mut CodecDescriber) -> fe_codec_core::CodecResult<()> {\n",
    )
}

fn render_name(_ out: mut MemBuffer, _ name: ref MemBuffer) {
    write!(mut out, "    fn name() -> fe_codec_core::SchemaName { ")
    name_literal(mut out, name)
    write!(mut out, " }\n")
}

/// Decodes a literal-length array element by element, so its elements need not be `Copy`.
fn render_unrolled(
    _ out: mut MemBuffer,
    _ file: ref File,
    _ output: ref Output,
    _ model: Model,
    _ helper: usize,
    _ element: usize,
    _ length: u64,
) {
    write!(mut out, "\nfn decode_array_", helper)
    parameters(mut out, file, output, model, BOUNDS_DESERIALIZE, true)
    write!(
        mut out,
        "(_ decoder: mut CodecDecoder) -> fe_codec_core::CodecResult<[",
        file.type_text(element),
        "; ",
        length,
        "]> {\n",
    )
    write!(mut out, "    var sequence = decoder.begin_sequence(", length, ")?\n")
    var index: u64 = 0
    while index < length {
        write!(mut out, "    decoder.element(mut sequence)?\n")
        write!(
            mut out,
            "    let item_",
            index,
            " = <",
            file.type_text(element),
            " as fe_codec_core::Deserialize>::deserialize(mut decoder)?\n",
        )
        index += 1
    }
    write!(mut out, "    decoder.end_sequence(sequence)?\n")
    write!(mut out, "    Result::Ok([")
    index = 0
    while index < length {
        if index > 0 {
            write!(mut out, ", ")
        }
        write!(mut out, "item_", index)
        index += 1
    }
    write!(mut out, "])\n}\n")
}

/// Whether any variant of the enum `model` carries a payload.
fn has_payload(_ output: ref Output, _ model: Model) -> bool {
    var index: usize = 0
    while index < model.members.len {
        match output.variants[model.members.start + index].payload {
            Payload::Unit => {},
            _ => return true,
        }
        index += 1
    }
    false
}

/// An enum of unit variants is `write_variant` and `read_variant`; any other enum writes its
/// payload variants as wrappers.
fn render_enum(
    _ out: mut MemBuffer,
    _ program: ref Program,
    _ output: ref Output,
    _ model: Model,
    _ helpers: mut usize,
) {
    if has_payload(output, model) {
        render_payload_enum(mut out, program, output, model, mut helpers)
    } else {
        render_unit_enum(mut out, program, output, model)
    }
}

/// The text of the type of the elements of a tuple variant, from the declaring file.
fn element_type(_ file: ref File, _ variant: Variant, _ index: usize) -> MemBuffer {
    file.type_text(file.elems[variant.elems.start + index])
}

fn render_payload_enum(
    _ out: mut MemBuffer,
    _ program: ref Program,
    _ output: ref Output,
    _ model: Model,
    _ helpers: mut usize,
) {
    let file = ref program.files[model.source]
    let ty = file.token_text(model.name)
    let first = model.members.start
    let count = model.members.len

    // Schema: the fields of each record variant are listed by a type of their own.
    var index: usize = 0
    while index < count {
        let variant = output.variants[first + index]
        index += 1
        match variant.payload {
            Payload::Record => {
                let marker = marker_name(ty, file.token_text(variant.name))
                write!(mut out, "\nstruct ", marker, " {}\n")
                write!(mut out, "\nimpl fe_codec_core::Schema for ", marker, " {\n")
                render_name(mut out, file.token_text(variant.name))
                render_field_info(mut out, file, output, variant.fields.start, variant.fields.len)
                if model.skip_unknown {
                    write!(mut out, "    fn skips_unknown_fields() -> bool {\n        true\n    }\n")
                }
                write!(mut out, "}\n")
            },
            _ => {},
        }
    }
    write!(mut out, "\nimpl fe_codec_core::Schema for ", ty, " {\n")
    render_name(mut out, ty)
    write!(mut out, "    fn variant(_ index: usize) -> Option<fe_codec_core::VariantInfo> {\n")
    write!(mut out, "        match index {\n")
    index = 0
    while index < count {
        let variant = output.variants[first + index]
        write!(mut out, "            ", index, " => Option::Some(fe_codec_core::VariantInfo { name: ")
        name_literal(mut out, file.token_text(variant.name))
        write!(mut out, ", id: ", variant.id, " }),\n")
        index += 1
    }
    write!(mut out, "            _ => Option::None,\n        }\n    }\n}\n")

    // Serialize: a variant without a payload as before, any other inside a wrapper.
    write!(mut out, "\nimpl fe_codec_core::Serialize for ", ty, " {\n")
    write!(
        mut out,
        "    fn serialize<CodecEncoder: fe_codec_core::Encoder>(self, _ encoder: mut CodecEncoder) -> fe_codec_core::CodecResult<()> {\n",
    )
    write!(mut out, "        match self {\n")
    index = 0
    while index < count {
        let variant = output.variants[first + index]
        let name = file.token_text(variant.name)
        write!(mut out, "            ", ty, "::", name)
        match variant.payload {
            Payload::Unit => {
                write!(mut out, " => encoder.write_variant<Self>(", index, "),\n")
            },
            Payload::Tuple => {
                write!(mut out, "(")
                var element: usize = 0
                while element < variant.elems.len {
                    if element > 0 {
                        write!(mut out, ", ")
                    }
                    write!(mut out, "ref element_", element)
                    element += 1
                }
                write!(mut out, ") => {\n")
                write!(mut out, "                let variant = encoder.begin_variant<Self>(", index, ")?\n")
                if variant.elems.len == 1 {
                    write!(mut out, "                element_0.serialize(mut encoder)?\n")
                } else {
                    write!(mut out, "                var sequence = encoder.begin_sequence(", variant.elems.len, ")?\n")
                    element = 0
                    while element < variant.elems.len {
                        write!(mut out, "                encoder.element(mut sequence)?\n")
                        write!(mut out, "                element_", element, ".serialize(mut encoder)?\n")
                        element += 1
                    }
                    write!(mut out, "                encoder.end_sequence(sequence)?\n")
                }
                write!(mut out, "                encoder.end_variant(variant)\n            },\n")
            },
            Payload::Record => {
                let marker = marker_name(ty, name)
                write!(mut out, " {")
                var position: usize = 0
                while position < variant.fields.len {
                    let field = output.fields[variant.fields.start + position]
                    if position > 0 {
                        write!(mut out, ",")
                    }
                    write!(mut out, " ", file.token_text(field.name), ": ref field_", position)
                    position += 1
                }
                write!(mut out, " } => {\n")
                render_write_fields(
                    mut out,
                    file,
                    output,
                    variant.fields.start,
                    variant.fields.len,
                    marker,
                    16,
                    Option::Some(index),
                )
                write!(mut out, "                encoder.end_record(record)?\n")
                write!(mut out, "                encoder.end_variant(variant)\n            },\n")
            },
        }
        index += 1
    }
    write!(mut out, "        }\n    }\n}\n")

    // Deserialize: either form of the variant, then its payload.
    var unrolled = MemVec<usize>::new()
    write!(mut out, "\nimpl fe_codec_core::Deserialize for ", ty, " {\n")
    write!(
        mut out,
        "    fn deserialize<CodecDecoder: fe_codec_core::Decoder>(_ decoder: mut CodecDecoder) -> fe_codec_core::CodecResult<Self> {\n",
    )
    write!(mut out, "        let variant = decoder.begin_variant<Self>()?\n")
    write!(mut out, "        match variant.index {\n")
    index = 0
    while index < count {
        let variant = output.variants[first + index]
        let name = file.token_text(variant.name)
        write!(mut out, "            ", index, " => {\n")
        match variant.payload {
            Payload::Unit => {
                write!(mut out, "                variant.expect_unit()?\n")
                write!(mut out, "                Result::Ok(", ty, "::", name, ")\n            },\n")
            },
            Payload::Tuple => {
                write!(mut out, "                variant.expect_payload()?\n")
                var element: usize = 0
                if variant.elems.len == 1 {
                    write!(
                        mut out,
                        "                let element_0 = <",
                        element_type(file, variant, 0),
                        " as fe_codec_core::Deserialize>::deserialize(mut decoder)?\n",
                    )
                } else {
                    write!(mut out, "                var sequence = decoder.begin_sequence(", variant.elems.len, ")?\n")
                    while element < variant.elems.len {
                        write!(mut out, "                decoder.element(mut sequence)?\n")
                        write!(
                            mut out,
                            "                let element_",
                            element,
                            " = <",
                            element_type(file, variant, element),
                            " as fe_codec_core::Deserialize>::deserialize(mut decoder)?\n",
                        )
                        element += 1
                    }
                    write!(mut out, "                decoder.end_sequence(sequence)?\n")
                }
                write!(mut out, "                decoder.end_variant(variant)?\n")
                write!(mut out, "                Result::Ok(", ty, "::", name, "(")
                element = 0
                while element < variant.elems.len {
                    if element > 0 {
                        write!(mut out, ", ")
                    }
                    write!(mut out, "element_", element)
                    element += 1
                }
                write!(mut out, "))\n            },\n")
            },
            Payload::Record => {
                let marker = marker_name(ty, name)
                write!(mut out, "                variant.expect_payload()?\n")
                render_read_fields(
                    mut out,
                    file,
                    output,
                    model,
                    variant.fields.start,
                    variant.fields.len,
                    marker,
                    16,
                    mut helpers,
                    mut unrolled,
                )
                write!(mut out, "                let value = ", ty, "::", name, " {\n")
                var position: usize = 0
                while position < variant.fields.len {
                    let field = output.fields[variant.fields.start + position]
                    write!(mut out, "                    ", file.token_text(field.name), ": ")
                    render_field_value(mut out, field, position, marker)
                    write!(mut out, ",\n")
                    position += 1
                }
                write!(mut out, "                }\n")
                write!(mut out, "                decoder.end_variant(variant)?\n")
                write!(mut out, "                Result::Ok(value)\n            },\n")
            },
        }
        index += 1
    }
    write!(mut out, "            _ => Result::Err(variant.unknown()),\n")
    write!(mut out, "        }\n    }\n}\n")

    var u: usize = 0
    while u < unrolled.len() {
        let field = output.fields[unrolled[u]]
        render_unrolled(mut out, file, output, model, unrolled[u + 1], field.unrolled_element, field.unrolled_length)
        u += 2
    }

    // Describe: a union of the variants' payloads.
    write!(mut out, "\nimpl fe_codec_core::Describe for ", ty, " {\n")
    render_describe_header(mut out)
    write!(mut out, "        describer.begin_union<Self>()?\n")
    index = 0
    while index < count {
        let variant = output.variants[first + index]
        write!(mut out, "        describer.union_variant<Self>(", index, ")?\n")
        match variant.payload {
            Payload::Unit => {},
            Payload::Tuple => {
                if variant.elems.len > 1 {
                    write!(mut out, "        describer.begin_tuple(", variant.elems.len, ")?\n")
                }
                var element: usize = 0
                while element < variant.elems.len {
                    write!(
                        mut out,
                        "        <",
                        element_type(file, variant, element),
                        " as fe_codec_core::Describe>::describe(mut describer)?\n",
                    )
                    element += 1
                }
                if variant.elems.len > 1 {
                    write!(mut out, "        describer.end_tuple(", variant.elems.len, ")?\n")
                }
            },
            Payload::Record => {
                let marker = marker_name(ty, file.token_text(variant.name))
                render_describe_fields(mut out, file, output, variant.fields.start, variant.fields.len, marker, 8)
                write!(mut out, "        describer.end_record<", marker, ">()?\n")
            },
        }
        index += 1
    }
    write!(mut out, "        describer.end_union<Self>()\n    }\n}\n")
}

fn render_unit_enum(_ out: mut MemBuffer, _ program: ref Program, _ output: ref Output, _ model: Model) {
    let file = ref program.files[model.source]
    let ty = file.token_text(model.name)
    let first = model.members.start
    let count = model.members.len
    write!(mut out, "\nimpl fe_codec_core::Schema for ", ty, " {\n")
    render_name(mut out, ty)
    write!(mut out, "    fn variant(_ index: usize) -> Option<fe_codec_core::VariantInfo> {\n")
    write!(mut out, "        match index {\n")
    var index: usize = 0
    while index < count {
        let variant = output.variants[first + index]
        write!(mut out, "            ", index, " => Option::Some(fe_codec_core::VariantInfo { name: ")
        name_literal(mut out, file.token_text(variant.name))
        write!(mut out, ", id: ", variant.id, " }),\n")
        index += 1
    }
    write!(mut out, "            _ => Option::None,\n        }\n    }\n}\n")

    write!(mut out, "\nimpl fe_codec_core::Serialize for ", ty, " {\n")
    write!(
        mut out,
        "    fn serialize<CodecEncoder: fe_codec_core::Encoder>(self, _ encoder: mut CodecEncoder) -> fe_codec_core::CodecResult<()> {\n",
    )
    write!(mut out, "        let index: usize = match self {\n")
    index = 0
    while index < count {
        write!(mut out, "            ", ty, "::", file.token_text(output.variants[first + index].name), " => ", index, ",\n")
        index += 1
    }
    write!(mut out, "        }\n        encoder.write_variant<Self>(index)\n    }\n}\n")

    write!(mut out, "\nimpl fe_codec_core::Deserialize for ", ty, " {\n")
    write!(
        mut out,
        "    fn deserialize<CodecDecoder: fe_codec_core::Decoder>(_ decoder: mut CodecDecoder) -> fe_codec_core::CodecResult<Self> {\n",
    )
    write!(mut out, "        let start = decoder.offset()\n")
    write!(mut out, "        match decoder.read_variant<Self>()? {\n")
    index = 0
    while index < count {
        write!(
            mut out,
            "            ",
            index,
            " => Result::Ok(",
            ty,
            "::",
            file.token_text(output.variants[first + index].name),
            "),\n",
        )
        index += 1
    }
    write!(
        mut out,
        "            _ => Result::Err(fe_codec_core::CodecError::at(kind: fe_codec_core::ErrorKind::UnknownVariant, offset: start)),\n",
    )
    write!(mut out, "        }\n    }\n}\n")

    write!(mut out, "\nimpl fe_codec_core::Describe for ", ty, " {\n")
    render_describe_header(mut out)
    write!(mut out, "        describer.enumeration<Self>()\n    }\n}\n")
}
