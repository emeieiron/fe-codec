use fe_codec_core::Text
use std::evm::Address

#[serializable]
pub struct Person { pub name: Text<16>, pub wallet: Address }
#[serializable]
#[eip712]
pub struct Mail { pub from: Person, pub to: Person, pub contents: Text<32>, pub level: Level, pub tags: [u8; 2] }
#[serializable]
pub enum Level { Low, High }
#[serializable]
pub struct Unsigned { pub note: Option<u8> }
