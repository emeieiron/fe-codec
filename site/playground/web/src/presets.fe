//! The models whose values the playground encodes. Their serializers and EIP-712 hashing are
//! generated by fe_codec_gen when the module is built.

use fe_codec_core::Text
use std::evm::Address

#[serializable]
pub struct Order {
    pub id: u64,
    pub buyer: Address,
    pub total: u256,
    pub status: OrderStatus,
    pub note: Option<Text<32>>,
}

#[serializable]
pub enum OrderStatus {
    Open,
    Paid,
}

#[serializable]
pub struct Person { pub name: Text<16>, pub wallet: Address }

/// Signed as EIP-712 typed data.
#[serializable]
#[eip712]
pub struct Mail { pub from: Person, pub to: Person, pub contents: Text<32> }
