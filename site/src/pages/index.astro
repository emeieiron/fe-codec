---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import Inspector from '../components/Inspector.astro';
import CopyCommand from '../components/CopyCommand.astro';
import fe from '../lib/fe.tmLanguage.json';
import { repo, url } from '../lib/site';
import { expectIn, siteValues } from '../lib/values';

const describe = `#[serializable]
pub struct Order {
    pub id: u64,
    pub buyer: Address,
    pub total: u256,
    pub status: OrderStatus,
    pub note: Option<Text<32>>,
}`;

const generated = `// Generated by fe_codec_gen. Do not edit.
impl fe_codec_core::Serialize for Order {
    fn serialize<CodecEncoder: fe_codec_core::Encoder>(self, _ encoder: mut CodecEncoder) -> fe_codec_core::CodecResult<()> {
        var present: usize = 4
        if !CodecEncoder::OMIT_NONE || self.note.is_some() {
            present += 1
        }
        var record = encoder.begin_record<Self>(present)?
        encoder.field<Self>(mut record, 0)?
        self.id.serialize(mut encoder)?
        // … one visit per field, in ID order
        encoder.end_record(record)
    }
}`;

const values = await siteValues();
const hashes = values.mail;
const jsonBytes = new TextEncoder().encode(values.order.json).length;
const cborBytes = values.order.cbor.length;

// Every line of the excerpt must be what fe_codec_gen writes for the model above.
const module = values.generate(
  `use fe_codec_core::Text\nuse std::evm::Address\n\n${describe}\n\n#[serializable]\npub enum OrderStatus {\n    Open,\n    Paid,\n}\n`,
);
for (const line of generated.split('\n')) {
  if (!line.trim().startsWith('// …')) expectIn('The landing page', module, line, 'this generated line');
}

const use = `fn round_trip(_ order: Order) -> CodecResult<Order> {
    let bytes: BoundedBuffer<192> = fe_codec_json::encode(order)?
    let back: Order = fe_codec_json::decode(bytes)?
    Result::Ok(back)
}`;

const evolve = `#[serializable]
pub struct Account {
    #[codec_id = 1]
    pub owner: u64,
    #[codec_id = 2]
    pub balance: u64,
    #[codec_id = 3]
    pub label: Option<Text<8>>,   // added later
}`;

const mail = `#[serializable]
pub struct Person { pub name: Text<16>, pub wallet: Address }

#[serializable]
#[eip712]
pub struct Mail { pub from: Person, pub to: Person, pub contents: Text<32> }`;

const sign = `let digest = domain.digest(mail.hash_struct())
let signer = std::evm::crypto::ecrecover(hash: digest, v, r, s)`;

const gas = [
  { label: 'Generated', value: 13900 },
  { label: 'Hand-written', value: 14600 },
  { label: 'Generic', value: 70900 },
];
const gasMax = Math.max(...gas.map((g) => g.value));
---

<Base
  title="Fe Codec · Type-safe serialization for Fe"
  description="Encode Fe types as JSON, deterministic CBOR or your own format, and hash them as EIP-712 typed data, in contracts, native programs and WebAssembly."
  current="home"
>
  <section class="hero">
    <div class="grid-paper" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow rise" style="--i: 0">Serialization for Fe</p>
        <h1 class="rise" style="--i: 1">One struct.<br /><span>Every wire.</span></h1>
        <p class="lede rise" style="--i: 2">
          Fe Codec encodes your types as JSON, deterministic CBOR or a format you write, and hashes
          them as EIP-712 typed data. A generator written in Fe writes the serializers, and the same
          code runs in contracts, native programs and WebAssembly.
        </p>
        <div class="actions rise" style="--i: 3">
          <a class="button button-primary" href={url('docs/getting-started/')}>
            Get started
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="button" href={url('playground/')}>Try it in your browser</a>
        </div>
      </div>
      <div class="hero-install rise" style="--i: 4">
        <p class="install-label">Install the generator (linux-x86_64 · linux-arm64 · macos-arm64 · macos-x86_64)</p>
        <CopyCommand command="curl -fsSL https://github.com/emeieiron/fe-codec/releases/latest/download/fe_codec_gen-<target>.tar.gz | tar -xz -C ~/.local/bin" label="Copy the install command" />
        <dl class="specs">
          <div><dt>Formats</dt><dd>JSON · CBOR · EIP-712 · yours</dd></div>
          <div><dt>Targets</dt><dd>EVM · native · WebAssembly</dd></div>
          <div><dt>Toolchain</dt><dd>Fe 26.7.0</dd></div>
        </dl>
      </div>
    </div>
    <div class="container inspector-wrap rise" style="--i: 5">
      <Inspector />
    </div>
  </section>

  <section class="section" aria-labelledby="can-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">§01 · What you can do</p>
        <h2 id="can-title">Describe a type once.<br />Use it everywhere it travels.</h2>
      </header>

      <div class="bento">
        <article class="card wide">
          <h3>Encode once, in every format</h3>
          <p>
            The serializer never names a format. Switch ingots, or write code generic over
            <code>Format</code>, and the same value comes out as text or bytes.
          </p>
          <ul class="formats">
            <li><code>fe_codec_json::encode(order)</code><span>{jsonBytes} bytes</span></li>
            <li><code>fe_codec_cbor::encode(order)</code><span>{cborBytes} bytes</span></li>
            <li><code>format.encode&lt;Order, 192&gt;(order)</code><span>any Format</span></li>
          </ul>
        </article>

        <article class="card tall">
          <h3>Sign typed data</h3>
          <p>
            Mark a struct <code>#[eip712]</code> and its type hash becomes a compile-time
            constant. Gas for the EIP's example mail, digest included:
          </p>
          <ul class="bars">
            {
              gas.map((g) => (
                <li>
                  <span class="bar-label">{g.label}</span>
                  <span class="bar-track">
                    <span class="bar-fill" style={`--w: ${(g.value / gasMax) * 100}%`} />
                  </span>
                  <span class="bar-value">{g.value.toLocaleString('en-US')}</span>
                </li>
              ))
            }
          </ul>
        </article>

        <article class="card">
          <h3>Same types, three targets</h3>
          <p>Contracts, native programs and WebAssembly share the models and the serializers.</p>
          <p class="chips"><span class="kbd-chip">EVM</span><span class="kbd-chip">native</span><span class="kbd-chip">wasm</span></p>
          <p class="fine">Property tests require the targets to agree on every encoded byte and every decode outcome.</p>
        </article>

        <article class="card">
          <h3>Bring your own format</h3>
          <p>
            Implement <code>Encoder</code>, <code>Decoder</code> and <code>Format</code> against
            <code>fe_codec_core</code> alone. Every serializable type works with it at once.
          </p>
          <a class="more" href={url('docs/writing-a-format/')}>Writing a format →</a>
        </article>

        <article class="card">
          <h3>Errors that point at the byte</h3>
          <p>Every error carries its kind, the offset and the field it was decoding.</p>
          <p class="error-line"><span>UnknownVariant</span><span>offset 17</span><span>field "status"</span></p>
        </article>

        <article class="card wide code-card">
          <div>
            <h3>Change the schema without breaking data</h3>
            <p>
              Stable <code>#[codec_id]</code>s give fields their wire identity. Add new fields as
              <code>Option</code>s, and old data still decodes.
            </p>
            <a class="more" href={url('docs/types/#schema-evolution')}>Schema evolution →</a>
          </div>
          <Code code={evolve} lang={fe} theme="css-variables" />
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">§02 · How it works</p>
        <h2 id="how-title">Plain Fe in, plain Fe out.</h2>
        <p class="section-lede">
          The generator reads your declarations and writes ordinary Fe that implements the codec
          traits. There is no runtime reflection and no plugin to load: the compiler checks the
          result like any other module.
        </p>
      </header>

      <ol class="steps">
        <li class="step">
          <p class="step-num" aria-hidden="true">01</p>
          <div class="step-text">
            <h3>Describe</h3>
            <p>Mark structs and enums <code>#[serializable]</code>. They stay ordinary Fe types.</p>
          </div>
          <div class="step-code">
            <Code code={describe} lang={fe} theme="css-variables" />
          </div>
        </li>
        <li class="step">
          <p class="step-num" aria-hidden="true">02</p>
          <div class="step-text">
            <h3>Generate</h3>
            <p>Write the impls beside your models, or let FeMP run the generator on each build.</p>
          </div>
          <div class="step-code">
            <CopyCommand command="fe_codec_gen --source src/models.fe --out src/serializers.fe" label="Copy the generate command" />
            <Code code={generated} lang={fe} theme="css-variables" />
          </div>
        </li>
        <li class="step">
          <p class="step-num" aria-hidden="true">03</p>
          <div class="step-text">
            <h3>Use</h3>
            <p>Encode and decode with any format. Bindings choose the type and the buffer.</p>
          </div>
          <div class="step-code">
            <Code code={use} lang={fe} theme="css-variables" />
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section eip" aria-labelledby="eip-title">
    <div class="container eip-inner">
      <div>
        <p class="eyebrow">§03 · EIP-712</p>
        <h2 id="eip-title">Typed data, hashed at compile time.</h2>
        <p class="section-lede">
          The generator computes each struct's <code>encodeType</code> and emits its type hash as a
          <code>core::keccak</code> constant. Hashing a struct is then one <code>keccak_words</code>
          over its members, as hand-written code would be.
        </p>
        <Code code={mail} lang={fe} theme="css-variables" />
        <Code code={sign} lang={fe} theme="css-variables" />
        <a class="more" href={url('docs/eip712/')}>Signing typed data →</a>
      </div>
      <dl class="hashes" aria-label="The EIP's example mail">
        <div>
          <dt>encodeType</dt>
          <dd>{hashes.encodeType}</dd>
        </div>
        <div>
          <dt>typeHash</dt>
          <dd>{hashes.typeHash}</dd>
        </div>
        <div>
          <dt>hashStruct</dt>
          <dd>{hashes.hashStruct}</dd>
        </div>
        <div>
          <dt>digest</dt>
          <dd>{hashes.digest}</dd>
        </div>
        <p class="fine">
          Computed by <code>fe_codec_eip712</code> when this page was built: the EIP's own example
          values, through the generated and the generic path. The tests also check them against an
          independent transcription of the specification and viem.
        </p>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="proof-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">§04 · Evidence</p>
        <h2 id="proof-title">Proved, property-tested, example-tested.</h2>
        <p class="section-lede">Three kinds of evidence, kept apart because they are not interchangeable.</p>
      </header>
      <div class="evidence">
        <article>
          <p class="tier">Proved</p>
          <p class="how"><code>femp prove</code>, for every input, on the EVM, natively and in WebAssembly</p>
          <ul>
            <li>UTF-8 validation of a character follows RFC 3629 §4 exactly</li>
            <li>The CBOR encoder's head for any 64-bit argument is the only head the decoder accepts</li>
            <li>The 8–64-bit range checks accept exactly the values of their width</li>
          </ul>
        </article>
        <article>
          <p class="tier">Property-tested</p>
          <p class="how"><code>femp prop</code>, with generated inputs on all three targets</p>
          <ul>
            <li>Every integer width round-trips in JSON, CBOR and the compact format</li>
            <li>No input of up to 64 arbitrary bytes makes a decoder panic</li>
            <li>The targets agree on every decode outcome and every encoded byte</li>
          </ul>
        </article>
        <article>
          <p class="tier">Example-tested</p>
          <p class="how">Golden vectors, conformance and the generator's own suites</p>
          <ul>
            <li>Vectors from an independent reference encoder, and RFC 8949 Appendix A</li>
            <li>A conformance check every format runs, with exact error kinds and offsets</li>
            <li>Random models checked against the reference encoders and the EIP-712 specification</li>
          </ul>
        </article>
      </div>
      <p class="not-yet">
        What is not established, such as proofs for whole encoders, is listed in{' '}
        <a href={url('docs/design/#guarantees')}>the design's guarantees</a>.
      </p>
    </div>
  </section>

  <section class="section closing">
    <div class="container closing-inner">
      <h2>Start with one struct.</h2>
      <div class="actions">
        <a class="button button-primary" href={url('docs/getting-started/')}>Get started</a>
        <a class="button" href={repo}>View the source</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    padding: clamp(48px, 8vw, 96px) 0 24px;
    overflow: hidden;
  }

  .grid-paper {
    position: absolute;
    inset: 0 0 30% 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 80% 75% at 30% 20%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 75% at 30% 20%, #000 30%, transparent 75%);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: end;
  }

  h1 {
    margin-top: 22px;
    font-size: clamp(3.1rem, 8.4vw, 6.6rem);
    font-weight: 800;
    font-stretch: 78%;
    line-height: 0.92;
    letter-spacing: -0.035em;
  }

  h1 span {
    color: var(--accent);
  }

  .lede {
    margin-top: 26px;
    max-width: 56ch;
    font-size: clamp(1.02rem, 1.4vw, 1.14rem);
    color: var(--fg-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero-install {
    display: grid;
    gap: 12px;
    padding-bottom: 8px;
  }

  .install-label {
    font: 500 0.74rem/1.4 var(--font-mono);
    color: var(--fg-faint);
    letter-spacing: 0.04em;
  }

  .specs {
    display: grid;
    margin: 8px 0 0;
    border-top: 1px solid var(--line);
  }

  .specs div {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.86rem;
  }

  .specs dt {
    font: 500 0.68rem/1.9 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .specs dd {
    margin: 0;
    color: var(--fg);
  }

  .inspector-wrap {
    margin-top: clamp(40px, 6vw, 72px);
  }

  /* ---- Sections ---- */
  .section {
    padding-top: clamp(80px, 11vw, 140px);
  }

  .section-head {
    max-width: 760px;
    margin-bottom: 44px;
  }

  .section-head h2,
  .eip h2,
  .closing h2 {
    margin-top: 16px;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    font-stretch: 82%;
  }

  .section-lede {
    margin-top: 18px;
    max-width: 62ch;
    color: var(--fg-muted);
    font-size: 1.04rem;
  }

  code {
    font-size: 0.88em;
  }

  p code,
  li code,
  dd code {
    padding: 0.06em 0.22em;
    border-radius: 3px;
    background: var(--bg-elevated);
    color: var(--fg);
    white-space: nowrap;
  }

  /* ---- Bento ---- */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }

  .card {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
    color: var(--fg-muted);
    transition:
      border-color 200ms ease,
      transform 200ms ease;
  }

  .card:hover {
    border-color: var(--line-strong);
  }

  .card.wide {
    grid-column: span 4;
  }

  .card.tall {
    grid-row: span 2;
  }

  .card h3 {
    font-size: 1.34rem;
    color: var(--fg);
  }

  .formats {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .formats li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    font-size: 0.84rem;
  }

  .formats li code {
    background: none;
    padding: 0;
    overflow-x: auto;
    white-space: nowrap;
  }

  .formats li span {
    flex: none;
    font: 500 0.72rem/1 var(--font-mono);
    color: var(--byte);
  }

  .bars {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .bars li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px 12px;
  }

  .bar-label {
    font-size: 0.86rem;
    color: var(--fg);
  }

  .bar-value {
    font: 500 0.8rem/1.6 var(--font-mono);
    color: var(--fg-muted);
  }

  .bar-track {
    grid-column: 1 / -1;
    height: 10px;
    border-radius: 2px;
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .bar-fill {
    display: block;
    height: 100%;
    width: var(--w);
    background: var(--accent);
    transform-origin: left;
    animation: grow 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-timeline: view();
    animation-range: entry 10% cover 40%;
  }

  .bars li:not(:first-child) .bar-fill {
    background: var(--fg-faint);
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }

  .chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .fine {
    font-size: 0.82rem;
    color: var(--fg-faint);
  }

  .more {
    margin-top: auto;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .error-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    font: 500 0.76rem/1 var(--font-mono);
  }

  .error-line span {
    padding: 10px 12px;
    border-right: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg-muted);
  }

  .error-line span:first-child {
    color: var(--accent);
  }

  .error-line span:last-child {
    border-right: 0;
  }

  .code-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 26px;
    align-items: center;
  }

  .code-card > div {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
  }

  /* ---- Steps ---- */
  /* Steps run down a rail: number, then the text, then the code with room to breathe. */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 0.85fr) minmax(0, 2fr);
    gap: 0 clamp(20px, 3vw, 44px);
    padding-bottom: 48px;
    color: var(--fg-muted);
  }

  .step:last-child {
    padding-bottom: 0;
  }

  /* The rail joining one step's number to the next. */
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 27px;
    top: 56px;
    bottom: 0;
    width: 1px;
    background: linear-gradient(var(--accent), var(--line) 60%);
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1.5px solid var(--accent);
    border-radius: 6px;
    background: var(--accent-soft);
    font: 600 0.95rem/1 var(--font-mono);
    color: var(--accent);
    letter-spacing: 0.04em;
  }

  .step-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 8px;
  }

  .step h3 {
    font-size: 1.7rem;
    color: var(--fg);
  }

  .step-code {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .step-code :global(pre.astro-code) {
    font-size: 0.8rem;
  }

  /* ---- EIP-712 ---- */
  .eip-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .eip-inner > div {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .eip-inner > div :global(pre.astro-code) {
    font-size: 0.8rem;
  }

  .hashes {
    margin: 0;
    padding: 8px 26px 26px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background:
      repeating-linear-gradient(
        -45deg,
        transparent 0 10px,
        color-mix(in srgb, var(--accent) 4%, transparent) 10px 11px
      ),
      var(--bg-raised);
  }

  .hashes div {
    padding: 18px 0;
    border-bottom: 1px dashed var(--line-strong);
  }

  .hashes dt {
    font: 600 0.7rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hashes dd {
    margin: 10px 0 0;
    font: 400 0.84rem/1.6 var(--font-mono);
    color: var(--fg);
    word-break: break-all;
  }

  .hashes .fine {
    margin-top: 18px;
  }

  /* ---- Evidence ---- */
